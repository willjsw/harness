# 이 파일은 harness.toml 에서 생성된다. 직접 고치지 않는다 —
# 값은 harness.toml 이 갖고, `harness render` 가 이 파일을 다시 만든다.
# 셸이 읽는 설정값. `. script/harness.env` 로 소스한다.
ADR_DIR=docs/adr
ADR_PROCEDURE='도구를 쓰지 않는다. 손으로 한다.

| 하는 일 | 어떻게 |
|---|---|
| 새 결정 만들기 | `docs/adr/templates/template.md` 를 `NNNN-title-with-dashes.md` 로 복사한다. 번호는 남은 파일의 최대 번호 + 1 |
| 기존 결정 대체하기 | 새 문서를 만들고, 기존 문서의 `## Status` 절 만 대체 표기로 바꾼다 |
| 목록 | `ls docs/adr` |

- **제목·파일명은 영어로 쓴다.** 본문은 프로젝트 문서 언어로.
- **대체할 때 고치는 것은 상태 한 줄뿐이다.** 본문도 날짜도 건드리지 않는다 —
  기록은 로그이고 틀린 결정도 그대로 남아야 한다.'
ADR_STYLE=nygard
ADR_TOOL=manual
AGENT_COUNT=7
AGENT_TABLE='| `.claude/agents/code-reviewer.md` | 변경분 리뷰 → 결과 출력. **`/work` 루프의 리뷰 수단이 아니다** — 루프는 `script/review-mr.sh` 하나만 쓴다 |
| `.claude/agents/developer.md` | 이슈 하나의 작업 전부 구현 + 테스트 + 리뷰 요청 1건 |
| `.claude/agents/docs-writer.md` | 머지된 변경 근거로 현재형 문서 정리 |
| `.claude/agents/planner.md` | 명세 → task 분해(`docs/plan/<번호>/`) |
| `.claude/agents/requirement-analyzer.md` | 이슈 하나 → 결정이 필요한 쟁점만 보고. **파일을 만들지 않는다** |
| `.claude/agents/security-guard.md` | 변경분을 보안 관점으로만 읽고 발견을 등급과 함께 출력. **`/work` 루프에 끼지 않는다** — 명시 호출 전용 |
| `.claude/agents/spec-writer.md` | 이슈 하나 → `docs/spec/` 명세 작성·갱신 |'
BASE_BRANCH=main
BRANCH_PATTERN='<tag>/<issue-number>-<english-summary>'
COMMAND_COUNT=3
COMMAND_TABLE='| `.claude/commands/prework.md` | `/prework <이슈번호>` — 요구사항 검토 → 결정 게이트 → 명세 → task 분해 → spec+plan 리뷰 요청 |
| `.claude/commands/security-guard.md` | `/security-guard [대상]` — 변경분을 보안 관점으로만 검토. 읽기 전용, 루프에 끼지 않는다 |
| `.claude/commands/work.md` | `/work <이슈번호>` — 착수 판정 → 구현 → 리뷰 요청 → 리뷰 루프 |'
COMMIT_DOCS_FORM='docs: <요약>(#<이슈번호>)'
COMMIT_SUBJECT_EXAMPLE='feat: short summary(#123)'
COMMIT_SUBJECT_FORM='<tag>: {summary}(#{issue})'
COMMIT_SUBJECT_RE='^(feat|fix|docs|chore|refactor): .+\(#[0-9]+\)$'
COMMIT_TAGS='feat|fix|docs|chore|refactor'
COMMIT_TAGS_HUMAN='feat | fix | docs | chore | refactor'
COMMIT_TICKET_KEY=PROJ
FORGE_CLIS=gh
FORGE_REVIEW_CLI=gh
FORGE_REVIEW_HOST=github
FORGE_TRACKER=github
FORGE_TRACKER_CLI=gh
HARNESS_VERSION=0.1.0
ISSUE_CLOSED_STATUS=Done
ISSUE_DELETE_FORBIDDEN=1
ISSUE_DELETE_RULE='이 프로젝트는 이슈 삭제를 **금지**한다. 잘못 만든 이슈는 `invalid` 로
    닫힌 채 영구히 남는다 — 되돌릴 수 없으므로 만들기 전에 확인한다'
ISSUE_LABEL_INVALID=invalid
ISSUE_LABEL_REQUIREMENT=Requirement
ISSUE_LABEL_TASK=Task
ISSUE_REF_DISPLAY='#{id}'
ISSUE_REQUIRED_FIELDS=assignee
ISSUE_TYPE=Task
MR_DEFAULT_ASSIGNEE=self
MR_DEFAULT_REVIEWER=self
PROJECT_NAME=harness
PROTECTED_BRANCHES=main
PROTECTED_BRANCH_CASE=main
PROTECTED_DOCS_LIST='`.ai/project/scope.md`, `.ai/project/architecture.md`, `.ai/project/glossary.md`, `.ai/project/testing.md`, `.ai/project/roles/`, `.ai/project/workflows/`'
PROTECTED_DOCS_RE='\.ai/project/scope\.md|\.ai/project/architecture\.md|\.ai/project/glossary\.md|\.ai/project/testing\.md|\.ai/project/roles/|\.ai/project/workflows/'
PROTECTED_DOCS_SAMPLE=.ai/project/scope.md
PROTECTED_REF_CASE=refs/heads/main
REVIEWER_LABEL=Codex
REVIEW_MAX_ROUNDS=5
REVIEW_REPEAT_FILE_MAX=3
REVIEW_ROUND_LABEL=mrl
USAGE_ENV_VAR=HARNESS_USAGE_LOG
USAGE_LOG_PATH="$HOME/.harness/harness/usage.log"
