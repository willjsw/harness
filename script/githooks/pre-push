#!/usr/bin/env sh
# 보호 브랜치 직접 push 차단. verify.pre_push 가 켜져 있으면 push 전에 검증 일괄을 돈다.
#
# 이 파일은 harness.toml 에서 생성된다. 직접 고치지 않는다 —
# 브랜치 목록은 harness.toml 의 [branches] 가 갖고, `harness render` 가 이 파일을 다시 만든다.
#
# 보호 브랜치로의 force push 도 이 검사에 포함된다. 다른 브랜치의 force push 까지 막으면
# rebase 워크플로가 막혀 --no-verify 가 습관이 된다.
#
# 활성화: harness install 이 core.hooksPath 가 비어 있으면 켠다. 손으로는 git config core.hooksPath script/githooks
#         (모노레포면 서브프로젝트 경로를 앞에 붙인다 — packages/api/script/githooks)
set -u
# 훅은 하네스 루트가 아니라 리포 루트에서 돌 수 있다. 자기 위치로 먼저 잡고,
# 그게 하네스 루트가 아니면 리포 루트로 물러선다 — 모노레포에서 갈린다.
root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." 2>/dev/null && pwd)
[ -f "$root/script/harness.env" ] || root=$(git rev-parse --show-toplevel 2>/dev/null)

pushed=""
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  pushed="$pushed $_local_sha"
  case "$remote_ref" in
    refs/heads/main|refs/heads/develop) ;;
    *) continue ;;
  esac

  if [ -n "$root" ] && [ -x "$root/script/usage-log.sh" ]; then
    "$root/script/usage-log.sh" block pre-push protected-branch || true
  fi

  echo "blocked: $remote_ref is a protected branch — direct push is not allowed" >&2
  echo "  open a review request from a <tag>/<issue-number>-<english-summary> branch onto develop instead" >&2
  exit 1
done


# push 전 검증 — on = "push" 단계까지 전부. 통과 기록이 있는 단계는 건너뛴다(verify.incremental).
# 검증은 작업 트리를 본다. 그래서 push 하는 리비전이 체크아웃한 HEAD 이고 작업 트리가 그것과 같을 때만 통과시킨다
refuse() {
  [ -n "$root" ] && "$root/script/usage-log.sh" block pre-push verify >/dev/null 2>&1
  echo "blocked: $1" >&2
  echo "  $2" >&2
  exit 1
}
[ -n "$root" ] && [ -x "$root/script/run-lint-test.sh" ] ||
  refuse "verify.pre_push is on but script/run-lint-test.sh is missing" "help: harness render"
head=$(git rev-parse HEAD)
for sha in $pushed; do
  case "$sha" in
    *[!0]*) [ "$sha" = "$head" ] || refuse "this push sends a revision other than the checked-out HEAD, which verification cannot see"               "help: check out that branch, then push" ;;
  esac
done
[ -z "$(git status --porcelain)" ] ||
  refuse "the working tree has uncommitted changes — verification would check them, not what is pushed"     "help: commit or stash them, then push again"
"$root/script/run-lint-test.sh" </dev/null || refuse "verification failed" "help: fix it, commit, then push again"

exit 0
