{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/script/hooks/bash-guard.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(script/check-open-mrs.sh:*)",
      "Bash(script/harness-format.sh:*)",
      "Bash(script/metric.py:*)",
      "Bash(script/post-review.sh:*)",
      "Bash(script/review-mr.sh:*)",
      "Bash(script/run-agent.py:*)",
      "Bash(script/run-lint-test.sh:*)",
      "Bash(script/secret-scan.sh:*)",
      "Bash(script/sync-task-issues.sh:*)",
      "Bash(script/test-bash-guard.sh:*)",
      "Bash(script/test-carryover-issue.sh:*)",
      "Bash(script/test-forge-labels.sh:*)",
      "Bash(script/test-forge-setup.sh:*)",
      "Bash(script/test-review-loop.sh:*)",
      "Bash(script/test-rollback-work.sh:*)",
      "Bash(script/test-secret-scan.sh:*)",
      "Bash(script/test-sync-task-issues.sh:*)",
      "Bash(script/test-usage-log.sh:*)",
      "Bash(script/test-work-preflight.sh:*)",
      "Bash(script/usage-log.sh:*)",
      "Bash(script/usage-report.sh:*)",
      "Bash(script/usage-vocab.sh:*)",
      "Bash(script/work-preflight.sh:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh api repos/{owner}/{repo}/pulls/*/comments/*/replies:*)",
      "Bash(git switch -c:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main)",
      "Bash(git push --set-upstream origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push*HEAD:refs/heads/main*)",
      "Bash(git push*refs/heads/main*)",
      "Bash(git push*:main)",
      "Bash(git push origin develop)",
      "Bash(git push origin develop:*)",
      "Bash(git push -u origin develop)",
      "Bash(git push --set-upstream origin develop)",
      "Bash(git push origin HEAD:develop)",
      "Bash(git push*HEAD:refs/heads/develop*)",
      "Bash(git push*refs/heads/develop*)",
      "Bash(git push*:develop)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git push origin +*)",
      "Bash(git push --no-verify:*)",
      "Bash(git push*--no-verify*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit -n:*)",
      "Edit(.ai/project/scope.md)",
      "Edit(.ai/project/architecture.md)",
      "Edit(.ai/project/glossary.md)",
      "Edit(.ai/project/testing.md)",
      "Edit(.ai/project/roles/**)",
      "Edit(.ai/project/workflows/**)",
      "Bash(harness write-doc scope:*)",
      "Bash(.harness/bin/harness write-doc scope:*)",
      "Bash(src/bin/harness write-doc scope:*)",
      "Bash(harness write-doc architecture:*)",
      "Bash(.harness/bin/harness write-doc architecture:*)",
      "Bash(src/bin/harness write-doc architecture:*)",
      "Bash(harness write-doc glossary:*)",
      "Bash(.harness/bin/harness write-doc glossary:*)",
      "Bash(src/bin/harness write-doc glossary:*)",
      "Bash(harness write-doc testing:*)",
      "Bash(.harness/bin/harness write-doc testing:*)",
      "Bash(src/bin/harness write-doc testing:*)",
      "Bash(harness write-doc roles/:*)",
      "Bash(.harness/bin/harness write-doc roles/:*)",
      "Bash(src/bin/harness write-doc roles/:*)",
      "Bash(harness write-doc workflows/:*)",
      "Bash(.harness/bin/harness write-doc workflows/:*)",
      "Bash(src/bin/harness write-doc workflows/:*)"
    ]
  }
}
