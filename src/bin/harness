#!/usr/bin/env python3
"""harness — generate the AI development harness from one config, and block drift.

Values live in `harness.toml` and project facts in `.ai/project/`. Everything else
is generated from them, so there is exactly one place to change any given value.
Generated files are never edited by hand: `render` overwrites them and `check`
blocks commits that drift.

When a new file becomes generated, add it to plan() — that function is the single
place recording which config key reaches which file.

Requires python3 3.11 or newer (tomllib).
"""
import argparse
import contextlib
import datetime
import fcntl
import hashlib
import io
import json
import os
import re
import select
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:  # 3.11 미만
    sys.exit("python3 3.11 이상이 필요하다 (tomllib 없음). 현재: %s" % sys.version.split()[0])

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent                      # 하네스 리포 루트 또는 대상 리포의 .harness/
TEMPLATES = ROOT / "templates"
# 대상 리포로 복사되는 기본 설정. 리포 루트의 harness.toml 은 언제나 **그 리포 자신의** 설정이다 —
# 하네스 소스 리포도 예외가 아니라서, 기본값을 루트에 두면 소스 리포가 자기 설정을 가질 자리가 없다.
DEFAULT_CONFIG = TEMPLATES / "harness.toml"

BANNER_SH = (
    "# 이 파일은 harness.toml 에서 생성된다. 직접 고치지 않는다 —\n"
    "# 값은 harness.toml 이 갖고, `harness render` 가 이 파일을 다시 만든다.\n"
)


def die(msg):
    print(msg, file=sys.stderr)
    sys.exit(2)


# ─────────────────────────────────────────────────────────────────────────────
# 설정
# ─────────────────────────────────────────────────────────────────────────────

def load(target: Path) -> dict:
    p = target / "harness.toml"
    if not p.is_file():
        die("error: no config found\n  --> %s\n\nhelp: run `harness install` in this repository to create one" % p)
    with p.open("rb") as f:
        try:
            return tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            die("error: could not parse config\n  --> %s\n\n  %s" % (p, e))


# 에이전트가 판단 근거로 읽는 기준 문서. 설정에서 빠져도 늘 보호한다 — 목록에서 지우는 것만으로
# 근거가 고쳐질 수 있으면 보호가 아니다. `.ai/project/` 전체가 아닌 이유: 명령·스택·환경은
# 프로젝트 사실이 바뀌면 docs-writer 가 고친다(`.ai/templates/docs-writer.md`).
BASE_PROTECTED = [".ai/project/scope.md", ".ai/project/architecture.md",
                  ".ai/project/glossary.md", ".ai/project/testing.md", ".ai/project/roles/",
                  ".ai/project/workflows/"]
# 역할별로 이 프로젝트가 더하는 지시(소유 파일). render 가 그 역할의 에이전트 정의 끝에 붙인다 —
# 역할 계약(`.ai/templates/`)은 관리 파일이라 여기서 고치면 다음 갱신이 덮는다.
ROLE_NOTES = ".ai/project/roles"
# 절차에 이 프로젝트가 더하는 지시(소유 파일). render 가 생성된 절차 끝에 붙인다.
WORKFLOW_NOTES = ".ai/project/workflows"
# 리뷰 회차 상한·반복 지적 상한이 가질 수 있는 가장 큰 값. 그 이상은 사람에게 넘길 시점을 놓친다.
REVIEW_LIMIT = 20
# 보호 경로 하나: 리포 기준 상대 경로. 파일, `dir/`, `dir/**`. 절대 경로·`..`·공백은 받지 않는다.
BRANCH_NAME = re.compile(r"(?!/)(?!.*\.\.)[\w.-]+(/[\w.-]+)*")
PROTECTED_PATH = re.compile(r"(?!/)(?!.*(^|/)\.\.(/|$))[\w.-]+(/[\w.-]+)*(/|/\*\*)?")


# 프로젝트 명령. 명령 탭이 쓰는 값이고, 규칙 문서 3장과 검증 스크립트가 여기서 나온다 —
# 같은 명령을 문서와 스크립트에 두 번 적지 않는다.
COMMAND_KEYS = [("build", "빌드"), ("test", "테스트 전체"), ("test_single", "단일 테스트"),
                ("format_check", "코드 검사"), ("format_fix", "코드 자동 수정")]
VERIFY_SCRIPT = "script/harness-verify.sh"
VERIFY_UNSET = 3                                   # 검증 스크립트의 "아직 명령을 정하지 않았다"
# 검증을 언제·무엇을 돌리나. 단계마다 마지막으로 통과한 작업 트리를 기억해, 그 뒤 바뀐 파일이 단계의
# paths 에 걸릴 때만 다시 돈다(incremental). on = "push" 인 단계는 커밋 전 검증(--commit)에서 빠지고
# push 전(pre-push 훅)과 CI 에서만 돈다.
VERIFY_DEFAULTS = {"post_commit": False, "pre_push": True, "incremental": True,
                   "script_tests": True, "test_paths": [], "test_on": "commit"}
VERIFY_STAGES = ("commit", "push")
# 하네스 스크립트 회귀 테스트. 관리 파일이라 하네스를 갱신할 때만 바뀌므로 그때만 다시 돈다
# 서로 독립이라 동시에 돈다. 실패한 것만 전체 출력을 낸다
SCRIPT_TESTS = ("하네스 스크립트 회귀",
                'rc=0; for t in script/test-*.sh; do ( l=$(mktemp); if "$t" >"$l" 2>&1; then tail -1 "$l"; '
                'else cat "$l" >&2; rm -f "$l"; exit 1; fi; rm -f "$l" ) & done; '
                'for p in $(jobs -p); do wait "$p" || rc=1; done; exit $rc', ["script/**"], "commit")
# 단계의 경로 하나: 하네스 루트 기준 glob. `*` 는 `/` 도 넘는다(`src/**` == `src/*`)
VERIFY_PATH = re.compile(r"(?!/)(?!(.*/)?\.\.(/|$))[^\s]+")
# 옛 방식 — 사람이 손으로 쓰던 검증 스크립트와 명령 문서. 새로 깔지 않지만, 있으면 존중한다.
LEGACY_VERIFY = "script/verify-project.sh"
LEGACY_VERIFY_TEMPLATE = "verify-project: not filled in yet"   # 채우지 않은 원형의 마지막 줄
LEGACY_COMMANDS = ".ai/project/commands.md"


# 실행 지표. 리포 밖(홈 아래)에 남아 커밋되지 않는다. 기록은 script/metric.py, 집계는 `harness metrics`.
# dir 의 {clone} 은 실행할 때 이 클론의 키로 풀린다 — 생성 파일에는 설정 값 그대로 들어간다.
METRICS_DEFAULTS = {"dir": "$HOME/.harness/{clone}/metrics", "retention_days": 30, "max_file_mb": 10,
                    "max_total_mb": 100, "stale_after_hours": 6, "capture_logs": "errors"}


# 클론 키의 모양. 등록부 최상위에서 클론의 상태 디렉터리를 옛 이름 디렉터리와 가르므로 project.name 으로 쓰지 못한다.
CLONE_KEY = re.compile(r"c-[0-9a-f]{16}")


# 이슈별 작업 트리. dir 의 확장은 쓰는 시점에 한다 — 값이 실행 환경에 달려 있다.
WORKTREE_DEFAULTS = {"dir": "$HOME/.harness/{clone}/worktrees", "include": [".claude/settings.local.json"]}
# 하네스 루트 기준 상대 경로: `/` 로 시작하지 않고, `..` 조각·공백·glob 문자가 없다
INCLUDE_PATH = re.compile(r"(?!/)(?!(.*/)?\.\.(/|$))[^\s*?\[]+")

# Claude Code 권한. 허용 목록 자체는 settings_json() 이 만든다 — 여기는 프로젝트가 고르는 값뿐이다.
PERMISSIONS_DEFAULTS = {"allow_push": False}

# forge 가 읽는 이슈·리뷰 요청 템플릿을 만들지. 끄면 리포가 자기 템플릿(사내 표준 등)을 그대로 쓴다.
FORGE_DEFAULTS = {"templates": True}

# 준비 점검. remote_timeout 은 원격 점검의 호출 하나에 주는 시간(초)이다 — 넘으면 그 항목은 확인하지 못한 것이다.
DOCTOR_DEFAULTS = {"remote_timeout": 30}
# remote_timeout 의 상한(초). 원격 점검은 호출을 순차로 하므로 이보다 길면 한 번의 점검이 끝나지 않는 것처럼 보인다.
REMOTE_TIMEOUT_LIMIT = 600


def worktree_dir(cfg: dict, target: Path) -> str:
    """[worktree].dir 의 자리표시를 이 클론의 키로 풀고 `~` 와 환경 변수를 확장한 것."""
    return os.path.expandvars(os.path.expanduser(expand_key(cfg["worktree"]["dir"], target)))


def old_alias_keys(cfg: dict) -> list:
    """자리표시를 푸는 설정 값 중 옛 별칭 `{project}` 를 쓰는 키(점으로 이은 이름)."""
    vals = (("metrics.dir", cfg["metrics"]["dir"]), ("usage.log_path", cfg["usage"]["log_path"]),
            ("worktree.dir", cfg["worktree"]["dir"]))
    return [k for k, v in vals if isinstance(v, str) and "{project}" in v]


def metrics_cfg(cfg: dict, target: Path) -> dict:
    """[metrics] 의 dir 자리표시를 이 클론의 키로 푼 것. 환경 변수는 풀지 않는다. dir 이 "off" 면 기록하지 않는다."""
    m = dict(cfg["metrics"])
    if m["dir"] != "off":
        m["dir"] = expand_key(m["dir"], target)
    return m


def QUIET_ENV() -> dict:
    """점검(doctor)이 검증을 돌릴 때의 환경 — 실행 지표를 남기지 않고, 프로젝트 검증만 본다(하네스 스크립트 회귀는 뺀다).
    열 때마다 실행이 쌓이지 않고 수십 초씩 걸리지 않게."""
    return dict(os.environ, HARNESS_METRICS="off", HARNESS_SCRIPT_TESTS="off")


def legacy_verify(target) -> bool:
    """손으로 쓴 검증 스크립트가 있는가. 채우지 않은 원형은 없는 것과 같다."""
    f = target / LEGACY_VERIFY if target else None
    return bool(f and f.is_file() and LEGACY_VERIFY_TEMPLATE not in f.read_text(encoding="utf-8"))


def verify_entry(target) -> str:
    """검증으로 도는 스크립트 — 채운 옛 검증 스크립트가 있으면 그것, 아니면 생성된 검증 스크립트. 하네스 루트 기준."""
    return LEGACY_VERIFY if legacy_verify(target) else VERIFY_SCRIPT


def verify_steps(cfg: dict) -> list:
    """프로젝트 검증 단계 (이름, 명령, 경로, 시점). 계층 의존 검사가 먼저다 — 싸고, 위반이면 어차피 설계를 고쳐야 한다."""
    c, v = cfg["commands"], cfg["verify"]
    return ([(x["name"], x["run"], x.get("paths", []), x.get("on", "commit")) for x in v["checks"]]
            + [("코드 검사", c["format_check"], [], "commit")] * bool(c.get("format_check"))
            + [("테스트", c["test"], v["test_paths"], v["test_on"])] * bool(c.get("test")))


# 생성되는 검증 스크립트의 몸통. 단계 목록만 설정에서 오고 나머지는 고정이다.
VERIFY_SH = r'''# 프로젝트 검증 — harness.toml 의 [verify] 가 정한 단계를 차례로 돈다. `script/run-lint-test.sh` 가 부른다.
#
#   script/harness-verify.sh [--commit] [--no-cache]
#     --commit    on = "commit" 단계만 (커밋 전). 없으면 전부 (push 전 · CI)
#     --no-cache  통과 기록을 보지 않고 전부 다시 돈다. HARNESS_VERIFY_CACHE=off 도 같다
#
# 단계마다 마지막으로 통과한 작업 트리(추적·미추적, 무시 파일 제외)의 해시를 git 공통 디렉터리에 남긴다.
# 그 뒤 바뀐 파일이 단계의 경로에 하나도 걸리지 않으면 건너뛴다. 경로가 없는 단계는 무엇이든 바뀌면 돈다.
# 기록은 트리 내용만 본다 — 도구 버전·환경 변수가 바뀌었으면 --no-cache 로 돈다. git 밖이면 기록 없이 전부 돈다.
# 종료 코드: 0 통과 · 1 실패 · 2 인자 오류 · %(unset)d 아직 명령을 정하지 않았다
set -uo pipefail
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# 직접 불러도 단계들이 한 실행 아래에 모이게 자기 한 번을 스팬으로 감싼다
[ "${HARNESS_METRIC_SELF:-}" = harness-verify ] || [ ! -x script/metric.py ] || \
  exec env HARNESS_METRIC_SELF=harness-verify script/metric.py wrap --name harness-verify --kind script --attr script=harness-verify -- "$PWD/script/harness-verify.sh" "$@"

stage=push
cache=%(cache)s
for a in "$@"; do
  case "$a" in
    --commit) stage=commit ;;
    --no-cache) cache=0 ;;
    *) echo "usage: script/harness-verify.sh [--commit] [--no-cache]" >&2; exit 2 ;;
  esac
done
[ "${HARNESS_VERIFY_CACHE:-}" = off ] && cache=0

tree="" rec=""
if [ "$cache" = 1 ] && rec=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null); then
  rec="$rec/harness-verify"
  idx=$(mktemp)
  # 실제 인덱스를 건드리지 않는다 — 사본에 작업 트리를 올려 그 트리 해시만 얻는다
  cp "$(git rev-parse --path-format=absolute --git-path index)" "$idx" 2>/dev/null || rm -f "$idx"
  tree=$(GIT_INDEX_FILE="$idx" git add -A . 2>/dev/null && GIT_INDEX_FILE="$idx" git write-tree 2>/dev/null) || tree=""
  rm -f "$idx"
fi

# touches <기준 트리> <현재 트리> [glob ...] — 두 트리 사이에 바뀐 파일 하나라도 glob 에 걸리는가. glob 이 없으면 무엇이든.
# 이름 변경은 옛 경로와 새 경로를 둘 다 본다(--no-renames). 경로는 따옴표·이스케이프 없이 NUL 로 받는다(-z)
touches() {
  local a="$1" b="$2" f g; shift 2
  while IFS= read -r -d '' f; do
    [ $# -gt 0 ] || return 0
    for g in "$@"; do
      # shellcheck disable=SC2254
      case "$f" in $g) return 0 ;; esac
    done
  done < <(git diff -z --no-renames --relative --name-only "$a" "$b")
  return 1
}

# step <이름> <commit|push> <명령> [경로 glob ...]
step() {
  local name="$1" on="$2" cmd="$3" key="" last=""; shift 3
  if [ "$stage" = commit ] && [ "$on" = push ]; then echo "verify: skip $name (push stage)"; return 0; fi
  if [ -n "$tree" ]; then
    key="$rec/$(printf '%%s\n%%s' "$name" "$cmd" | git hash-object --stdin)"
    last=$(cat "$key" 2>/dev/null || true)
    if [ -n "$last" ] && git cat-file -e "$last^{tree}" 2>/dev/null \
       && ! touches "$last" "$tree" "$@"; then
      echo "verify: skip $name (unchanged since it last passed)"
      return 0
    fi
  fi
  echo "verify: $name"
  if [ -x script/metric.py ]; then
    script/metric.py wrap --name "verify/$name" --kind script --attr script=harness-verify -- bash -c "$cmd"
  else
    bash -c "$cmd"
  fi || { echo "verify: FAIL $name" >&2; exit 1; }
  [ -z "$key" ] || { mkdir -p "$rec" && echo "$tree" > "$key"; }
}

'''


def verify_script(cfg: dict) -> str:
    v = cfg["verify"]
    steps = verify_steps(cfg)
    line = lambda n, r, paths, on: "step %s\n" % " ".join(shlex.quote(x) for x in (n, on, r, *paths))
    # 점검(doctor)은 HARNESS_SCRIPT_TESTS=off 로 이 단계를 부르지 않는다 — 부르지 않았으니 통과 기록도 남지 않는다
    scripts = '[ "${HARNESS_SCRIPT_TESTS:-}" = off ] || ' + line(*SCRIPT_TESTS) if v["script_tests"] else ""
    body = (scripts + "".join(line(*s) for s in steps) + 'echo "verify: ok"\n' if steps else (
        'echo "verify: not set up — harness.toml has no [commands] or [verify] checks yet" >&2\n'
        'echo "help: harness set commands.test \\"<test command>\\"   (or Project Settings → Commands)" >&2\n'
        "exit %d\n" % VERIFY_UNSET))
    return "#!/usr/bin/env bash\n" + BANNER_SH + VERIFY_SH % {"unset": VERIFY_UNSET, "cache": int(v["incremental"])} + body


def commands_doc(cfg: dict, target: Path = None) -> str:
    """규칙 문서 3장. 명령을 아직 안 정했고 옛 명령 문서가 있으면 그것을 담는다 — 채운 내용을 잃지 않게."""
    c = cfg["commands"]
    if not any(c.values()):
        old = target / LEGACY_COMMANDS if target else None
        if old and old.is_file():
            return LEAD_COMMENT.sub("", old.read_text(encoding="utf-8"), count=1).strip()
        return ("명령이 아직 정해지지 않았다. `harness.toml` 의 `[commands]` 에 적는다. "
                "여기 없는 명령을 지어내 실행하지 않는다.")
    cell = lambda x: "`%s`" % x.replace("|", "\\|") if x else "정하지 않음"
    rows = ["| 작업 | 명령 |", "|---|---|"] + ["| %s | %s |" % (label, cell(c[k])) for k, label in COMMAND_KEYS]
    rows.append("| 검증 일괄 | `script/run-lint-test.sh` |")
    steps = verify_steps(cfg)
    tail = ("\n\n검증(`%s`)은 이 순서로 돈다: %s." % (VERIFY_SCRIPT, " → ".join(
        n + (" (push 전)" if on == "push" else "") for n, _r, _p, on in steps))) if steps else ""
    return "\n".join(rows) + tail


def verify_when(what: str, paths, on):
    """검증 단계 하나의 경로·시점이 성립하는가."""
    if not (isinstance(paths, list) and all(isinstance(p, str) and VERIFY_PATH.fullmatch(p) for p in paths)):
        die("error: %s paths must be a list of repository-relative globs like \"src/**\" (got %r)" % (what, paths))
    if on not in VERIFY_STAGES:
        die("error: %s on must be one of %s (got %r)" % (what, ", ".join(VERIFY_STAGES), on))


def normalize(cfg: dict):
    """설정을 소비자가 쓸 형태로 채운다. 읽은 직후 한 번만 돈다.

    통합 브랜치는 보호 목록에 **자동으로 들어간다.** 거기로 직접 push 할 수 있으면 승인 게이트가
    우회되므로 선택지가 아니고, 그렇다면 사람이 두 곳에 같은 이름을 적을 이유도 없다.
    """
    cfg["harness"].setdefault("model", "")   # 오케스트레이터 모델 — 옛 설정에는 없다
    # 프로젝트 명령과 검증 단계 — 옛 설정에는 없다. 비어 있으면 검증이 "아직 정하지 않음" 으로 멈춘다
    cmds = cfg.setdefault("commands", {})
    for k, _ in COMMAND_KEYS:
        cmds.setdefault(k, "")
    cfg.setdefault("verify", {}).setdefault("checks", [])
    for k, x in VERIFY_DEFAULTS.items():   # 검증 시점 · 증분 — 옛 설정에는 없다
        cfg["verify"].setdefault(k, list(x) if isinstance(x, list) else x)
    for k, x in METRICS_DEFAULTS.items():
        cfg.setdefault("metrics", {}).setdefault(k, x)
    for k, x in WORKTREE_DEFAULTS.items():   # 이슈별 작업 트리 — 옛 설정에는 없다
        cfg.setdefault("worktree", {}).setdefault(k, list(x) if isinstance(x, list) else x)
    for k, x in PERMISSIONS_DEFAULTS.items():   # 권한 — 옛 설정에는 없다
        cfg.setdefault("permissions", {}).setdefault(k, x)
    for k, x in DOCTOR_DEFAULTS.items():   # 준비 점검 — 옛 설정에는 없다
        cfg.setdefault("doctor", {}).setdefault(k, x)
    for k, x in FORGE_DEFAULTS.items():   # forge 템플릿 생성 여부 — 옛 설정에는 없다
        cfg["forge"].setdefault(k, x)
    b = cfg["branches"]
    if b["base"] not in b["protected"]:
        b["protected"] = b["protected"] + [b["base"]]
    # 설정에 절차가 없으면 하네스 기본값을 쓴다. 단계 정의가 생기기 전에 설치한 프로젝트도
    # 설정을 고치지 않고 그대로 렌더된다.
    d = cfg["docs"]
    d["protected"] = BASE_PROTECTED + [x for x in d["protected"] if x not in BASE_PROTECTED]
    wfs = cfg.setdefault("workflows", {})
    for name, body in default_workflows().items():
        wfs.setdefault(name, body)
    # 단계의 종류 키는 `type` 이다. `kind` 로 적은 옛 설정도 그대로 읽는다
    for body in wfs.values():
        for st in body.get("steps") or []:
            if "type" not in st and "kind" in st:
                st["type"] = st.pop("kind")


# ─────────────────────────────────────────────────────────────────────────────
# 에이전트 등록부 — 정본은 templates/vendors.toml
# ─────────────────────────────────────────────────────────────────────────────
# 벤더마다 다른 것(띄우는 명령·권한 인자·결과 받는 법·어댑터 형식)은 전부 그 파일에 있다.
# 여기는 그 선언을 읽는 일반 엔진뿐이다 — 벤더 이름으로 분기하지 않는다.
with (TEMPLATES / "vendors.toml").open("rb") as _f:
    VENDORS = {v["id"]: v for v in tomllib.load(_f)["vendor"]}
for _i, _v in VENDORS.items():
    # 로그인 확인 명령은 그대로 실행된다 — 자기 CLI 를 부르는 문자열 argv 만 받는다
    if "auth_check" in _v:
        _a = _v["auth_check"]
        if not (isinstance(_a, list) and _a and all(isinstance(x, str) for x in _a) and _a[0] == _v["exe"]):
            die("error: templates/vendors.toml: vendor `%s` auth_check must be a non-empty list of strings "
                "starting with its exe `%s`" % (_i, _v["exe"]))
ORCHESTRATORS = [i for i, v in VENDORS.items() if v.get("launch")]
RUNNERS = [i for i, v in VENDORS.items() if v.get("headless")]
# UI·schema 가 보던 모양. 고를 수 있는지는 선언에 명령이 있는지로 정한다
AGENTS = [{"id": i, "name": v["name"], "exe": v["exe"], "orchestrator": i in ORCHESTRATORS, "runner": i in RUNNERS}
          for i, v in VENDORS.items()]


def expand(argv: list, vals: dict) -> list:
    """argv 템플릿을 푼다. 원소 전체가 목록 값의 이름이면 그 목록으로 펼치고, 나머지는 문자열 치환이다.

    셸을 거치지 않는다 — 값에 공백이나 따옴표가 있어도 인자 하나로 남는다. 모르는 이름은 막는다."""
    out = []
    for a in argv:
        m = re.fullmatch(r"\{(\w+)\}", a)
        if m and isinstance(vals.get(m.group(1)), list):
            out += vals[m.group(1)]
            continue
        def sub(x):
            v = vals.get(x.group(1))
            if not isinstance(v, str):
                die("error: templates/vendors.toml uses {%s}, which is not known here" % x.group(1))
            return v
        out.append(re.sub(r"\{(\w+)\}", sub, a))
    return out


# 역할 절에 적지 않아도 되는 키. `harness set` 이 처음 정할 때 그 절에 더한다.
OPTIONAL_ROLE_KEYS = ("model",)
# 역할의 실행 방식은 그 역할의 어댑터 본문(templates/agents/<역할>.md) frontmatter 가 선언한다.
#   headless       false 면 CLI 러너를 고를 수 없다(서브에이전트로만). 적지 않으면 true
#   entry          CLI 러너일 때 부르는 전용 스크립트. 없으면 공용 실행기 `script/run-agent.py <역할>`
#   distinct_from  이 역할들과 실제 실행 주체가 같으면 안 된다(쉼표로 여럿). invariants.distinct_reviewer 가 켜고 끈다
RUN_AGENT = "script/run-agent.py"


def role_meta(name: str) -> dict:
    """역할 어댑터 본문(templates/agents/<역할>.md)의 frontmatter. 파일이 없으면 {}.

    frontmatter 의 원래 키(description · summary · about …)에 해석한 값(headless · entry ·
    distinct_from)을 덮고, 본문(body)과 파일 경로(path)를 함께 담는다.
    """
    src = TEMPLATES / "agents" / ("%s.md" % name)
    if not src.is_file():
        return {}
    meta, body = parse_frontmatter(src.read_text(encoding="utf-8"), str(src))
    return dict(meta, headless=meta.get("headless", "true") != "false", entry=meta.get("entry", ""),
                distinct_from=[x.strip() for x in meta.get("distinct_from", "").split(",") if x.strip()],
                body=body, path=src)


def role_model(cfg: dict, role: str) -> str:
    """역할이 실제로 쓰는 모델.

    - 러너가 오케스트레이터와 같은 CLI 면 오케스트레이터 자신이다 — 오케스트레이터 모델(harness.model)만 쓴다.
      오케스트레이터 설정은 한 곳에만 둔다
    - 서브에이전트(inproc)는 역할마다 고른다. 비우면 오케스트레이터 모델을 이어받는다
    - 다른 CLI 는 역할의 모델이고, 비우면 그 CLI 의 기본 모델이다"""
    r, h = cfg["roles"][role], cfg["harness"]
    if r["runner"] == h["orchestrator"]:
        return h.get("model", "")
    if r["runner"] == "inproc":
        return r.get("model") or h.get("model", "")
    return r.get("model", "")


def model_args(v: dict, model: str) -> list:
    return expand(v.get("model", []), {"model": model}) if model else []


def headless_argv(cfg: dict, role: str) -> list:
    """CLI 러너 역할을 한 번 돌리는 argv — 결과 받는 인자와 프롬프트는 실행기가 붙인다."""
    r = cfg["roles"][role]
    v = VENDORS[r["runner"]]
    return expand(v["headless"], {"role": role, "access": v["access"][r["access"]], "model": model_args(v, role_model(cfg, role))})


def run_plan(cfg: dict) -> dict:
    """역할마다 실제로 무엇이 도는지 확정한 표. 셸 스크립트와 UI 는 이것만 읽고 다시 풀지 않는다."""
    roles = {}
    for n, r in sorted(cfg["roles"].items()):
        if r["runner"] == "inproc":
            roles[n] = {"via": "subagent", "vendor": cfg["harness"]["orchestrator"]}
        else:
            roles[n] = {"via": "headless", "vendor": r["runner"], "exe": VENDORS[r["runner"]]["exe"],
                        "argv": headless_argv(cfg, n), "output": VENDORS[r["runner"]]["output"],
                        "model": role_model(cfg, n),
                        "usage_format": VENDORS[r["runner"]].get("usage_format", []),
                        "usage_parser": VENDORS[r["runner"]].get("usage_parser", ""),
                        "auth_check": VENDORS[r["runner"]].get("auth_check", []),
                        # 로그인 확인 명령 하나에 주는 시간(초). 원격 점검의 호출 하나와 같은 값이다
                        "auth_timeout": cfg["doctor"]["remote_timeout"],
                        "entry": role_meta(n).get("entry") or "%s %s" % (RUN_AGENT, n)}
    return {"_generated": "harness.toml 에서 생성된다. 직접 고치지 않는다 — harness render 가 다시 만든다.",
            "roles": roles, "metrics": dict(cfg["metrics"])}


def vendor(cfg: dict, role: str) -> str:
    """그 역할을 실제로 실행하는 쪽. inproc 은 오케스트레이터다."""
    r = cfg["roles"][role]["runner"]
    return cfg["harness"]["orchestrator"] if r == "inproc" else r


def validate(cfg: dict):
    name = cfg["project"]["name"]
    if isinstance(name, str) and CLONE_KEY.fullmatch(name):
        die("error: project.name `%s` has the form of a clone key (c- and 16 hex digits)\n\n"
            "help: choose another project.name in harness.toml" % name)
    c = cfg["commit"]
    if c["issue_ref"] not in ("suffix", "prefix"):
        die("error: commit.issue_ref must be `suffix` or `prefix` (got %r)" % c["issue_ref"])
    if c["issue_ref"] == "prefix" and not c.get("ticket_key"):
        die("error: commit.issue_ref = prefix requires commit.ticket_key\n\nhelp: set the ticket prefix your tracker uses\n        harness set commit.ticket_key BD")
    if not c["tags"]:
        die("error: commit.tags is empty — at least one tag is required")

    # Jira 는 코드 리뷰를 호스팅하지 않는다. 고르게 두면 리뷰 함수가 없는 어댑터로 루프가 돈다.
    if cfg["forge"]["review_host"] not in ("gitlab", "github"):
        die("error: forge.review_host must be gitlab or github (got %r)\n"
            "\n"
            "  Jira tracks issues but does not host code review, so it cannot be the\n"
            "  review host. Track issues there and review somewhere else.\n"
            "\n"
            "help: set the two separately\n"
            "        harness set forge.tracker jira\n"
            "        harness set forge.review_host <gitlab|github>"
            % cfg["forge"]["review_host"])

    if not isinstance(cfg["forge"]["templates"], bool):
        die("error: forge.templates must be true or false (got %r)" % (cfg["forge"]["templates"],))

    if cfg["harness"]["orchestrator"] not in ORCHESTRATORS:
        die("error: harness.orchestrator must be one of %s (got %r)"
            % (", ".join(ORCHESTRATORS), cfg["harness"]["orchestrator"]))
    for name, role in cfg["roles"].items():
        # 어댑터 본문이 없는 역할은 어느 명령에서도 기본값으로 채워 넘기지 않는다
        if not role_meta(name):
            die("error: no adapter body for role `%s`\n  --> %s" % (name, TEMPLATES / "agents" / ("%s.md" % name)))
        if role["runner"] not in ["inproc"] + RUNNERS:
            die("error: roles.%s.runner must be one of %s (got %r)"
                % (name, ", ".join(["inproc"] + RUNNERS), role["runner"]))
        # 역할이 CLI 로 도는 것을 막아 두었으면(headless: false) 서브에이전트로만 돈다
        if role["runner"] != "inproc" and not role_meta(name).get("headless", True):
            die("error: roles.%s.runner = %s, but %s only runs as a subagent of the orchestrator\n\n"
                "  Its contract declares `headless: false`, so its runner can only be inproc.\n\n"
                "help: harness set roles.%s.runner inproc" % (name, role["runner"], name, name))
        if role["access"] not in ("read-only", "write"):
            die("error: roles.%s.access must be read-only or write (got %r)" % (name, role["access"]))

    # 브랜치 이름은 훅의 case 패턴과 가드에 그대로 들어간다
    bad = [x for x in [cfg["branches"]["base"]] + cfg["branches"]["protected"] if not BRANCH_NAME.fullmatch(x)]
    if bad:
        die("error: branches has a name that is not a single branch name: %s\n\n"
            "help: list each branch as its own string, like protected = [\"main\", \"develop\"]"
            % ", ".join(repr(x) for x in bad))

    bad = [x for x in cfg["docs"]["protected"] if not PROTECTED_PATH.fullmatch(x)]
    if bad:
        die("error: docs.protected has a path that is not a repository-relative file or directory: %s\n\n"
            "help: write it relative to the repository root, like `docs/spec/x.md`, `docs/spec/` or `docs/spec/**`"
            % ", ".join(repr(x) for x in bad))

    for key in ("max_rounds", "repeat_file_max"):
        n = cfg["review"][key]
        if not isinstance(n, int) or isinstance(n, bool) or not 1 <= n <= REVIEW_LIMIT:
            die("error: review.%s must be a whole number from 1 to %d (got %r)" % (key, REVIEW_LIMIT, n))

    d = cfg["adr"]["dir"]
    if not PROTECTED_PATH.fullmatch(d) or d.endswith("**"):
        die("error: adr.dir must be a repository-relative directory like `docs/adr` (got %r)" % d)

    unknown = sorted(set(cfg["commands"]) - {k for k, _ in COMMAND_KEYS})
    if unknown:
        die("error: unknown key(s) in [commands]: %s\n\nhelp: the keys are %s"
            % (", ".join(unknown), ", ".join(k for k, _ in COMMAND_KEYS)))
    for k, x in cfg["commands"].items():
        if not isinstance(x, str) or "\n" in x:
            die("error: commands.%s must be a one-line command string" % k)
    checks = cfg["verify"]["checks"]
    if not isinstance(checks, list):
        die("error: verify.checks must be a list of { name, run }")
    for n, x in enumerate(checks, 1):
        if (not isinstance(x, dict) or set(x) - {"name", "run", "paths", "on"}
                or not all(isinstance(x.get(k), str) and x[k].strip() and "\n" not in x[k] for k in ("name", "run"))):
            die("error: verify.checks[%d] needs a name and a run command, one line each (got %r)\n\n"
                "help: a check longer than one line belongs in a script — run = \"script/check-deps.sh\"" % (n, x))
        verify_when("verify.checks[%d]" % n, x.get("paths", []), x.get("on", "commit"))
    v = cfg["verify"]
    unknown = sorted(set(v) - set(VERIFY_DEFAULTS) - {"checks"})
    if unknown:
        die("error: unknown key(s) in [verify]: %s\n\nhelp: the keys are checks, %s" % (", ".join(unknown), ", ".join(VERIFY_DEFAULTS)))
    for k in ("post_commit", "pre_push", "incremental", "script_tests"):
        if not isinstance(v[k], bool):
            die("error: verify.%s must be true or false (got %r)" % (k, v[k]))
    verify_when("verify.test", v["test_paths"], v["test_on"])

    m = cfg["metrics"]
    unknown = sorted(set(m) - set(METRICS_DEFAULTS))
    if unknown:
        die("error: unknown key(s) in [metrics]: %s\n\nhelp: the keys are %s" % (", ".join(unknown), ", ".join(METRICS_DEFAULTS)))
    if not isinstance(m["dir"], str) or not m["dir"].strip():
        die("error: metrics.dir must be a directory path, or \"off\"")
    for k in ("retention_days", "max_file_mb", "max_total_mb", "stale_after_hours"):
        if not isinstance(m[k], int) or isinstance(m[k], bool) or m[k] < 1:
            die("error: metrics.%s must be a whole number of at least 1 (got %r)" % (k, m[k]))
    if m["max_file_mb"] > m["max_total_mb"]:
        die("error: metrics.max_file_mb (%d) is larger than metrics.max_total_mb (%d)" % (m["max_file_mb"], m["max_total_mb"]))
    if m["capture_logs"] not in ("errors", "off"):
        die("error: metrics.capture_logs must be `errors` or `off` (got %r)" % m["capture_logs"])

    w = cfg["worktree"]
    unknown = sorted(set(w) - set(WORKTREE_DEFAULTS))
    if unknown:
        die("error: unknown key(s) in [worktree]: %s\n\nhelp: the keys are %s" % (", ".join(unknown), ", ".join(WORKTREE_DEFAULTS)))
    if not isinstance(w["dir"], str) or not w["dir"].strip() or "\n" in w["dir"]:
        die("error: worktree.dir must be a one-line directory path (got %r)" % (w["dir"],))
    if not isinstance(w["include"], list):
        die("error: worktree.include must be a list of paths relative to the harness root (got %r)" % (w["include"],))
    for n, x in enumerate(w["include"], 1):
        if not isinstance(x, str) or not INCLUDE_PATH.fullmatch(x):
            die("error: worktree.include[%d] must be a path relative to the harness root (got %r)" % (n, x))

    pm = cfg["permissions"]
    unknown = sorted(set(pm) - set(PERMISSIONS_DEFAULTS))
    if unknown:
        die("error: unknown key(s) in [permissions]: %s\n\nhelp: the keys are %s" % (", ".join(unknown), ", ".join(PERMISSIONS_DEFAULTS)))
    if not isinstance(pm["allow_push"], bool):
        die("error: permissions.allow_push must be true or false (got %r)" % (pm["allow_push"],))

    dc = cfg["doctor"]
    unknown = sorted(set(dc) - set(DOCTOR_DEFAULTS))
    if unknown:
        die("error: unknown key(s) in [doctor]: %s\n\nhelp: the keys are %s" % (", ".join(unknown), ", ".join(DOCTOR_DEFAULTS)))
    n = dc["remote_timeout"]
    if not isinstance(n, int) or isinstance(n, bool) or not 1 <= n <= REMOTE_TIMEOUT_LIMIT:
        die("error: doctor.remote_timeout must be a whole number of seconds from 1 to %d (got %r)" % (REMOTE_TIMEOUT_LIMIT, n))

    validate_workflows(cfg)

    if cfg.get("invariants", {}).get("distinct_reviewer", True):
        for rev, dev in distinct_pairs(cfg):
            if vendor(cfg, dev) == vendor(cfg, rev):
                die("error: %s and %s run on the same runner (%s)\n"
                    "\n"
                    "  A model reviewing its own output walks past the same blind spot twice,\n"
                    "  so the review adds nothing the implementation did not already assume.\n"
                    "\n"
                    "help: give %s a different runner\n"
                    "        harness set roles.%s.runner <%s>\n"
                    "\n"
                    "help: to accept this on purpose, opt out explicitly\n"
                    "        harness set invariants.distinct_reviewer false"
                    % (dev, rev, vendor(cfg, rev), rev, rev, "|".join(RUNNERS)))


# ─────────────────────────────────────────────────────────────────────────────
# 파생 — 설정값에서 각 소비자가 쓰는 형태를 만든다
# ─────────────────────────────────────────────────────────────────────────────

TOOLS_BY_ACCESS = {
    "read-only": ["Read", "Grep", "Glob"],
    "write": ["Read", "Write", "Edit", "Grep", "Glob", "Bash"],
}


def tools_of(role: dict) -> list:
    return role.get("tools") or TOOLS_BY_ACCESS[role["access"]]


def distinct_pairs(cfg: dict) -> list:
    """(역할, 그와 달라야 하는 역할) — 역할 선언의 distinct_from 에서. 설정에 없는 역할은 뺀다."""
    return [(n, o) for n in sorted(cfg["roles"]) for o in role_meta(n).get("distinct_from", []) if o in cfg["roles"]]


FORGE_CLI = {"gitlab": "glab", "github": "gh", "jira": "jira"}


def docs_regex(patterns: list) -> str:
    """보호 문서 glob 을 가드가 쓰는 정규식 하나로. `docs/x/**` 는 그 아래 전부를 뜻한다."""
    out = []
    for g in patterns:
        g = g.rstrip("*").rstrip("/") + ("/" if g.rstrip("*").endswith("/") or g.endswith("**") else "")
        out.append(re.escape(g).replace("\\/", "/"))
    return "|".join(out)


def adr_procedure(style: str, tool: str, d: str) -> str:
    """결정 기록을 만들고 대체하는 절차. **도구가 정하므로 문서에 적어 두지 않는다.**

    도구를 바꿨는데 절차가 그대로면 없는 명령을 지시하게 된다.
    """
    if tool == "adr-tools":
        return (
            "| 하는 일 | 명령 |\n|---|---|\n"
            '| 새 결정 만들기 | `adr new "<영문 제목>"` |\n'
            '| 기존 결정 대체하기 | `adr new -s <기존번호> "<영문 제목>"` |\n'
            "| 목록 | `adr list` |\n\n"
            "- **제목은 영어로 준다.** 도구가 제목을 그대로 파일명으로 쓴다.\n"
            "- **상태를 손으로 고치지 않는다.** 도구가 넣는 값을 그대로 둔다.\n"
            "- 대체는 한 명령이지만 원자적이지 않다. 중간에 실패하면 새 문서와 기존 문서의 표기가\n"
            "  어긋난 채 남으므로, 커밋 전에 작업 트리를 확인하고 필요하면 되돌린 뒤 다시 실행한다."
        )
    if tool == "adrs":
        fmt = " --format madr" if style == "madr" else ""
        return (
            "| 하는 일 | 명령 |\n|---|---|\n"
            '| 새 결정 만들기 | `adrs new%s "<영문 제목>"` |\n'
            '| 기존 결정 대체하기 | `adrs new%s --supersedes <기존번호> "<영문 제목>"` |\n'
            "| 목록 | `adrs list` |\n\n"
            "- **제목은 영어로 준다.** 도구가 제목을 그대로 파일명으로 쓴다.\n"
            "- **상태를 손으로 고치지 않는다.** 도구가 넣는 값을 그대로 둔다."
        ) % (fmt, fmt)
    where = "front matter 의 `status:` 한 줄" if style == "madr" else "`## Status` 절"
    return (
        "도구를 쓰지 않는다. 손으로 한다.\n\n"
        "| 하는 일 | 어떻게 |\n|---|---|\n"
        "| 새 결정 만들기 | `%s/templates/template.md` 를 `NNNN-title-with-dashes.md` 로 복사한다. "
        "번호는 남은 파일의 최대 번호 + 1 |\n"
        "| 기존 결정 대체하기 | 새 문서를 만들고, 기존 문서의 %s 만 대체 표기로 바꾼다 |\n"
        "| 목록 | `ls %s` |\n\n"
        "- **제목·파일명은 영어로 쓴다.** 본문은 프로젝트 문서 언어로.\n"
        "- **대체할 때 고치는 것은 상태 한 줄뿐이다.** 본문도 날짜도 건드리지 않는다 —\n"
        "  기록은 로그이고 틀린 결정도 그대로 남아야 한다."
    ) % (d, where, d)


def derive(cfg: dict) -> dict:
    p, b, c, r = cfg["project"], cfg["branches"], cfg["commit"], cfg["review"]
    i, m, f = cfg["issues"], cfg["mr"], cfg["forge"]
    tags = "|".join(c["tags"])
    docs_tag = "docs" if "docs" in c["tags"] else c["tags"][0]   # 문서 변경 커밋의 태그
    rv = VENDORS[vendor(cfg, "code-reviewer")]

    if c["issue_ref"] == "suffix":
        subject_re = r"^(%s): .+\(#[0-9]+\)$" % tags
        subject_form = "<tag>: {summary}(#{issue})"
        subject_example = "%s: short summary(#123)" % c["tags"][0]
        docs_form = "%s: <요약>(#<이슈번호>)" % docs_tag
    else:
        k = c["ticket_key"]
        subject_re = r"^\[%s-[0-9]+\] (%s): .+$" % (k, tags)
        subject_form = "[%s-{ticket}] <tag>: {summary}" % k
        subject_example = "[%s-123] %s: short summary" % (k, c["tags"][0])
        docs_form = "[%s-<이슈번호>] %s: <요약>" % (k, docs_tag)

    return {
        "HARNESS_VERSION": cfg["harness"]["version"],
        "PROJECT_NAME": p["name"],
        "BASE_BRANCH": b["base"],
        "PROTECTED_BRANCHES": " ".join(b["protected"]),
        "PROTECTED_REF_CASE": "|".join("refs/heads/%s" % x for x in b["protected"]),
        "PROTECTED_BRANCH_CASE": "|".join(b["protected"]),
        "COMMIT_TAGS": tags,
        "COMMIT_TAGS_HUMAN": " | ".join(c["tags"]),
        "COMMIT_SUBJECT_RE": subject_re,
        "COMMIT_SUBJECT_FORM": subject_form,
        "COMMIT_SUBJECT_EXAMPLE": subject_example,
        "COMMIT_DOCS_FORM": docs_form,
        "COMMIT_TICKET_KEY": c["ticket_key"] or "PROJ",
        "BRANCH_PATTERN": "<tag>/<issue-number>-<english-summary>",
        "REVIEW_MAX_ROUNDS": str(r["max_rounds"]),
        "REVIEW_REPEAT_FILE_MAX": str(r["repeat_file_max"]),
        "REVIEW_ROUND_LABEL": r["round_label"],
        "REVIEWER_LABEL": rv.get("label") or rv["name"],
        "FORGE_TRACKER": f["tracker"],
        "FORGE_REVIEW_HOST": f["review_host"],
        "FORGE_TRACKER_CLI": FORGE_CLI.get(f["tracker"], f["tracker"]),
        "FORGE_REVIEW_CLI": FORGE_CLI.get(f["review_host"], f["review_host"]),
        "ISSUE_LABEL_TASK": i["labels"].get("task", ""),
        "ISSUE_LABEL_REQUIREMENT": i["labels"].get("requirement", ""),
        "ISSUE_LABEL_INVALID": i["labels"].get("invalid", ""),
        "ISSUE_TYPE": i.get("type", ""),
        "ISSUE_CLOSED_STATUS": i.get("closed_status", ""),
        "ISSUE_REQUIRED_FIELDS": " ".join(i["required_fields"]),
        "ISSUE_DELETE_FORBIDDEN": "1" if i["deletion_forbidden"] else "0",
        "ISSUE_DELETE_RULE": (
            "이 프로젝트는 이슈 삭제를 **금지**한다. 잘못 만든 이슈는 `%s` 로\n"
            "    닫힌 채 영구히 남는다 — 되돌릴 수 없으므로 만들기 전에 확인한다"
            % i["labels"].get("invalid", "invalid")
        ) if i["deletion_forbidden"] else (
            "잘못 만든 이슈는 지울 수 있다. 그래도 빈 이슈를 만들지 않는다 —\n"
            "    지우기 전까지 남아 있고, 지우면 그 번호를 가리키던 참조가 깨진다"
        ),
        "FORGE_CLIS": " ".join(dict.fromkeys(
            [FORGE_CLI.get(f["tracker"], f["tracker"]),
             FORGE_CLI.get(f["review_host"], f["review_host"])])),
        "ISSUE_REF_DISPLAY": "#{id}" if c["issue_ref"] == "suffix" else "{id}",
        "MR_DEFAULT_ASSIGNEE": m["default_assignee"],
        "MR_DEFAULT_REVIEWER": m["default_reviewer"],
        "PROTECTED_DOCS_RE": docs_regex(cfg["docs"]["protected"]),
        # 가드 회귀 테스트가 "보호되는 경로 하나" 로 쓴다. 디렉터리면 그 아래 파일 하나를 만든다.
        "PROTECTED_DOCS_SAMPLE": (lambda g: g if not g.endswith("/") else g + "sample.md")(
            docs_regex(cfg["docs"]["protected"]).split("|")[0].replace("\\", "")),
        "PROTECTED_DOCS_LIST": ", ".join("`%s`" % g for g in cfg["docs"]["protected"]),
        "AGENT_TABLE": agent_table(cfg),
        "AGENT_COUNT": str(len(cfg["roles"])),
        "COMMAND_TABLE": "\n".join(command_rows(cfg)),
        "COMMAND_COUNT": str(len(command_rows(cfg))),
        "ADR_STYLE": cfg["adr"]["style"],
        "ADR_TOOL": cfg["adr"]["tool"],
        "ADR_DIR": cfg["adr"]["dir"],
        "ADR_PROCEDURE": adr_procedure(cfg["adr"]["style"], cfg["adr"]["tool"], cfg["adr"]["dir"]),
        "USAGE_LOG_PATH": cfg["usage"]["log_path"],
        "USAGE_ENV_VAR": cfg["usage"]["env_var"],
    }


# ─────────────────────────────────────────────────────────────────────────────
# 생성물
# ─────────────────────────────────────────────────────────────────────────────

VAR = re.compile(r"\{\{([A-Z_]+)\}\}")
INCLUDE = re.compile(r"^\{\{INCLUDE:(\S+)\}\}$", re.M)
LEAD_COMMENT = re.compile(r"\A\s*<!--.*?-->\s*", re.S)


def substitute(text: str, v: dict, where: str, target: Path = None) -> str:
    """{{VAR}} 치환. {{INCLUDE:경로}} 는 대상 리포의 소유 파일 본문을 그 자리에 넣는다.

    소유 파일을 참조가 아니라 본문으로 넣는 이유: 에이전트가 읽는 규칙 정본이 한 파일이어야
    하고, 중첩 import 가 모든 하네스에서 따라가진다는 보장이 없다. 사람이 소유 파일을 고치고
    render 를 잊으면 check 가 커밋을 막는다 — 어긋난 채로 지나가지 않는다.
    """
    # 변수는 템플릿 자신의 것만 본다. 소유 파일 본문은 그 뒤에 넣는다 — 프로젝트 문서가
    # `{{VAR}}` 같은 표기를 다룰 수 있고(템플릿 엔진을 쓰는 프로젝트, 이 하네스 자신), 그것을
    # 하네스 변수로 읽으면 사실 문서 한 줄이 render 를 막는다.
    missing = sorted({m for m in VAR.findall(text) if m not in v})
    if missing:
        die("error: unknown template variable(s): %s\n  --> %s" % (", ".join(missing), where))
    text = VAR.sub(lambda m: v[m.group(1)], text)
    if target is not None:
        def pull(m):
            p = target / m.group(1)
            if not p.is_file():
                die("error: included file is missing\n  --> %s\n  required by %s" % (p, where))
            body = p.read_text(encoding="utf-8")
            # 소유 파일 머리의 안내 주석은 그 파일을 고치는 사람에게 하는 말이다.
            # 규칙 정본에 담으면 에이전트가 읽는 근거에 소음이 섞인다.
            body = LEAD_COMMENT.sub("", body, count=1)
            return body.strip()
        text = INCLUDE.sub(pull, text)
    return text


def deny_rules(cfg: dict) -> list:
    """보호 브랜치 push · force push · --no-verify · 기준 문서 수정."""
    out = []
    for br in cfg["branches"]["protected"]:
        out += [
            "Bash(git push origin %s)" % br,
            "Bash(git push origin %s:*)" % br,
            "Bash(git push -u origin %s)" % br,
            "Bash(git push --set-upstream origin %s)" % br,
            "Bash(git push origin HEAD:%s)" % br,
            "Bash(git push*HEAD:refs/heads/%s*)" % br,
            "Bash(git push*refs/heads/%s*)" % br,
            "Bash(git push*:%s)" % br,
        ]
    out += [
        "Bash(git push --force:*)",
        "Bash(git push -f:*)",
        "Bash(git push --force-with-lease:*)",
        "Bash(git push origin --force:*)",
        "Bash(git push origin -f:*)",
        "Bash(git push origin +*)",
        "Bash(git push --no-verify:*)",
        "Bash(git push*--no-verify*)",
        "Bash(git commit --no-verify:*)",
        "Bash(git commit*--no-verify*)",
        "Bash(git commit -n:*)",
    ]
    for doc in cfg["docs"]["protected"]:
        # 디렉터리는 그 아래 전부다. 권한 규칙은 `dir/` 로는 그 아래 파일에 걸리지 않는다.
        rule = doc.rstrip("*").rstrip("/") + "/**" if doc.endswith(("/", "/**")) else doc
        # Edit 규칙이 Write · NotebookEdit 를 포함한 파일 편집 도구 전부에 걸린다.
        out.append("Edit(%s)" % rule)
    # 같은 문서를 `harness write-doc` 으로 쓰는 호출. 표기 차이(옵션 위치 등)는 명령 가드가 잡는다
    for doc in cfg["docs"]["protected"]:
        name = write_doc_scope(doc)
        if name is None:
            continue
        for h in WRITE_DOC_CALLERS:
            rule = "Bash(%s write-doc%s:*)" % (h, " " + name if name else "")
            if rule not in out:
                out.append(rule)
    return out


# write-doc 을 부르는 세 형태 — 전역 CLI, 고정 사본, 소스 리포의 실행 파일.
WRITE_DOC_CALLERS = ("harness", ".harness/bin/harness", "src/bin/harness")


def write_doc_scope(doc: str):
    """보호 항목 하나가 write-doc 이름으로 닿는 범위. 이름 접두(`scope` · `roles/`), 전부면 빈 문자열, 닿지 않으면 None."""
    base = PROJECT_DOCS + "/"
    if doc.endswith(("/", "/**")):
        d = doc.rstrip("*").rstrip("/") + "/"
        if base.startswith(d):
            return ""
        return d[len(base):] if d.startswith(base) else None
    if doc.startswith(base) and doc.endswith(".md") and len(doc) > len(base) + len(".md"):
        return doc[len(base):-len(".md")]
    return None


# 허용 목록에서 빼는 관리 스크립트 — 이슈·리뷰 요청을 닫거나 만드는, 되돌릴 수 없는 forge 쓰기와
# 원격에 라벨을 만드는 준비 쓰기다. 사람이 직접 부르고 확인을 주는 턴에서만 돈다.
ALLOW_EXCLUDED = ("rollback-work.sh", "create-carryover-issue.sh", "forge-selftest.sh", "forge-setup.sh")
ALLOW_KEYS = ("tracker", "review")


def allowed_scripts() -> list:
    """허용 목록에 드는 관리 스크립트 이름 — `script/` 바로 아래의 `.sh` · `.py` 중 모듈과 제외 목록을 뺀 것."""
    d = TEMPLATES / "managed" / "script"
    for name in ALLOW_EXCLUDED:
        if not (d / name).is_file():
            die("error: permission exclusion names a script that is not shipped: %s" % name)
    return sorted(p.name for p in d.iterdir()
                  if p.is_file() and p.suffix in (".sh", ".py")
                  and not p.name.startswith("_") and p.name not in ALLOW_EXCLUDED)


def forge_allow(kind: str, key: str) -> list:
    """forge 선언(`forge/<kind>/allow.toml`)에서 키 하나의 명령 접두 목록."""
    src = TEMPLATES / "forge" / kind / "allow.toml"
    if not src.is_file():
        die("error: no permission list for this forge\n  --> %s\n\nhelp: check [forge] in harness.toml" % src)
    with src.open("rb") as f:
        try:
            data = tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            die("error: %s: %s" % (src, e))
    unknown = sorted(set(data) - set(ALLOW_KEYS))
    if unknown:
        die("error: %s: unknown key(s): %s\n\nhelp: the keys are %s" % (src, ", ".join(unknown), ", ".join(ALLOW_KEYS)))
    items = data.get(key)
    if not isinstance(items, list) or not all(isinstance(x, str) for x in items):
        die("error: %s: `%s` must be a list of command prefixes" % (src, key))
    for n, x in enumerate(items, 1):
        if not x or x != x.strip() or "\n" in x or "\r" in x or "(" in x or ")" in x or x.endswith(":*"):
            die("error: %s: %s[%d] is not a command prefix (got %r)" % (src, key, n, x))
    return items


def allow_rules(cfg: dict) -> list:
    """승인 없이 도는 명령 — 관리 스크립트, forge 의 조회·리뷰 요청 생성·댓글, 브랜치 생성과 커밋.

    순서를 고정한다. 같은 설정에서 같은 파일이 나와야 check 가 어긋남을 오탐하지 않는다.
    """
    out = ["Bash(script/%s:*)" % name for name in allowed_scripts()]
    f = cfg["forge"]
    for kind, key in ((f["tracker"], "tracker"), (f["review_host"], "review")):
        for x in forge_allow(kind, key):
            rule = "Bash(%s:*)" % x
            if rule not in out:
                out.append(rule)
    out += ["Bash(git switch -c:*)", "Bash(git commit:*)"]
    if cfg["permissions"]["allow_push"]:
        out.append("Bash(git push:*)")
    return out


def settings_json(cfg: dict) -> str:
    data = {
        "hooks": {
            "PreToolUse": [{
                "matcher": "Bash",
                "hooks": [{
                    "type": "command",
                    "command": "$CLAUDE_PROJECT_DIR/script/hooks/bash-guard.sh",
                }],
            }],
        },
        # 절차가 정상 경로에서 부르는 명령은 묻지 않고 돈다 — 승인을 기다리면 흐름이 끊기고 비대화형 실행은 멈춘다.
        # 막아야 할 명령은 deny 와 가드가 막는다
        "permissions": {"allow": allow_rules(cfg), "deny": deny_rules(cfg)},
    }
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n"


# 값 안의 $HOME 을 셸이 펼쳐야 하는 키. 나머지는 전부 리터럴로 인용한다 —
# 정규식의 `$` 가 변수 확장으로 읽히면 검사식이 조용히 달라진다.
SHELL_EXPANDS = {"USAGE_LOG_PATH"}


def harness_env(v: dict) -> str:
    lines = [BANNER_SH, "# 셸이 읽는 설정값. `. script/harness.env` 로 소스한다.\n"]
    for k in sorted(v):
        lines.append("%s=%s\n" % (k, shell_quote(v[k], expand=k in SHELL_EXPANDS)))
    return "".join(lines)


def shell_quote(s: str, expand: bool = False) -> str:
    if s == "":
        return '""'
    if expand:
        return '"%s"' % s.replace('\\', '\\\\').replace('"', r'\"').replace('`', r'\`')
    if re.fullmatch(r"[A-Za-z0-9_./:=-]+", s):
        return s
    return "'%s'" % s.replace("'", "'\\''")


def parse_frontmatter(text: str, where: str):
    if not text.startswith("---\n"):
        die("error: missing frontmatter\n  --> %s" % where)
    end = text.find("\n---\n", 3)
    if end < 0:
        die("error: unterminated frontmatter\n  --> %s" % where)
    meta = {}
    for line in text[4:end].splitlines():
        if not line.strip():
            continue
        k, _, val = line.partition(":")
        meta[k.strip()] = val.strip()
    return meta, text[end + 5:]


def toml_str(s: str) -> str:
    """TOML basic string. JSON 이스케이프와 호환된다."""
    return json.dumps(s, ensure_ascii=False)


def agent_table(cfg: dict) -> str:
    """설정된 역할만으로 자산 표의 행을 만든다.

    표를 손으로 적으면 역할을 지운 뒤에도 이름이 남아, 만들어지지 않은 파일을 가리킨다.
    한 줄 설명은 어댑터 본문의 frontmatter `summary` 가 갖는다 — 설명과 본문이 같은 파일에 있다.
    """
    rows = []
    for name in sorted(cfg["roles"]):
        src = TEMPLATES / "agents" / ("%s.md" % name)
        meta = role_meta(name)
        if not meta:
            die("error: no adapter body for role `%s`\n  --> %s" % (name, src))
        if "summary" not in meta:
            die("error: frontmatter has no `summary`\n  --> %s" % src)
        rows.append("| `.claude/agents/%s.md` | %s |" % (name, meta["summary"]))
    return "\n".join(rows)


# 커맨드 파일 이름이 역할 이름과 같으면 그 역할 전용 커맨드다 — 역할을 지우면 함께 빠진다.
COMMANDS_DIR = TEMPLATES / "managed" / ".claude" / "commands"


def command_rows(cfg: dict) -> list:
    """설치되는 커맨드만으로 자산 표의 행을 만든다.

    손으로 적으면 역할을 지운 뒤에도 이름이 남아, 만들어지지 않은 파일을 가리킨다.
    한 줄 설명은 그 커맨드의 frontmatter `description` 이 갖는다.
    """
    rows = []
    for src in sorted(COMMANDS_DIR.glob("*.md")):
        name = src.stem
        if name not in cfg["roles"] and (TEMPLATES / "agents" / ("%s.md" % name)).is_file():
            continue   # 그 역할을 쓰지 않는다 — render 도 이 커맨드를 깔지 않는다
        meta, _ = parse_frontmatter(src.read_text(encoding="utf-8"), str(src))
        if "summary" not in meta:
            die("error: frontmatter has no `summary`\n  --> %s" % src)
        rows.append("| `.claude/commands/%s.md` | %s |" % (name, meta["summary"]))
    for wf, body in sorted(cfg["workflows"].items()):   # 이 프로젝트가 만든 절차의 커맨드
        if fragment(wf, "_head") is None:
            rows.append("| `.claude/commands/%s.md` | `/%s <이슈번호>` — %s |" % (wf, wf, body.get("title") or wf))
    return rows


def role_notes(target, name: str, where: str = None) -> str:
    """그 역할(또는 절차)에 이 프로젝트가 더한 지시. 머리 안내 주석은 사람에게 하는 말이라 뺀다."""
    p = target / (where or ROLE_NOTES) / ("%s.md" % name) if target else None
    return LEAD_COMMENT.sub("", p.read_text(encoding="utf-8")).strip() if p and p.is_file() else ""


def agent_files(cfg: dict, v: dict, target: Path = None) -> list:
    """역할 어댑터. 본문은 하네스가 갖고 frontmatter 는 설정에서 나온다."""
    out = []
    for name in sorted(cfg["roles"]):
        role = dict(cfg["roles"][name], model=role_model(cfg, name))   # 어댑터에는 실제로 쓰는 모델을 적는다
        src = TEMPLATES / "agents" / ("%s.md" % name)
        meta = role_meta(name)
        if not meta:
            die("error: no adapter body for role `%s`\n  --> %s" % (name, src))
        body = meta["body"]
        if "description" not in meta:
            die("error: frontmatter has no `description`\n  --> %s" % src)
        body = substitute(body, v, str(src)).strip() + "\n"
        extra = role_notes(target, name)
        if extra:
            body += "\n## 이 프로젝트에서\n\n%s\n" % extra
        if "'''" in body:
            die("error: body contains \'\'\' — the TOML copy cannot be generated\n  --> %s" % src)

        # 어댑터 형식을 가진 벤더마다 하나씩. 오케스트레이터를 바꿔도 파일이 오가지 않는다
        for v in VENDORS.values():
            if v.get("adapter"):
                out.append(ADAPTERS[v["adapter"]](name, meta, body, role))
    return out


def _sandbox(role: dict) -> str:
    return "read-only" if role["access"] == "read-only" else "workspace-write"


def claude_md(name: str, meta: dict, body: str, role: dict):
    fm = ["---", "name: %s" % name, "description: %s" % meta["description"],
          "tools: %s" % ", ".join(tools_of(role))]
    if role.get("model"):
        fm.append("model: %s" % role["model"])
    fm += ["codex_sandbox_mode: %s" % _sandbox(role), "---", ""]
    return (".claude/agents/%s.md" % name, "\n".join(fm) + "\n" + body, 0o644)


def codex_toml(name: str, meta: dict, body: str, role: dict):
    toml = ["name = %s" % toml_str(name), "description = %s" % toml_str(meta["description"]),
            "sandbox_mode = %s" % toml_str(_sandbox(role))]
    if role.get("model"):
        toml.append("model = %s" % toml_str(role["model"]))
    toml.append("developer_instructions = '''\n%s'''" % body)
    return (".codex/agents/%s.toml" % name, "\n".join(toml) + "\n", 0o644)


# 벤더 선언의 `adapter` 가 이 이름 중 하나를 고른다. 새 형식의 벤더가 오면 렌더러 하나를 더한다
ADAPTERS = {"claude-md": claude_md, "codex-toml": codex_toml}


def forge_doc(cfg: dict, v: dict) -> str:
    """`.ai/forge.md` — 사람과 에이전트가 읽는 forge 명령 사전.

    **손으로 쓰지 않는다.** 손으로 쓴 사전은 실제 어댑터와 갈라져, 없는 플래그를 적은 채
    남는다. 트래커와 리뷰 호스트가 다른 forge 여도 각자의 절이 제 자리에서 나온다.
    """
    f = cfg["forge"]
    parts = [substitute((TEMPLATES / "forge" / "forge.md").read_text(encoding="utf-8"),
                        v, "forge.md")]
    for kind, frag in ((f["tracker"], "tracker.md"), (f["review_host"], "review.md")):
        src = TEMPLATES / "forge" / kind / frag
        if not src.is_file():
            die("error: no command reference for this forge\n  --> %s\n\nhelp: check [forge] in harness.toml" % src)
        parts.append(substitute(src.read_text(encoding="utf-8"), v, str(src)))
    return "\n".join(p.strip() for p in parts) + "\n"


def adr_files(cfg: dict, v: dict) -> list:
    """ADR 스타일별 문서 세트. 스타일이 정하는 것은 문서뿐이고 절차는 바뀌지 않는다."""
    style, tool, d = cfg["adr"]["style"], cfg["adr"]["tool"], cfg["adr"]["dir"]
    base = TEMPLATES / "adr" / style
    if not base.is_dir():
        die("error: unknown adr.style `%s` (available: %s)"
            % (style, ", ".join(sorted(p.name for p in (TEMPLATES / "adr").iterdir()))))
    if style == "nygard" and tool not in ("adr-tools", "manual", "none"):
        die("error: adr.style = nygard supports adr.tool adr-tools, manual or none (got %r)" % tool)
    if style == "madr" and tool == "adr-tools":
        die("error: adr.tool = adr-tools cannot be used with adr.style = madr\n"
            "\n"
            "  adr-tools locates status and supersede links by the `## Status` heading,\n"
            "  which MADR does not have — it would silently do nothing.\n"
            "\n"
            "help: use the manual procedure with MADR\n"
            "        harness set adr.tool manual")

    out = [(".ai/adr.md", substitute((base / "adr.md").read_text(encoding="utf-8"),
                                     v, str(base / "adr.md")), 0o644)]
    if style == "none":
        return out
    out.append(("%s/README.md" % d,
                substitute((base / "README.md").read_text(encoding="utf-8"),
                           v, str(base / "README.md")), 0o644))
    tpl = base / "template.md"
    if tpl.is_file():
        out.append(("%s/templates/template.md" % d,
                    substitute(tpl.read_text(encoding="utf-8"), v, str(tpl)), 0o644))
    if tool == "adr-tools":
        # adr-tools 가 대상 디렉터리를 이 파일 하나로 읽는다.
        out.append((".adr-dir", d + "\n", 0o644))
    return out


# ─────────────────────────────────────────────────────────────────────────────
# 절차 — `workflows.<이름>.steps` 를 이어 `.ai/workflows/<이름>.md` 를 만든다
# ─────────────────────────────────────────────────────────────────────────────
#
# 단계 하나는 종류·제목과 본문이다. 본문은 `templates/workflows/<이름>/<id>.md` 조각이 있으면
# 그것이고, 없으면 종류에서 만든다. 번호는 순서에서 나온다 — 조각은 다른 단계를 번호가 아니라
# `{{step:<id>}}` 로 가리키므로, 순서를 바꿔도 참조가 따라가고 가리킨 단계를 빼면 렌더가 막힌다.

WORKFLOWS = TEMPLATES / "workflows"
STEP_KINDS = ("agent", "script", "prompt", "gate")
STEP_REF = re.compile(r"\{\{step:([a-z0-9-]+)\}\}")
# 기본 절차가 부르는 역할 이름. 어댑터의 위임표가 이 표현으로 서브에이전트를 찾는다.
# 여기 없는 역할은 키를 그대로 쓴다 — 어댑터가 "`<역할>` 역할" 을 그 이름의 서브에이전트로 읽는다.
ROLE_LABEL = {"requirement-analyzer": "요구사항 검토자", "spec-writer": "명세 작성자",
              "planner": "작업 분해자", "developer": "구현자"}


def default_workflows() -> dict:
    """하네스가 싣고 온 기본 설정의 절차. 설치본은 `.harness/templates/harness.toml` 로 들고 간다."""
    if not DEFAULT_CONFIG.is_file():
        return {}
    with DEFAULT_CONFIG.open("rb") as f:
        return tomllib.load(f).get("workflows", {})


def fragment(wf: str, name: str):
    p = WORKFLOWS / wf / ("%s.md" % name)
    return p.read_text(encoding="utf-8") if p.is_file() else None


def validate_workflows(cfg: dict):
    known = sorted(p.name for p in WORKFLOWS.iterdir() if p.is_dir()) if WORKFLOWS.is_dir() else []
    for wf, body in cfg["workflows"].items():
        where = "workflows.%s" % wf
        if wf not in known:
            # 이 프로젝트가 만든 절차. 머리글과 커맨드는 render 가 설정에서 만든다
            if not re.fullmatch(r"[a-z][a-z0-9-]{1,30}", wf):
                die("error: %s — a workflow name is lowercase letters, digits and dashes (2–31 chars)" % where)
            taken = {p.stem for p in COMMANDS_DIR.glob("*.md")} | set(cfg["roles"])
            if wf in taken:
                die("error: %s — `%s` is already a command or a role name" % (where, wf))
        steps = body.get("steps") or []
        if not steps:
            die("error: %s.steps is empty — a workflow needs at least one step" % where)
        seen = set()
        for i, st in enumerate(steps):
            at = "%s.steps[%d]" % (where, i)
            sid = st.get("id", "")
            if not re.fullmatch(r"[a-z0-9-]+", sid):
                die("error: %s.id must be lowercase letters, digits and dashes (got %r)" % (at, sid))
            if sid in seen:
                die("error: %s.id %r appears twice in %s" % (at, sid, where))
            seen.add(sid)
            kind = st.get("type")
            if kind not in STEP_KINDS:
                die("error: %s.type must be one of %s (got %r)" % (at, ", ".join(STEP_KINDS), kind))
            if not st.get("title", "").strip():
                die("error: %s.title is empty" % at)
            own = fragment(wf, sid) is not None
            if kind == "agent":
                role = st.get("role", "")
                if role not in cfg["roles"]:
                    die("error: %s.role %r is not a configured role (have: %s)"
                        % (at, role, ", ".join(sorted(cfg["roles"]))))
                # 전용 스크립트가 있는 CLI 러너 역할은 그 스크립트를 부른다(리뷰 → review-mr.sh). 입력이 이슈가 아니다
                entry = role_meta(role).get("entry", "")
                if cfg["roles"][role]["runner"] != "inproc" and entry:
                    die("error: %s delegates to %s, which runs through a script (runner = %s)\n\n"
                        "help: call the script that runs it with a script step instead\n"
                        "        { type = \"script\", run = \"%s\", ... }"
                        % (at, role, cfg["roles"][role]["runner"], entry))
            if kind == "script" and not st.get("run", "").strip():
                die("error: %s is a script step without `run`" % at)
            if kind == "prompt" and not own and not st.get("text", "").strip():
                die("error: %s is a prompt step without `text` — say what the orchestrator does" % at)


def step_heading(cfg: dict, st: dict) -> str:
    k, t = st["type"], st["title"]
    if k == "agent" and cfg["roles"][st["role"]]["runner"] != "inproc":
        return "%s — %s 역할을 %s 로 실행" % (t, ROLE_LABEL.get(st["role"], "`%s`" % st["role"]),
                                          VENDORS[cfg["roles"][st["role"]]["runner"]]["name"])
    if k == "agent":
        return "%s — %s 역할에 위임" % (t, ROLE_LABEL.get(st["role"], "`%s`" % st["role"]))
    if k == "script":
        return "%s — `%s`" % (t, st["run"])
    if k == "gate":
        return "%s (사람)" % t
    return t


def step_body(cfg: dict, wf: str, st: dict) -> str:
    extra = st.get("text", "").strip()
    own = fragment(wf, st["id"])
    k = st["type"]
    if k == "agent" and cfg["roles"][st["role"]]["runner"] != "inproc":
        r = st["role"]
        lead = ("```bash\n%s %s <이슈번호>\n```\n\n이 역할은 서브에이전트가 아니라 %s 로 따로 돈다"
                "(`roles.%s.runner`). 그 CLI 는 리포와 `.ai/templates/%s.md` 계약을 직접 읽는다 — 앞 단계의 결과는 "
                "리포에 남긴 것만 전해진다. **종료 코드가 0 이 아니면 다음 단계로 가지 않는다.** 출력을 그대로 보고하고 멈춘다."
                % (RUN_AGENT, r, VENDORS[cfg["roles"][r]["runner"]]["name"], r, r))
        rest = (own or "").strip("\n")
        return "\n" + "\n\n".join(x for x in (lead, rest, extra) if x) + "\n\n"
    if own is not None:
        return own if not extra else own.rstrip("\n") + "\n\n" + extra + "\n\n"
    if k == "agent":
        lead = ("`.ai/templates/%s.md` 계약을 따르는 역할이다. 이슈 번호와 앞 단계의 결과를 넘긴다."
                % st["role"])
    elif k == "script":
        lead = ("```bash\n%s\n```\n\n**종료 코드가 0 이 아니면 다음 단계로 가지 않는다.** "
                "출력을 그대로 보고하고 멈춘다." % st["run"])
    elif k == "gate":
        lead = "**여기서 멈추고 사용자에게 올린다.** 사용자가 답하기 전에는 다음 단계로 가지 않는다."
    else:
        lead = ""
    return "\n" + "\n\n".join(x for x in (lead, extra) if x) + "\n\n"


def custom_head(wf: str, title: str) -> str:
    return ("# %s — %s\n\n하네스 설정(`workflows.%s`)에서 만든 절차다. 단계의 순서와 내용은 그 설정이 정한다.\n\n"
            "## 입력\n\n이슈 번호 하나. 없으면 진행하지 않고 번호를 요구한다.\n\n## 절차\n\n" % (wf, title, wf))


def custom_command(wf: str, title: str) -> str:
    """이 프로젝트가 만든 절차의 Claude Code 커맨드. 절차를 복사하지 않고 정본을 가리킨다."""
    return ("---\ndescription: %s. 절차 정본은 .ai/workflows/%s.md 다.\nsummary: `/%s <이슈번호>` — %s\n"
            "argument-hint: <이슈번호>\ndisable-model-invocation: true\n---\n\n"
            "> **명시 호출 전용.** 사용자가 직접 부른 턴에서만 돈다.\n\n"
            "**절차 정본은 `.ai/workflows/%s.md` 다. 먼저 읽고 그대로 따른다.**\n"
            "이 파일에 절차를 복사하지 않는다 — 복사본은 정본 개정을 따라가지 못한다.\n\n"
            "대상 이슈: **$1**\n\n`$1` 이 비어 있으면 아무것도 하지 말고 이슈 번호를 요구한다.\n\n"
            "정본이 \"`<역할>` 역할에 위임\" 이라고 한 지점은 그 이름의 서브에이전트를 부른다.\n"
            "사람에게 올리라고 한 지점(사람 게이트)은 위임하지 않고 이 커맨드가 직접 묻는다.\n"
            % (title, wf, wf, title, wf))


def workflow_doc(cfg: dict, wf: str, target: Path = None) -> str:
    steps = cfg["workflows"][wf]["steps"]
    head = fragment(wf, "_head")
    if head is None:   # 이 프로젝트가 만든 절차. 제목은 선택이다 — 없으면 이름을 쓴다
        head = custom_head(wf, cfg["workflows"][wf].get("title") or wf)
    num = {st["id"]: str(i + 1) for i, st in enumerate(steps)}
    # 실행 지표가 켜져 있으면 단계마다 시작 표지를 한 번 남기게 한다 — 세션 토큰을 단계로 나누는 기준이다
    mark = (lambda st: "\n> 시작 표지: `script/metric.py step %s %s` 를 한 번 실행한다(실행 지표 — 결과와 무관하다)\n"
            % (wf, st["id"])) if cfg["metrics"]["dir"] != "off" else (lambda st: "")
    text = head + "".join(
        "### %d. %s\n%s%s" % (i + 1, step_heading(cfg, st), mark(st), step_body(cfg, wf, st)) for i, st in enumerate(steps)
    ) + (fragment(wf, "_tail") or "")
    extra = role_notes(target, wf, WORKFLOW_NOTES)
    if extra:
        text = text.rstrip("\n") + "\n\n## 이 프로젝트에서\n\n%s\n" % extra

    def ref(m):
        if m.group(1) not in num:
            die("error: workflows.%s no longer has step %r, but the procedure still refers to it\n\n"
                "  Another step (or the fixed text around the steps) points at it by number,\n"
                "  so removing it would leave that reference dangling.\n\n"
                "help: put the step back, or keep the steps that depend on it out as well"
                % (wf, m.group(1)))
        return num[m.group(1)]
    return substitute(STEP_REF.sub(ref, text), derive(cfg), "workflows.%s" % wf)


# forge 별 이슈 템플릿 — (설정의 라벨 키, 양식, GitHub 머리의 name, about)
ISSUE_FORMS = (("requirement", "issue-requirement.md", "Requirement", "요구사항 이슈 — 브랜치 하나·리뷰 요청 하나의 단위"),
               ("task", "issue-task.md", "Task", "단독 task 이슈. 분해의 task 는 sync-task-issues.sh 가 만든다"))


FORGE_TEMPLATE_DIRS = (".github/ISSUE_TEMPLATE/", ".gitlab/issue_templates/", ".gitlab/merge_request_templates/")


def forge_template_path(rel: str) -> bool:
    """forge 가 읽는 이슈·리뷰 요청 템플릿 자리인가."""
    return rel.startswith(FORGE_TEMPLATE_DIRS) or rel == ".github/pull_request_template.md"


def forge_templates(cfg: dict, at: Path = None) -> list:
    """forge 가 읽는 이슈·리뷰 요청 템플릿. 본문은 `.ai/templates/` 양식 그대로이고 forge 가 읽는 머리·꼬리만 더한다.

    forge 는 리포 루트의 템플릿만 읽으므로, 하네스 루트가 작업 트리 최상위가 아닌 서브프로젝트면 만들지 않는다.
    `forge.templates` 가 거짓이어도 만들지 않는다 — 지난 렌더가 만든 것은 정리가 지운다.
    """
    if not cfg["forge"]["templates"] or (at is not None and repo_prefix(at)):
        return []
    forms = TEMPLATES / "managed" / ".ai" / "templates"
    labels = cfg["issues"]["labels"]
    tracker, host = cfg["forge"]["tracker"], cfg["forge"]["review_host"]
    out = []
    for key, src, name, about in ISSUE_FORMS:
        body = (forms / src).read_text(encoding="utf-8")
        label = labels.get(key, "")
        if tracker == "github":
            head = "---\nname: %s\nabout: %s\ntitle: \"\"\nlabels: [%s]\n---\n\n" % (
                name, about, json.dumps(label, ensure_ascii=False) if label else "")
            out.append((".github/ISSUE_TEMPLATE/%s.md" % key, head + body, 0o644))
        elif tracker == "gitlab":
            tail = ("" if body.endswith("\n") else "\n") + "\n/label ~\"%s\"\n" % label if label else ""
            out.append((".gitlab/issue_templates/%s.md" % name, body + tail, 0o644))
    mr = (forms / "mr.md").read_text(encoding="utf-8")
    if host == "github":
        out.append((".github/pull_request_template.md", mr, 0o644))
    elif host == "gitlab":
        out.append((".gitlab/merge_request_templates/Default.md", mr, 0o644))
    return out


POST_COMMIT_HOOK = "script/githooks/post-commit"   # verify.post_commit 이 켜질 때만 생성한다
# verify.pre_push 가 켜지면 pre-push 훅 끝에 들어가는 줄. 리뷰어와 CI 가 받는 리비전을 push 전에 검증한다
PRE_PUSH_VERIFY = r"""
# push 전 검증 — on = "push" 단계까지 전부. 통과 기록이 있는 단계는 건너뛴다(verify.incremental).
# 검증은 작업 트리를 본다. 그래서 push 하는 리비전이 체크아웃한 HEAD 이고 작업 트리가 그것과 같을 때만 통과시킨다
refuse() {
  [ -n "$root" ] && "$root/script/usage-log.sh" block pre-push verify >/dev/null 2>&1
  echo "blocked: $1" >&2
  echo "  $2" >&2
  exit 1
}
[ -n "$root" ] && [ -x "$root/script/run-lint-test.sh" ] ||
  refuse "verify.pre_push is on but script/run-lint-test.sh is missing" "help: harness render"
head=$(git rev-parse HEAD)
for sha in $pushed; do
  case "$sha" in   # 지우는 ref(모두 0)는 보지 않는다. 주석 태그는 가리키는 커밋으로 푼다
    *[!0]*) [ "$(git rev-parse -q --verify "$sha^{commit}" 2>/dev/null)" = "$head" ] ||
              refuse "this push sends a revision other than the checked-out HEAD, which verification cannot see" \
                "help: check out that branch, then push" ;;
  esac
done
clean() { [ -z "$(git status --porcelain)" ]; }
clean || refuse "the working tree has uncommitted changes — verification would check them, not what is pushed" \
  "help: commit or stash them, then push again"
"$root/script/run-lint-test.sh" </dev/null || refuse "verification failed" "help: fix it, commit, then push again"
# 검증이 작업 트리를 고쳤으면 통과한 것은 push 하는 HEAD 가 아니다
clean || refuse "verification changed the working tree, so what passed is not what is pushed" \
  "help: commit what it changed (or make that step stop writing to tracked files), then push again"
"""


def plan(cfg: dict, target: Path = None, at: Path = None) -> list:
    """생성되는 파일 전부. (경로, 내용, 권한)

    at 은 본문 없이 경로만 셀 때의 하네스 루트다 — 리포 안의 위치에 따라 생기는 파일이 있다.
    """
    v = derive(cfg)
    out = []

    gen = TEMPLATES / "generated"
    for src in sorted(gen.rglob("*")):
        if not src.is_file():
            continue
        rel = src.relative_to(gen).as_posix()
        if rel == POST_COMMIT_HOOK and not cfg["verify"]["post_commit"]:
            continue
        text = src.read_text(encoding="utf-8")
        mode = 0o755 if os.access(src, os.X_OK) else 0o644
        out.append((rel, substitute(text, dict(v, PROJECT_COMMANDS=commands_doc(cfg, target),
                                               PRE_PUSH_VERIFY=PRE_PUSH_VERIFY * cfg["verify"]["pre_push"]),
                                    str(src), target), mode))

    out.append(("script/harness.env", harness_env(v), 0o644))
    out.append((VERIFY_SCRIPT, verify_script(cfg), 0o755))
    out.append(("script/harness.plan.json", json.dumps(run_plan(cfg), ensure_ascii=False, indent=2) + "\n", 0o644))
    out.append((".claude/settings.json", settings_json(cfg), 0o644))
    out.append((".ai/forge.md", forge_doc(cfg, v), 0o644))
    out += adr_files(cfg, v)
    out += agent_files(cfg, v, target)
    out += [(".claude/commands/%s.md" % wf, custom_command(wf, body.get("title") or wf), 0o644)
            for wf, body in sorted(cfg["workflows"].items()) if fragment(wf, "_head") is None]
    out += [(".ai/workflows/%s.md" % wf, workflow_doc(cfg, wf, target), 0o644) for wf in sorted(cfg["workflows"])]
    out += forge_templates(cfg, target if target is not None else at)
    return sorted(out)


# 하네스가 대상 리포를 바꾸는 경로의 규칙. 하네스 루트 기준 상대 경로이고, 성분은 `docs.protected` 의
# 성분(PROTECTED_PATH)과 같은 문자 집합이며, `.` · `..` · 빈 성분이 없고, 루트 아래의 성분에 심볼릭 링크가 없다.
PATH_COMPONENT = re.compile(r"[\w.-]+")
GUARD_VERBS = ("create", "write", "remove", "move")


def path_form_fault(rel: str):
    """경로 문자열의 형식 어긋남 사유. 맞으면 None. 파일 시스템을 보지 않는다."""
    if rel.startswith("/"):
        return "an absolute path"
    parts = rel.split("/")
    if ".." in parts:
        return "has a .. component"
    if any(p == "." or not PATH_COMPONENT.fullmatch(p) for p in parts):
        return "not a path"
    return None


def link_component(root: Path, rel: str):
    """root 아래 rel 의 성분(`a` · `a/b` · … · rel 자신) 가운데 심볼릭 링크인 첫 것. 없으면 None.

    링크 대상이 있는지와 상관없다. root 자신과 그 위는 보지 않는다. 아직 없는 성분은 어긋남이 아니다.
    """
    parts = rel.split("/")
    for i in range(1, len(parts) + 1):
        head = "/".join(parts[:i])
        p = root / head
        if os.path.islink(p):
            return head
        if not os.path.lexists(p):
            return None
    return None


def path_fault(root: Path, rel: str):
    """경로 규칙의 어긋남 — (사유, 링크인 성분 또는 None). 맞으면 None."""
    why = path_form_fault(rel)
    if why:
        return why, None
    hit = link_component(root, rel)
    if hit is not None:
        return "through a symbolic link", hit
    return None


def guarded_path(root: Path, rel: str, verb: str) -> Path:
    """경로 규칙을 지키는 경로만 돌려준다. 대상 리포를 바꾸는 시스템 호출은 전부 이 함수가 돌려준 경로에 한다.

    호출 바로 앞에서 판정한다 — 사전 판정이 통과시킨 경로도 다시 본다. 어긋나면 아무것도 하지 않고 종료 코드 2.
    형식이 어긋난 경로는 출력하지 않는다.
    """
    assert verb in GUARD_VERBS, verb
    fault = path_fault(root, rel)
    if fault is None:
        return root / rel
    why, hit = fault
    if hit is not None:
        die("error: refusing to %s through a symbolic link\n  --> %s\n\n"
            "help: replace the link with the directory or file it points to, then run the command again" % (verb, hit))
    die("error: refusing to %s a path that is not safe under the harness root (%s)" % (verb, why))


def make_dirs(root: Path, rel_dir: str):
    """rel_dir 까지의 디렉터리를 위에서부터 하나씩 공용 함수를 거쳐 만든다."""
    parts = rel_dir.split("/") if rel_dir else []
    for i in range(1, len(parts) + 1):
        p = guarded_path(root, "/".join(parts[:i]), "create")
        if not p.is_dir():
            p.mkdir()


def make_parents(root: Path, rel: str):
    if "/" in rel:
        make_dirs(root, rel.rsplit("/", 1)[0])


def copy_tree(src: Path, dst: Path, only_if_absent: bool, skip=None, subst=None):
    """관리 파일은 덮어쓰고, 소유 파일은 없을 때만 깐다. (바뀐 수, 깐 경로 전부)

    dst 는 하네스 루트다 — 쓰는 경로는 공용 함수를 거친다.
    """
    n, paths = 0, []
    if not src.is_dir():
        return 0, []
    for f in sorted(src.rglob("*")):
        if not f.is_file():
            continue
        rel = f.relative_to(src).as_posix()
        if skip and skip(rel):
            continue
        paths.append(rel)
        if only_if_absent and os.path.lexists(dst / rel):
            continue
        make_parents(dst, rel)
        text = f.read_text(encoding="utf-8")
        if subst is not None:
            text = substitute(text, subst, str(f))
        out = guarded_path(dst, rel, "write")
        if out.is_file() and out.read_text(encoding="utf-8") == text:
            continue
        guarded_path(dst, rel, "write").write_text(text, encoding="utf-8")
        os.chmod(guarded_path(dst, rel, "write"), 0o755 if os.access(f, os.X_OK) else 0o644)
        n += 1
    return n, paths


# ─────────────────────────────────────────────────────────────────────────────
# 명령
# ─────────────────────────────────────────────────────────────────────────────

# 지난 render 가 무엇을 깔았는지. 설정이 바뀌어 더는 만들지 않는 파일을 지우는 근거이고,
# 제거할 때 무엇이 하네스 것이고 무엇이 프로젝트 것인지 가르는 근거다.
MANIFEST = ".harness/generated"
MANIFEST_MANAGED = ".harness/managed"


# `.harness/managed` 의 한 줄 — `sha256sum` 출력과 같은 `<sha256>  <경로>`. 맞지 않는 줄은 경로만 적던 옛 형식이다.
MANIFEST_LINE = re.compile(r"([0-9a-f]{64})  (.+)")
PINNED = ".harness/"


# 병합이 남긴 충돌 표지로 시작하는 줄
CONFLICT_MARKERS = ("<<<<<<<", "|||||||", "=======", ">>>>>>>")


def read_manifest(target: Path, name: str):
    """매니페스트를 신뢰하지 않는 입력으로 읽는다 — ((경로, sha256 또는 None) 목록, (매니페스트, 줄 번호, 사유) 목록).

    줄마다 끝의 CR 하나를 떼고 경로를 뽑아 경로 규칙의 형식으로 판정한다. 파일 시스템은 보지 않는다.
    빈 줄(공백뿐인 줄 포함)은 건너뛴다. 어긋난 줄은 경로 목록에 넣지 않는다. 매니페스트가 없으면 둘 다 빈 목록.
    """
    p = target / name
    if not p.is_file():
        return [], []
    entries, faults = [], []
    lines = p.read_bytes().decode("utf-8", errors="replace").split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    for n, ln in enumerate(lines, 1):
        if ln.endswith("\r"):
            ln = ln[:-1]
        if not ln.strip():
            continue
        if ln.startswith(CONFLICT_MARKERS):
            faults.append((name, n, "a merge conflict marker"))
            continue
        m = MANIFEST_LINE.fullmatch(ln)
        rel, h = (m.group(2), m.group(1)) if m else (ln.strip(), None)
        why = path_form_fault(rel)
        if why:
            faults.append((name, n, why))
        else:
            entries.append((rel, h))
    return entries, faults


def manifest_entries(target: Path, name: str = MANIFEST_MANAGED) -> list:
    """매니페스트의 (경로, sha256) 짝 가운데 형식 검증을 거친 것. 옛 형식 줄의 해시는 None 이다."""
    return read_manifest(target, name)[0]


def previous(target: Path, name: str = MANIFEST) -> list:
    return [rel for rel, _h in manifest_entries(target, name)]


def manifest_faults(target: Path) -> list:
    """두 매니페스트에서 경로 규칙의 형식에 어긋난 줄 — 매니페스트 이름 순 · 줄 번호 순."""
    return sorted(f for name in (MANIFEST, MANIFEST_MANAGED) for f in read_manifest(target, name)[1])


MANIFEST_CONFLICT_HELP = ("      a merge left conflict markers in it — keep the lines of both sides, delete the marker lines,\n"
                          "      then let the harness rewrite it\n"
                          "        harness install")


def refuse_unsafe_manifest(target: Path, command: str) -> bool:
    """매니페스트에 경로 규칙에 어긋난 줄이 있으면 안내문을 표준 오류로 내고 True. 줄의 내용은 출력하지 않는다."""
    faults = manifest_faults(target)
    if not faults:
        return False
    print("error: the harness manifest has %d line(s) that are not safe paths under the harness root" % len(faults),
          file=sys.stderr)
    for name, n, why in faults:
        print("  --> %s:%d (%s)" % (name, n, why), file=sys.stderr)
    print("nothing was changed\n\n"
          "help: the manifest lists only files the harness wrote, as paths under the harness root\n"
          "      fix or delete those lines, then run the command again\n"
          "        harness %s" % command, file=sys.stderr)
    if any(why == "a merge conflict marker" for _n, _l, why in faults):
        print(MANIFEST_CONFLICT_HELP, file=sys.stderr)
    return True


def sha256_of(p: Path) -> str:
    return hashlib.sha256(p.read_bytes()).hexdigest()


def write_manifest_hashes(target: Path, entries: dict):
    """`.harness/managed` 를 경로 순의 `<sha256>  <경로>` 줄로 쓴다. 해시가 None 인 경로는 옛 형식 그대로 경로만 쓴다."""
    make_parents(target, MANIFEST_MANAGED)
    guarded_path(target, MANIFEST_MANAGED, "write").write_text(
        "".join(("%s  %s\n" % (entries[rel], rel)) if entries[rel] else rel + "\n" for rel in sorted(entries)),
        encoding="utf-8")


def pinned_files(root: Path) -> list:
    """고정 사본의 파일 — `bin/` · `templates/` 아래 전부와 `VERSION`. `__pycache__/` 는 뺀다. root 기준 경로."""
    out = []
    for d in ("bin", "templates"):
        for f in sorted((root / d).rglob("*")):
            if f.is_file() and "__pycache__" not in f.relative_to(root).parts:
                out.append(f.relative_to(root).as_posix())
    if (root / "VERSION").is_file():
        out.append("VERSION")
    return out


def prune(target: Path, keep: set, manifest: str) -> int:
    """직전에 깔았으나 이번에는 만들지 않는 파일을 지운다. 빈 디렉터리도 함께 걷는다.

    고정 사본(`.harness/`)은 install 의 것이라 지우지 않는다.
    """
    n = 0
    for rel in previous(target, manifest):
        if rel in keep or rel.startswith(PINNED):
            continue
        stale = guarded_path(target, rel, "remove")
        if stale.is_file():
            guarded_path(target, rel, "remove").unlink()
            n += 1
            parts = rel.split("/")[:-1]
            while parts:
                d = guarded_path(target, "/".join(parts), "remove")
                if any(d.iterdir()):
                    break
                d.rmdir()
                parts.pop()
    return n


def ci_dir(cfg: dict) -> Path:
    return TEMPLATES / "ci" / cfg["forge"]["review_host"]


def role_file_skip(cfg: dict):
    """쓰지 않는 역할의 계약과 그 역할만 부르는 커맨드를 가르는 함수. 깔아 두면 설정에 없는 역할을 가리키는 문서가 남는다."""
    known = {f.stem for f in (TEMPLATES / "agents").glob("*.md")}
    unused = known - set(cfg["roles"])

    def role_file_unused(rel):
        for pre in (".ai/templates/", ".claude/commands/"):
            if rel.startswith(pre) and rel.endswith(".md") \
               and rel[len(pre):-len(".md")] in unused:
                return True
        return False
    return role_file_unused


def harness_paths(cfg: dict, at: Path = None) -> set:
    """이번 render 가 쓸 관리 파일과 생성 파일의 경로. 소유 파일과 CI 골격은 없을 때만 까므로 들지 않는다."""
    skip = role_file_skip(cfg)
    src = TEMPLATES / "managed"
    out = {f.relative_to(src).as_posix() for f in src.rglob("*") if f.is_file()}
    out = {rel for rel in out if not skip(rel)}
    return out | {rel for rel, _c, _m in plan(cfg, at=at)}


def seeded_paths(cfg: dict) -> set:
    """없을 때만 까는 소유 파일과 CI 골격의 경로. 사용자 파일 판정 대상은 아니지만 경로 규칙과 부모 디렉터리는 본다."""
    out = set()
    for src in (TEMPLATES / "owned", ci_dir(cfg)):
        if src.is_dir():
            out |= {f.relative_to(src).as_posix() for f in src.rglob("*") if f.is_file()}
    return out


def stale_paths(cfg: dict, target: Path) -> set:
    """정리(`prune`)가 지울 옛 경로 — 이전 매니페스트에 있으나 이번 render 가 쓰지 않는 것. 고정 사본은 정리하지 않는다."""
    writes = harness_paths(cfg, target)
    made = {rel for rel, _c, _m in plan(cfg, at=target)}
    prev_gen, prev_man = set(previous(target, MANIFEST)), set(previous(target, MANIFEST_MANAGED))
    return {rel for rel in (prev_gen - made) | (prev_man - writes) if not rel.startswith(PINNED)}


def adoptable(cfg: dict, target: Path) -> set:
    """`--adopt` 가 옮길 수 있는 후보 — 쓸 경로에 무엇이 있으나 이전 매니페스트에 없는 것."""
    ours = set(previous(target, MANIFEST)) | set(previous(target, MANIFEST_MANAGED))
    return {rel for rel in harness_paths(cfg, target) if rel not in ours and os.path.lexists(target / rel)}


def change_paths(cfg: dict, target: Path, adopt: bool = False) -> dict:
    """이번 render 가 바꿀 경로 전부 — {경로: 동사}. 관리 · 생성 · 소유 파일과 CI 골격, 매니페스트, 정리가 지울 옛 경로,
    `--adopt` 면 넘겨받을 경로와 `<경로>.orig`."""
    out = {rel: "write" for rel in harness_paths(cfg, target) | seeded_paths(cfg) | {MANIFEST, MANIFEST_MANAGED}}
    out.update((rel, "remove") for rel in stale_paths(cfg, target))
    if adopt:
        for rel in adoptable(cfg, target):
            out[rel] = out[rel + ".orig"] = "move"
    return out


def refuse_unsafe_paths(target: Path, paths: dict, command: str) -> bool:
    """바꿀 경로 가운데 경로 규칙을 어긴 것이 있으면 안내문을 표준 오류로 내고 True. 무엇도 바꾸기 전에 부른다.

    링크인 성분은 전부 모아 경로 순으로 낸다 — 한 링크 아래의 경로는 따로 나열하지 않는다.
    형식이 어긋난 경로는 출력하지 않는다.
    """
    links = set()
    for rel, verb in sorted(paths.items()):
        why = path_form_fault(rel)
        if why:
            print("error: refusing to %s a path that is not safe under the harness root (%s)\nnothing was changed"
                  % (verb, why), file=sys.stderr)
            return True
        hit = link_component(target, rel)
        if hit is not None:
            links.add(hit)
    if not links:
        return False
    print("error: %d path(s) the harness would change go through a symbolic link" % len(links), file=sys.stderr)
    for hit in sorted(links):
        print("  --> %s" % hit, file=sys.stderr)
    print("nothing was changed\n\n"
          "help: the harness does not write through symbolic links under the harness root\n"
          "      replace each link with the directory or file it points to, then run the command again\n"
          "        harness %s" % command, file=sys.stderr)
    return True


def user_files(cfg: dict, target: Path) -> list:
    """하네스가 쓰지 못하거나 덮어선 안 되는 경로 — (경로, 넘겨받을 수 없는 사유 또는 None).

    - 하네스가 쓸 경로에 이미 있으나 이전 매니페스트에 없는 것. 내용은 보지 않는다
    - 쓸 경로에 디렉터리가 있는 것. 매니페스트에 있어도 덮을 수 없다
    - 쓸 경로의 부모 가운데 디렉터리가 아닌 것. 소유 파일·CI 골격·매니페스트의 부모도 본다
    심볼릭 링크는 이 판정보다 먼저 도는 경로 규칙의 사전 판정이 막는다.
    """
    ours = set(previous(target, MANIFEST)) | set(previous(target, MANIFEST_MANAGED))
    writes = harness_paths(cfg, target)
    found = {}
    for rel in sorted(writes | seeded_paths(cfg) | {MANIFEST, MANIFEST_MANAGED}):
        parts = rel.split("/")
        for i in range(1, len(parts)):
            head = "/".join(parts[:i])
            if head in found:
                break
            q = target / head
            if os.path.lexists(q) and not q.is_dir():
                found[head] = "not a directory"
                break
    for rel in sorted(writes):
        p = target / rel
        if rel in found or any(rel.startswith(h + "/") for h in found) or not os.path.lexists(p):
            continue
        if p.is_dir():
            found[rel] = "a directory"
        elif rel in ours:
            continue
        elif os.path.lexists(str(p) + ".orig"):
            found[rel] = "%s.orig already exists" % rel
        else:
            found[rel] = None
    return sorted(found.items())


def refuse_user_files(cfg, target: Path, args) -> bool:
    """사용자 파일이 있어 멈춰야 하면 안내문을 표준 오류로 내고 True. `--adopt` 로 모두 넘겨받을 수 있으면 False."""
    found = user_files(cfg, target)
    if not found or (getattr(args, "adopt", False) and all(why is None for _r, why in found)):
        return False
    cmd = getattr(args, "command", None) or "render"
    print("error: %d file(s) the harness would write already exist and are not the harness's" % len(found),
          file=sys.stderr)
    for rel, why in found:
        print("  --> %s%s" % (rel, " (%s)" % why if why else ""), file=sys.stderr)
    print("nothing was written\n\n"
          "help: move them aside, or let the harness take them over (each is kept as <path>.orig)\n"
          "        harness %s --adopt" % cmd, file=sys.stderr)
    if any(rel.startswith("script/") for rel, _w in found):
        print("      project scripts belong in script/project/, which the harness never writes", file=sys.stderr)
    return True


def refuse_changes(cfg, target: Path, args, extra: dict = None) -> bool:
    """render 가 무엇이든 바꾸기 전의 판정 — 매니페스트 검증, 경로 규칙의 사전 판정, 사용자 파일 판정 순. 멈춰야 하면 안내문을 내고 True.

    extra 는 그 명령이 더 바꿀 경로다({경로: 동사}).
    """
    command = getattr(args, "command", None) or "render"
    if refuse_unsafe_manifest(target, command):
        return True
    paths = change_paths(cfg, target, getattr(args, "adopt", False))
    paths.update(extra or {})
    if refuse_unsafe_paths(target, paths, command):
        return True
    return refuse_user_files(cfg, target, args)


def adopt_user_files(cfg, target: Path):
    """사용자 파일을 `<경로>.orig` 로 옮긴다. 이름만 바꾸므로 권한 비트가 그대로다."""
    for rel, _why in user_files(cfg, target):
        os.rename(guarded_path(target, rel, "move"), guarded_path(target, rel + ".orig", "move"))
        print("render: adopted %s — yours is at %s.orig" % (rel, rel))


def cmd_render(cfg, target, args, migrate=True):
    # 옛 버전이 이름으로 남긴 기록이 이 루트의 것이면 렌더 전에 클론 키 아래로 옮긴다. install 은 자기 잠금 안에서 이미 옮겼다
    if migrate and legacy_dir(cfg, target) is not None:
        with registry_lock():
            migrate_legacy(cfg, target, "render")
    # 무엇이든 쓰기 전에 가른다 — 바꿀 경로가 링크를 거치거나, 하네스가 쓸 자리에 프로젝트 파일이 있으면 멈춘다.
    if refuse_changes(cfg, target, args):
        return 2
    if getattr(args, "adopt", False):
        adopt_user_files(cfg, target)
    # 소유 파일을 먼저 깐다 — 생성물이 그 본문을 포함할 수 있다.
    owned, _ = copy_tree(TEMPLATES / "owned", target, only_if_absent=True)
    # CI 설정은 **있으면 손대지 않는다.** 프로젝트가 이미 갖고 있던 파이프라인을 덮으면
    # 하네스 설치 한 번으로 빌드가 통째로 바뀐다. 없을 때만 최소 골격을 깐다.
    owned += copy_tree(ci_dir(cfg), target, only_if_absent=True, subst=derive(cfg))[0]
    role_file_unused = role_file_skip(cfg)

    managed, managed_paths = copy_tree(
        TEMPLATES / "managed", target, only_if_absent=False, skip=role_file_unused)

    items = plan(cfg, target)
    written = 0
    for rel, content, mode in items:
        make_parents(target, rel)
        p = guarded_path(target, rel, "write")
        old = p.read_text(encoding="utf-8") if p.is_file() else None
        if old != content:
            guarded_path(target, rel, "write").write_text(content, encoding="utf-8")
            written += 1
        os.chmod(guarded_path(target, rel, "write"), mode)

    # 설정이 바뀌면 만들던 파일이 빠진다. 남겨 두면 옛 forge 어댑터나 쓰지 않는 역할의 계약이
    # 리포에 그대로 있어, 사람도 에이전트도 어느 쪽이 현재인지 알 수 없다.
    made = {rel for rel, _c, _m in items}
    # forge 템플릿을 끄면 지난 렌더가 만든 것은 정리한다. 단 하네스가 만든 내용과 달라진 것(사내 양식으로 갈아 끼운 것)은
    # 리포의 파일이므로 지우지 않고 넘긴다 — 매니페스트에서 빠져 다음부터 사용자 파일이다
    # 지난 렌더가 만든 forge 템플릿을 이번에 만들지 않으면(끄거나 forge 를 바꾸면) 정리한다. 단 그때 기록한 해시와 내용이
    # 다른 것 — 손으로 바꾼 것 — 과 해시가 없어 확인할 수 없는 것은 지우지 않고 매니페스트에서만 빼 리포의 파일로 넘긴다.
    # 잘못 지우면 되돌릴 수 없고, 잘못 남기면 사람이 지우면 된다
    kept = set()
    for rel, h in manifest_entries(target, MANIFEST):
        p = target / rel
        if rel not in made and forge_template_path(rel) and p.is_file() and not p.is_symlink() and sha256_of(p) != h:
            kept.add(rel)
            print("render: %s is not what the harness last wrote — kept as the repository's own" % rel)
    removed = prune(target, made | kept, MANIFEST) + prune(target, set(managed_paths) | made | kept, MANIFEST_MANAGED)

    # 관리 파일의 해시는 이번에 깐 내용으로 계산한다. 고정 사본의 해시는 install 이 기록한 것을 옮긴다 —
    # 여기서 다시 계산하면 고친 사본의 해시가 기록된다. 사본이 없는 루트(소스 리포)는 사본 줄을 쓰지 않는다.
    hashes = {rel: sha256_of(target / rel) for rel in managed_paths}
    if (target / PINNED / "bin" / "harness").is_file():
        hashes.update((rel, h) for rel, h in manifest_entries(target)
                      if rel.startswith(PINNED) and h is not None)
    make_parents(target, MANIFEST)
    # forge 템플릿 줄에는 쓴 내용의 해시를 붙인다 — 나중에 끄거나 forge 를 바꿀 때 손으로 바꿨는지 가른다
    guarded_path(target, MANIFEST, "write").write_text(
        "".join(("%s  %s\n" % (sha256_of(target / rel), rel)) if forge_template_path(rel) else rel + "\n"
                for rel in sorted(made)), encoding="utf-8")
    write_manifest_hashes(target, hashes)

    for k in old_alias_keys(cfg):
        print("note: %s uses {project}, an old alias of {clone} — replace it with {clone} in harness.toml" % k, file=sys.stderr)
    print("render: %d generated (%d updated, %d removed) · %d managed updated · %d owned created"
          % (len(items), written, removed, managed, owned))
    return 0


def staged_text(target: Path, rel: str):
    r = subprocess.run(["git", "-C", str(target), "show", ":%s" % rel],
                       capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None


def drift(cfg, target, staged=False):
    """생성물과 설정의 어긋남 — (경로, 사유) 목록. staged 면 작업 트리 대신 인덱스와 비교한다."""
    bad = []
    items = plan(cfg, target)
    made = {rel for rel, _c, _m in items}
    for rel in previous(target):
        if rel not in made and (target / rel).is_file():
            bad.append((rel, "left over; the config no longer generates it"))
    for rel, content, _mode in items:
        if staged:
            actual = staged_text(target, rel)
        else:
            p = target / rel
            actual = p.read_text(encoding="utf-8") if p.is_file() else None
        if actual is None:
            bad.append((rel, "missing"))
        elif actual != content:
            bad.append((rel, "differs from the config"))
    return bad


def staged_bytes(target: Path, rel: str):
    r = subprocess.run(["git", "-C", str(target), "show", ":%s" % rel], capture_output=True)
    return r.stdout if r.returncode == 0 else None


def managed_drift(target: Path, staged=False):
    """관리 파일·고정 사본과 `.harness/managed` 의 대조 — ((경로, 사유) 목록, 비교한 줄 수).

    staged 면 작업 트리 대신 인덱스의 내용과 비교한다. 매니페스트 자신은 작업 트리에서 읽는다.
    해시가 없는 옛 형식 줄은 비교하지 않는다.
    """
    bad, n = [], 0
    for rel, h in manifest_entries(target):
        if h is None:
            continue
        n += 1
        if staged:
            data = staged_bytes(target, rel)
        else:
            p = target / rel
            data = p.read_bytes() if p.is_file() else None
        if data is None:
            bad.append((rel, "missing managed file"))
        elif hashlib.sha256(data).hexdigest() != h:
            bad.append((rel, "modified managed file"))
    return bad, n


def cmd_check(cfg, target, args):
    # 어긋난 매니페스트 줄은 그 경로를 읽지 않는다 — 대조는 검증을 거친 줄로만 한다
    faults = manifest_faults(target)
    bad = drift(cfg, target, staged=args.staged)
    mbad, compared = managed_drift(target, staged=args.staged)
    if faults:
        print("error: the harness manifest has line(s) that are not safe paths under the harness root", file=sys.stderr)
        for name, n, why in faults:
            print("  %-52s %s" % ("%s:%d" % (name, n), why), file=sys.stderr)
        print("\nhelp: the manifest lists only files the harness wrote, as paths under the harness root\n"
              "      fix or delete those lines", file=sys.stderr)
        if any(why == "a merge conflict marker" for _n, _l, why in faults):
            print(MANIFEST_CONFLICT_HELP, file=sys.stderr)
    if bad:
        print("%serror: generated files do not match the config%s"
              % ("\n" if faults else "", " (staged contents)" if args.staged else ""), file=sys.stderr)
        for rel, why in bad:
            print("  %-52s %s" % (rel, why), file=sys.stderr)
        print("\nhelp: regenerate them — never edit generated files by hand\n"
              "        harness render", file=sys.stderr)
    if mbad:
        print("%serror: managed files differ from what the harness installed%s"
              % ("\n" if bad or faults else "", " (staged contents)" if args.staged else ""), file=sys.stderr)
        for rel, why in mbad:
            print("  %-52s %s" % (rel, why), file=sys.stderr)
        print("\nhelp: managed files are the harness's — render puts them back\n"
              "        harness render\n"
              "      project scripts belong in script/project/", file=sys.stderr)
        if any(rel.startswith(PINNED) for rel, _w in mbad):
            print("      the pinned copy under .harness/ comes back with `harness install`", file=sys.stderr)
    if faults or bad or mbad:
        return 1
    print("check: %d generated files match the config" % len(plan(cfg, target)))
    print("check: %d managed files match the manifest" % compared)
    return 0


def cmd_forge_setup(_cfg, target, _args):
    """설정의 이슈 라벨을 트래커에 만든다. 원격 쓰기라 사람이 부른다 — 절차·훅·다른 명령은 부르지 않는다."""
    script = target / "script" / "forge-setup.sh"
    if not script.is_file():
        print("error: script/forge-setup.sh is missing\n\nhelp: put the managed scripts back\n        harness render",
              file=sys.stderr)
        return 2
    sys.stdout.flush()
    return subprocess.run(["bash", str(script)], cwd=str(target)).returncode


def cmd_vars(cfg, _target, _args):
    for k, val in sorted(derive(cfg).items()):
        print("%-24s %s" % (k, val))
    return 0


def seed_text(target: Path) -> str:
    """설정이 없는 대상에 깔 기본 설정 — 프로젝트 이름만 채운다."""
    return DEFAULT_CONFIG.read_text(encoding="utf-8").replace('name = "my-project"', 'name = "%s"' % target.name)


def seeded_config(target: Path) -> dict:
    """seed_config 가 깔 설정을 파일로 쓰지 않고 읽은 것."""
    cfg = tomllib.loads(seed_text(target))
    normalize(cfg)
    validate(cfg)
    return cfg


def seed_config(target: Path):
    """설정이 없는 대상에 기본 설정을 깔고 프로젝트 이름만 채운다."""
    dst = target / "harness.toml"
    if dst.exists():
        return
    # 대상이 없는 링크면 공용 함수가 멈춘다 — 따라 쓰면 링크가 가리키는 곳에 설정이 생긴다
    guarded_path(target, "harness.toml", "write").write_text(seed_text(target), encoding="utf-8")
    print("created %s — review the values, then run `harness render`" % dst)


# 설치된 클론의 목록. UI 가 `harness projects` 로 이것을 받아 프로젝트를 전환한다.
# 최상위의 키 모양(`c-` 와 16진 16자) 디렉터리가 클론 하나의 상태 디렉터리이고, 그 안의 project.json 이 등록이다.
# 그 밖의 디렉터리는 옛 버전이 이름으로 만든 디렉터리, 파일과 `.` 으로 시작하는 항목은 기기 단위 기록이다.
def registry() -> Path:
    return Path(os.environ.get("HARNESS_HOME") or Path.home() / ".harness")


def read_registration(d: Path):
    """등록 디렉터리 d 의 project.json — (이름, 경로). 파일이 없으면 None.
    읽히지 않거나 객체가 아니거나 값이 비어 있지 않은 문자열이 아니면 그 자리는 None 이다."""
    f = d / "project.json"
    if not os.path.isfile(f):
        return None
    try:
        data = json.loads(f.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        data = None
    if not isinstance(data, dict):
        return None, None
    name, path = data.get("name"), data.get("path")
    return (name if isinstance(name, str) and name else None), (path if isinstance(path, str) and path else None)


def registrations():
    """등록부의 등록 — (클론 등록, 옛 이름 등록). 항목은 {"key", "name", "path"}.

    클론 등록의 이름은 project.json 의 이름, 없으면 키다. 옛 이름 등록은 key 가 None 이고 이름이 디렉터리 이름이다.
    등록부를 바꾸지 않는다."""
    clones, legacy = [], []
    try:
        entries = sorted(os.scandir(registry()), key=lambda e: e.name)
    except OSError:
        return clones, legacy
    for e in entries:
        if e.name.startswith(".") or not os.path.isdir(e.path):
            continue
        reg = read_registration(Path(e.path))
        if reg is None:
            continue
        name, path = reg
        if CLONE_KEY.fullmatch(e.name):
            clones.append({"key": e.name, "name": name or e.name, "path": path})
        else:
            legacy.append({"key": None, "name": e.name, "path": path})
    return clones, legacy


@contextlib.contextmanager
def registry_lock():
    """등록부를 고치는 설치를 한 번에 하나만 돌린다 — 판정부터 쓰기까지가 한 구역이다.

    잠금은 `flock` 이라 프로세스가 끝나면 풀린다. 죽은 설치가 남긴 잠금 파일이 다음 설치를 막지 않는다.
    """
    home = registry()
    home.mkdir(parents=True, exist_ok=True)
    fd = os.open(home / ".install.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def register(cfg, target: Path):
    """이 하네스 루트를 클론 키로 등록한다 — `<등록부>/<클론 키>/project.json` 에 경로와 이름.

    다른 키 디렉터리에서 이 루트를 가리키던 project.json 은 지운다. 그 디렉터리의 다른 파일은 남는다.
    쓰지 못하면 예외가 설치를 멈춘다."""
    key = clone_key(target)
    d = registry() / key
    d.mkdir(mode=0o700, parents=True, exist_ok=True)
    (d / "project.json").write_text(json.dumps({"path": str(target), "name": cfg["project"]["name"]}) + "\n",
                                    encoding="utf-8")
    for r in registrations()[0]:
        if r["key"] != key and r["path"] == str(target):
            (registry() / r["key"] / "project.json").unlink(missing_ok=True)


def legacy_dir(cfg, target: Path):
    """옮길 옛 이름 디렉터리 — 옛 버전이 `<등록부>/<project.name>/` 에 남긴 등록이 이 하네스 루트를 가리킬 때만. 아니면 None."""
    name = cfg["project"]["name"]
    if not isinstance(name, str) or not name or CLONE_KEY.fullmatch(name) or name in (".", "..") or "/" in name:
        return None
    d = registry() / name
    _name, path = read_registration(d) or (None, None)
    if path is None or os.path.realpath(path) != os.path.realpath(target):
        return None
    return d


def append_file(src: str, dst: str):
    """src 의 내용을 dst 끝에 덧붙인다. dst 가 줄 중간에서 끝나면 줄을 바꾼 뒤 붙인다."""
    with open(src, "rb") as f:
        data = f.read()
    with open(dst, "rb+") as f:
        f.seek(0, os.SEEK_END)
        if f.tell():
            f.seek(-1, os.SEEK_END)
            if f.read(1) != b"\n":
                f.write(b"\n")
        f.write(data)


def private_tree(d: str):
    """d 와 그 아래 디렉터리를 0700, 파일을 0600 으로. 링크는 건드리지 않는다."""
    os.chmod(d, 0o700)
    for top, dirs, files in os.walk(d):
        for x in dirs:
            if not os.path.islink(os.path.join(top, x)):
                os.chmod(os.path.join(top, x), 0o700)
        for x in files:
            if not os.path.islink(os.path.join(top, x)):
                os.chmod(os.path.join(top, x), 0o600)


def move_state_dir(old: str, new: str):
    """기록 디렉터리를 옮긴다. 새 자리가 있으면 파일마다 옮기고, 같은 이름은 스팬 파일만 덧붙이고 그 밖은 옛 것을 지운다."""
    if not os.path.lexists(new):
        os.makedirs(os.path.dirname(new), mode=0o700, exist_ok=True)
        shutil.move(old, new)
    else:
        for top, _dirs, files in os.walk(old):
            for x in files:
                src = os.path.join(top, x)
                dst = os.path.join(new, os.path.relpath(src, old))
                if not os.path.lexists(dst):
                    os.makedirs(os.path.dirname(dst), mode=0o700, exist_ok=True)
                    shutil.move(src, dst)
                elif re.fullmatch(r"spans-.*\.jsonl", x):
                    append_file(src, dst)
                    os.unlink(src)
                else:
                    # 커서는 새 것이 이어 온 기록이다. 잠금·정리 표지는 새 자리의 것이 맞다
                    os.unlink(src)
        for top, _dirs, _files in os.walk(old, topdown=False):
            try:
                os.rmdir(top)
            except OSError:
                pass
    private_tree(new)


def move_state_file(old: str, new: str):
    """기록 파일을 옮긴다. 새 파일이 있으면 옛 내용을 끝에 덧붙이고 옛 파일을 지운다."""
    if not os.path.lexists(new):
        os.makedirs(os.path.dirname(new), mode=0o700, exist_ok=True)
        shutil.move(old, new)
    else:
        append_file(old, new)
        os.unlink(old)


def worktree_entries(top: str) -> list:
    """`git worktree list --porcelain` 의 항목 — (경로, 잠겼는가)."""
    out, cur = [], None
    for ln in git(top, "worktree", "list", "--porcelain").stdout.splitlines() + [""]:
        if ln.startswith("worktree "):
            cur = [ln[len("worktree "):], False]
        elif cur is not None and (ln == "locked" or ln.startswith("locked ")):
            cur[1] = True
        elif not ln and cur is not None:
            out.append(tuple(cur))
            cur = None
    return out


def migrate_worktrees(target: Path, old_dir: str, new_dir: str, say):
    """옛 worktree.dir 바로 아래에 등록된 이 리포의 worktree 를 새 자리로 `git worktree move` 한다. 옮기지 못하면 사유와 함께 남긴다."""
    r = git(target, "rev-parse", "--show-toplevel")
    if r.returncode != 0 or not r.stdout.strip():
        return
    top, real_old = r.stdout.strip(), os.path.realpath(old_dir)
    for path, locked in worktree_entries(top):
        if os.path.dirname(os.path.realpath(path)) != real_old:
            continue
        name = os.path.basename(path)
        old, new = os.path.join(old_dir, name), os.path.join(new_dir, name)
        why = None
        if locked:
            why = "locked"
        elif not os.path.isdir(path):
            why = "missing — run git worktree prune"
        else:
            st = git(path, "status", "--porcelain")
            if st.returncode != 0 or st.stdout.strip():
                why = "uncommitted changes"
            elif os.path.lexists(new):
                why = "destination exists"
        if why is None:
            try:
                os.makedirs(new_dir, mode=0o700, exist_ok=True)
                why = None if git(top, "worktree", "move", path, new).returncode == 0 else "git worktree move failed"
            except OSError as e:
                why = type(e).__name__
        say(("left worktree %s at %s — %s" % (name, old, why)) if why else ("moved worktree %s to %s" % (name, new)))


def migrate_legacy(cfg, target: Path, who: str):
    """옛 버전이 이름으로 남긴 기기 단위 상태(가져오기 커서 · 실행 지표 · 사용 기록 · 이슈 worktree)를 이 클론의 키 아래로 옮긴다.

    옛 이름 디렉터리의 등록이 이 하네스 루트를 가리킬 때만 돈다. 등록부 잠금 안에서 부른다. 옮기지 못한 것은 사유와 함께
    알리고 남긴다 — 다음 install · render 가 다시 옮긴다. 종료 코드에 닿지 않는다."""
    old_dir = legacy_dir(cfg, target)
    if old_dir is None:
        return
    name, key = cfg["project"]["name"], clone_key(target)
    say = lambda msg: print("%s: %s" % (who, msg))
    full = lambda v: os.path.expandvars(os.path.expanduser(v))

    def both(value):
        """설정 값의 (옛 경로, 새 경로). off 거나 두 경로가 같으면 None."""
        if not isinstance(value, str) or value == "off":
            return None
        old = full(value.replace("{clone}", name).replace("{project}", name))
        new = full(expand_key(value, target))
        return None if old == new else (old, new)

    moves = [("import state", (str(old_dir / "state"), str(registry() / key / "state")), move_state_dir),
             ("run metrics", both(cfg["metrics"]["dir"]), move_state_dir),
             ("usage log", both(cfg["usage"]["log_path"]), move_state_file)]
    for item, pair, how in moves:
        if pair is None or not os.path.lexists(pair[0]):
            continue
        try:
            how(*pair)
            say("moved %s to %s" % (item, pair[1]))
        except OSError as e:
            say("left %s at %s — %s" % (item, pair[0], type(e).__name__))
    wt = both(cfg["worktree"]["dir"])
    if wt is not None:
        migrate_worktrees(target, wt[0], wt[1], say)

    if read_registration(registry() / key) is None:
        (registry() / key).mkdir(mode=0o700, parents=True, exist_ok=True)
        (registry() / key / "project.json").write_text(json.dumps({"path": str(target), "name": name}) + "\n",
                                                       encoding="utf-8")
    # 등록 말고 남은 것이 빈 디렉터리뿐이면 통째로 지운다. 남은 것이 있으면 등록까지 그대로 둔다 — 다음에 다시 옮긴다
    left = [os.path.join(top, x) for top, dirs, files in os.walk(old_dir)
            for x in files + [d for d in dirs if os.path.islink(os.path.join(top, d))]]
    if all(x == str(old_dir / "project.json") for x in left):
        try:
            shutil.rmtree(old_dir)
            say("removed %s" % old_dir)
            return
        except OSError:
            pass
    try:
        n = len([x for x in os.listdir(old_dir) if x != "project.json"])
    except OSError:
        n = 0
    say("kept %s — %d item(s) left there" % (old_dir, n))


def cmd_projects(_cfg, _target, _args):
    """`harness projects` — 이 기기에 등록된 클론 목록(JSON). UI 가 읽는다. 설정을 읽지 않고 등록부를 바꾸지 않는다.

    projects 는 클론 등록, legacy 는 옛 버전이 이름으로 만든 디렉터리의 등록이다. ok 는 경로 아래에 설정이 있는지다.
    두 목록 모두 이름, 경로(없는 것은 뒤), 키 순이다."""
    clones, legacy = registrations()
    order = lambda r: (r["name"], r["path"] is None, r["path"] or "", r["key"] or "")
    print(json.dumps({
        "projects": [{"key": r["key"], "name": r["name"], "path": r["path"],
                      "ok": bool(r["path"]) and os.path.isfile(os.path.join(r["path"], "harness.toml"))}
                     for r in sorted(clones, key=order)],
        "legacy": [{"name": r["name"], "path": r["path"]} for r in sorted(legacy, key=order)],
    }, ensure_ascii=False, indent=2))
    return 0


def report_same_name(cfg, target: Path):
    """같은 이름의 다른 클론 등록을 알린다. 여러 클론은 정상이라 거부하지 않는다."""
    name, key = cfg["project"]["name"], clone_key(target)
    others = [r for r in registrations()[0] if r["name"] == name and r["key"] != key]
    for r in sorted(others, key=lambda r: (r["path"] is None, r["path"] or "", r["key"])):
        print("install: `%s` is also registered at %s" % (name, r["path"] or "(no path)"))


def unregister(target: Path):
    """이 하네스 루트를 가리키는 project.json 을 키 디렉터리와 옛 이름 디렉터리 양쪽에서 지운다. 기록은 남긴다."""
    clones, legacy = registrations()
    for r in clones + legacy:
        if r["path"] == str(target):
            (registry() / (r["key"] or r["name"]) / "project.json").unlink(missing_ok=True)


def source_tree(p: Path) -> bool:
    """하네스 소스 리포인가 — 실행 파일과 기본 설정을 `src/` 아래에 갖는다."""
    return (p / "src" / "bin" / "harness").is_file() and (p / "src" / "templates" / "harness.toml").is_file()


def harness_version() -> str:
    """이 CLI 의 버전 — 기본 설정의 번호에 소스 커밋을 붙인다(`0.1.0+d5d3b93`). 커밋을 알 수 없으면 번호만 낸다.

    번호만으로는 같은 번호의 서로 다른 커밋을 가르지 못한다. 소스 체크아웃은 git 이, Homebrew 설치본은
    설치 영수증(`INSTALL_RECEIPT.json` 의 `source.scm_revision`)이 커밋을 안다. 체크아웃의 `src/` 에
    커밋하지 않은 변경이 있으면 `-dirty` 를 붙인다 — 그 커밋과 내용이 같지 않다.
    """
    with DEFAULT_CONFIG.open("rb") as f:
        base = tomllib.load(f)["harness"]["version"]
    top, rev, dirty = ROOT.parent, "", False
    if source_tree(top) and (top / ".git").exists():
        r = git(top, "rev-parse", "HEAD")
        rev = r.stdout.strip() if r.returncode == 0 else ""
        dirty = bool(rev) and bool(git(top, "status", "--porcelain", "--", "src").stdout.strip())
    else:
        try:
            rev = json.loads((top / "INSTALL_RECEIPT.json").read_text(encoding="utf-8"))["source"]["scm_revision"]
        except (OSError, ValueError, KeyError, TypeError):
            pass
    if not isinstance(rev, str) or not re.fullmatch(r"[0-9a-f]{7,40}", rev):
        return base
    return "%s+%s%s" % (base, rev[:7], "-dirty" if dirty else "")


def loaded_config(target: Path) -> dict:
    cfg = load(target)
    normalize(cfg)
    validate(cfg)
    return cfg


def cmd_install(_cfg, target, args):
    """설정을 깔고(없으면) 고정 사본을 깔고 등록한 뒤 render 한다.

    `--create` 는 없는 대상 디렉터리를 만들고 `--git-init` 은 `.git` 이 없는 대상에서 git 을 시작한다.
    무엇이든 만들기 전에 install 이 바꿀 경로를 가른다 — 거부되면 디렉터리 · `.git` · 설정이 생기지 않는다.
    """
    create, git_init = getattr(args, "create", False), getattr(args, "git_init", False)
    if not os.path.lexists(target) and not create:
        die("error: target directory does not exist\n  --> %s\n\n"
            "help: create it as part of the install\n        harness install --create --target %s" % (target, target))
    if os.path.lexists(target) and not target.is_dir():
        die("error: target is not a directory\n  --> %s" % target)
    # 등록부를 고치는 설치는 한 번에 하나만 돈다 — 다른 설치가 같은 루트를 가리키는 등록을 지우는 사이에 끼지 않는다
    with registry_lock():
        cfg = loaded_config(target) if (target / "harness.toml").is_file() else None
        # 있는 대상은 디렉터리 · .git · 설정을 만들기 전에 install 이 바꿀 경로를 판정한다.
        # 설정이 없으면 깔 기본 설정으로 판정한다(파일로 쓰지 않는다) — 그 설정을 쓸 자리도 판정한다
        extra = {rel: "remove" for rel in (PINNED.rstrip("/"),) + PINNED_PARTS}
        if cfg is None:
            extra["harness.toml"] = "write"
        if target.is_dir() and refuse_changes(cfg or seeded_config(target), target, args, extra):
            return 2
        # git init 뒤에야 드러나는 거부도 있다 — 리포 루트가 바뀌면 만들 파일(forge 템플릿)이 달라진다.
        # 이번 실행이 만든 것(디렉터리 · .git · 기본 설정)을 기록해 두고, 등록 전에 멈추면 그것만 걷는다
        had_pin = os.path.lexists(target / PINNED.rstrip("/"))
        made_dirs, made_git, seeded, done = [], False, False, False
        try:
            if not target.is_dir():
                # 한 단계씩 만들어 실제로 이번에 만든 것만 기록한다 — 그 사이 다른 것이 만든 디렉터리는 걷지 않는다
                for d in reversed([p for p in (target, *target.parents) if not os.path.lexists(p)]):
                    try:
                        d.mkdir()
                        made_dirs.insert(0, d)
                    except FileExistsError:
                        pass
                if not target.is_dir():
                    die("error: target is not a directory\n  --> %s" % target)
                print("install: created %s" % target)
            if git_init and not os.path.lexists(target / ".git"):
                made_git = True
                r = subprocess.run(["git", "init", "-q"], cwd=str(target), capture_output=True, text=True)
                if r.returncode != 0:
                    tail = [ln for ln in (r.stderr or "").splitlines() if ln.strip()]
                    die("error: git init failed: %s\n  --> %s" % (tail[-1].strip() if tail else "exit %d" % r.returncode, target))
                print("install: started a git repository in %s" % target)
            if cfg is None:
                seeded = True
                seed_config(target)
                cfg = loaded_config(target)
            done = install_registered(cfg, target, args)
        finally:
            if not done:
                undo_created(target, made_dirs, made_git, seeded, not had_pin)
        if not done:
            return 2
    rc = cmd_render(cfg, target, args, migrate=False)
    # 렌더가 끝나야 `script/githooks/` 가 있다.
    if rc == 0:
        report_hooks(target)
    return rc


PINNED_PARTS = (".harness/bin", ".harness/templates", ".harness/VERSION")


def undo_created(target: Path, made_dirs: list, made_git: bool, seeded: bool, made_pin: bool):
    """거부·실패한 install 이 이번에 만든 것만 걷는다 — 이번에 만든 .git · 기본 설정 · 고정 사본, 그리고 비어 있는 새 디렉터리.

    디렉터리는 통째로 지우지 않는다 — 그 사이 다른 것이 만든 파일이 들어 있을 수 있다. 원래 있던 것은 건드리지 않는다.
    made_dirs 는 이번에 만든 디렉터리, 안쪽(대상)부터 위로다.
    """
    if made_git and os.path.lexists(target / ".git"):
        shutil.rmtree(guarded_path(target, ".git", "remove"))
        print("install: removed the git repository it started")
    if seeded and os.path.lexists(target / "harness.toml"):
        guarded_path(target, "harness.toml", "remove").unlink()
    # 고정 사본을 깔다 멈춘 것 — 시작할 때 .harness 가 없었으면 그 안은 전부 이번 실행이 깐 것이다
    pin = PINNED.rstrip("/")
    if made_pin and os.path.lexists(target / pin):
        p = guarded_path(target, pin, "remove")
        shutil.rmtree(p) if p.is_dir() and not p.is_symlink() else p.unlink()
        print("install: removed the partial %s" % pin)
    for d in made_dirs:
        # 하네스 루트 위의 디렉터리일 수 있어 공용 함수 밖이다. 비어 있을 때만 지워진다
        try:
            d.rmdir()
        except OSError:
            print("install: kept %s — something else is in it now" % d)
            break


def clear_dir(d: Path, keep=()):
    """d 안의 항목을 걷는다. 안의 링크는 링크 자신만 지우고 따라가지 않는다. keep 은 남길 일반 파일 이름이다."""
    for old in d.iterdir():
        if old.name in keep and old.is_file() and not old.is_symlink():
            continue
        if old.is_dir() and not old.is_symlink():
            shutil.rmtree(old)
        else:
            old.unlink()


def install_registered(cfg, target: Path, args=None) -> bool:
    """고정 사본을 깔고 등록한다. 사전 판정이 멈추면 아무것도 바꾸지 않고 False."""
    pin = PINNED.rstrip("/")
    # 사본을 바꾸기 전에 가른다. 판정은 설치하려는 이 CLI 의 템플릿과 설정으로 한다.
    if refuse_changes(cfg, target, args, {rel: "remove" for rel in (pin,) + PINNED_PARTS}):
        return False
    if source_tree(target):
        # 소스 리포는 자기 자신을 고정하지 않는다 — 사본을 두면 템플릿을 고칠 때마다 두 곳이 어긋나고,
        # 생성물이 작업 트리가 아니라 지난 사본을 따라간다. 훅과 검증 스크립트는 `.harness/bin/harness`
        # 가 없으면 `src/bin/harness` 를 쓴다. 옛 방식으로 깔린 사본이 있으면 걷어낸다(매니페스트는 남긴다).
        for rel in PINNED_PARTS:
            stale = guarded_path(target, rel, "remove")
            if stale.is_dir():
                shutil.rmtree(stale)   # 안의 링크는 링크 자신만 지운다
            elif os.path.lexists(stale):
                stale.unlink()
        print("install: %s is the harness source tree — it runs its own src/bin/harness, nothing to vendor" % target)
        migrate_legacy(cfg, target, "install")
        register(cfg, target)
        report_same_name(cfg, target)
        return True
    # 사본만 갈아 끼운다. 매니페스트가 사라지면 이전에 깐 하네스 파일이 전부 프로젝트 것으로 보인다.
    dst = guarded_path(target, pin, "remove")
    if dst.is_dir():
        clear_dir(dst, keep={Path(MANIFEST).name, Path(MANIFEST_MANAGED).name})
    make_dirs(target, ".harness/bin")
    shutil.copy2(HERE / "harness", guarded_path(target, ".harness/bin/harness", "write"))
    shutil.copy2(HERE / "harness_metrics.py", guarded_path(target, ".harness/bin/harness_metrics.py", "write"))
    shutil.copytree(TEMPLATES, guarded_path(target, ".harness/templates", "create"),
                    ignore=shutil.ignore_patterns("__pycache__"))
    version = harness_version()
    guarded_path(target, ".harness/VERSION", "write").write_text(version + "\n", encoding="utf-8")
    # 사본을 깐 직후의 해시를 기록한다. 관리 파일 줄은 지난 render 의 것을 그대로 둔다.
    hashes = {rel: h for rel, h in manifest_entries(target) if not rel.startswith(PINNED)}
    hashes.update((PINNED + rel, sha256_of(dst / rel)) for rel in pinned_files(dst))
    write_manifest_hashes(target, hashes)
    print("install: %s (harness %s)" % (dst, version))
    migrate_legacy(cfg, target, "install")
    register(cfg, target)
    report_same_name(cfg, target)
    return True



# 설정에 적는 이름과 설치되는 실행 파일 이름이 다른 도구.
ADR_EXE = {"adr-tools": "adr"}


def hooks_path(target: Path):
    r = git(target, "config", "core.hooksPath")
    return r.stdout.strip() if r.returncode == 0 else ""


HOOKS_DIR = "script/githooks"


def repo_prefix(target: Path):
    """하네스 루트의 리포 안 위치 — 리포 루트면 빈 문자열, 아니면 `/` 로 끝난다. git 작업 트리 밖이면 None."""
    r = git(target, "rev-parse", "--show-prefix")
    return r.stdout.strip() if r.returncode == 0 else None


def hooks_expected(target: Path) -> str:
    """이 하네스의 훅을 켜는 `core.hooksPath` 값. 작업 트리 최상위 기준의 상대 경로다."""
    return (repo_prefix(target) or "") + HOOKS_DIR


def hooks_on(target: Path, value: str = None) -> bool:
    """`core.hooksPath` 가 하네스 루트의 `script/githooks` 를 가리키는가. 상대 값은 작업 트리 최상위 기준으로 푼다."""
    value = hooks_path(target) if value is None else value
    if not value:
        return False
    top = git(target, "rev-parse", "--show-toplevel")
    if top.returncode != 0:
        return False
    p = Path(os.path.expanduser(value))
    if not p.is_absolute():
        p = Path(top.stdout.strip()) / p
    return os.path.realpath(p) == os.path.realpath(target / HOOKS_DIR)


def enable_hooks(target: Path):
    """비어 있을 때만 `core.hooksPath` 를 기대 값으로 켠다. 출력하지 않고 (결과, 부가 값) 을 돌려준다.

    결과는 `no-git` · `already` · `other`(그 값) · `own-hooks`(훅 파일 이름 목록) · `set`(기대 값) · `failed`(git 의 오류 끝 줄).
    """
    if repo_prefix(target) is None:
        return "no-git", None
    value = hooks_path(target)
    if hooks_on(target, value):
        return "already", value
    if value:
        return "other", value
    r = git(target, "rev-parse", "--git-path", "hooks")
    if r.returncode == 0 and r.stdout.strip():
        d = Path(r.stdout.strip())
        d = d if d.is_absolute() else target / d
        own = sorted(f.name for f in d.iterdir() if f.is_file() and not f.name.endswith(".sample")) if d.is_dir() else []
        if own:
            return "own-hooks", (r.stdout.strip(), own)
    want = hooks_expected(target)
    r = git(target, "config", "core.hooksPath", want)
    if r.returncode != 0:
        tail = [ln for ln in (r.stderr or "").splitlines() if ln.strip()]
        return "failed", tail[-1].strip() if tail else "git config exited with %d" % r.returncode
    return "set", want


def report_hooks(target: Path, who: str = "install") -> str:
    """훅 설정 결과를 알리고 결과를 돌려준다. install 은 모두 표준 출력에 내고, 그 밖은 켜지 않은 이유를 표준 오류에 낸다."""
    result, extra = enable_hooks(target)
    want = hooks_expected(target) if result != "no-git" else HOOKS_DIR
    help_line = "help: to use this harness's hooks, run `git config core.hooksPath %s`" % want
    out = sys.stdout if who == "install" or result in ("set", "already") else sys.stderr
    if result == "set":
        print("%s: set core.hooksPath to %s — git hooks now run on commit and push" % (who, extra), file=out)
    elif result == "already" and who != "install":
        print("%s: core.hooksPath is already %s — git hooks run on commit and push" % (who, extra), file=out)
    elif result == "other":
        print("%s: core.hooksPath is already %s — left as is\n%s" % (who, extra, help_line), file=out)
    elif result == "own-hooks":
        d, names = extra
        print("%s: core.hooksPath is not set but %s has hooks of its own (%s) — left as is\n%s"
              % (who, d, ", ".join(names), help_line), file=out)
    elif result == "no-git":
        print("%s: not a git repository — git hooks were not enabled\n"
              "help: after `git init`, run `git config core.hooksPath %s`" % (who, want), file=out)
    elif result == "failed":
        print("%s: could not set core.hooksPath: %s\n%s" % (who, extra, help_line), file=out)
    return result


# Doctor 화면의 조치 가운데 명령이 따로 없던 것.
FIXES = ("hooks", "verify")


def cmd_fix(_cfg, target, args):
    """`harness fix hooks|verify` — 훅 경로는 install 의 설정 로직으로 켜고, 검증은 그 스크립트를 다시 돌린다."""
    if len(args.args) != 1 or args.args[0] not in FIXES:
        die("error: fix takes one of: %s\n\n"
            "usage: harness fix <hooks|verify>\n"
            "  hooks    point core.hooksPath at this harness's git hooks, as install does\n"
            "  verify   run the verification script again" % ", ".join(FIXES))
    if args.args[0] == "verify":
        sys.stdout.flush()
        return subprocess.run(["bash", verify_entry(target)], cwd=str(target)).returncode
    return 0 if report_hooks(target, "fix") in ("set", "already") else 2


def owned_files(target: Path):
    """대상에 실제로 있는 소유 파일과 설정. `--purge` 만 이것을 지운다."""
    out = [rel for rel in sorted(p.relative_to(TEMPLATES / "owned").as_posix()
                                 for p in (TEMPLATES / "owned").rglob("*") if p.is_file())
           if (target / rel).is_file()]
    out += [rel for rel in (LEGACY_VERIFY, LEGACY_COMMANDS) if (target / rel).is_file() and rel not in out]
    if (target / "harness.toml").is_file():
        out.append("harness.toml")
    return out


def by_dir(paths):
    """최상위 디렉터리로 묶어 건수만 낸다. 수십 개를 나열하면 아무도 읽지 않는다."""
    out = {}
    for rel in paths:
        head = rel.split("/")[0] + "/" if "/" in rel else rel
        out[head] = out.get(head, 0) + 1
    return sorted(out.items())


def confirm_purge(target: Path, harness_files, owned, args):
    """`--purge` 는 사람이 쓴 산문과 설정까지 지운다. 무엇이 사라지는지 보이고 확인을 받는다.

    되돌릴 수 없는 유일한 명령이므로 게이트가 여기 있다. 종료 코드: 0 진행 · 1 거절 · 2 확인 불가.
    """
    print("purge target: %s" % target)
    print("\n  installed by the harness — `harness install` puts these back")
    print("    %-30s vendored copy of the harness" % ".harness/")
    for d, n in by_dir(harness_files):
        print("    %-30s %s" % (d, "%d files" % n if d.endswith("/") else ""))
    print("\n  yours — these do not come back")
    for rel in owned:
        print("    %s" % rel)
    leftovers = [d for d in ("docs/spec", "docs/plan", cfg_adr_dir(target),
                             ".github/workflows", ".gitlab-ci.yml")
                 if d and (target / d).exists()]
    if leftovers:
        print("\n  untouched work output: %s" % ", ".join(leftovers))

    if args.yes:
        return 0
    if not sys.stdin.isatty():
        sys.stdout.flush()   # 목록이 먼저 보여야 사유가 읽힌다
        print("\nstop: --purge needs a confirmation and this shell is not interactive\n"
              "help: rerun with --yes if you mean it", file=sys.stderr)
        return 2
    try:
        answer = input("\nremove these? [y/N] ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        answer = ""
    if answer not in ("y", "yes"):
        print("stop: nothing was removed")
        return 1
    return 0


def cmd_uninstall(_cfg, target, args):
    """하네스가 깐 것만 지운다. 프로젝트가 쓴 것은 남긴다.

    소유 파일(`.ai/project/`·`docs/spec/README.md`, 옛 설치의 `script/verify-project.sh`)과 설정,
    그리고 명세·분해·결정 기록 같은 작업 산출물은 **사람이 쓴 것이라 지우지 않는다.** `--purge` 를 줘야 소유 파일과
    설정까지 지운다 — 그건 되돌릴 수 없으므로 따로 켜고, 지우기 전에 확인을 받는다.
    """
    # 매니페스트가 없다고 판정하기 전에 본다 — 어긋난 줄만 있는 매니페스트를 없는 것으로 보지 않는다
    if refuse_unsafe_manifest(target, "uninstall"):
        return 2
    gen = previous(target, MANIFEST)
    man = previous(target, MANIFEST_MANAGED)
    if not gen and not man:
        die("error: no harness manifest at %s\n\n  Nothing was installed here, or it has already been removed." % MANIFEST)

    owned = owned_files(target)
    # 무엇이든 지우기 전에 지울 경로 전부를 경로 규칙으로 본다 — 링크를 따라 지우면 리포 밖의 파일이 사라진다
    doomed = {rel: "remove" for rel in set(gen) | set(man) | {PINNED.rstrip("/")}}
    if args.purge:
        doomed.update((rel, "remove") for rel in owned)
    if refuse_unsafe_paths(target, doomed, "uninstall"):
        return 2
    if args.purge:
        rc = confirm_purge(target, sorted(r for r in set(gen) | set(man) if not r.startswith(PINNED)), owned, args)
        if rc:
            return rc

    # 훅 디렉터리를 지우기 전에 가른다. 다른 서브프로젝트나 다른 도구를 가리키는 값은 이 하네스의 것이 아니다
    ours_hooks = hooks_on(target)
    removed, kept = [], []
    for rel in sorted(set(gen) | set(man)):
        if rel.startswith(PINNED):
            continue   # 고정 사본은 아래에서 `.harness/` 째로 걷는다
        f = guarded_path(target, rel, "remove")
        if f.is_file():
            f.unlink()
            removed.append(rel)

    if args.purge:
        for rel in owned:
            f = guarded_path(target, rel, "remove")
            if f.is_file():
                f.unlink()
                removed.append(rel)
    else:
        kept = owned

    # 안의 링크는 링크 자신만 지운다 — rmtree 는 디렉터리 링크를 따라 들어가지 않는다
    shutil.rmtree(guarded_path(target, PINNED.rstrip("/"), "remove"), ignore_errors=True)
    unregister(target)

    # 훅 설정이 사라진 디렉터리를 가리키면 커밋할 때마다 git 이 실패한다.
    if ours_hooks and git(target, "config", "--unset", "core.hooksPath").returncode == 0:
        print("  unset core.hooksPath (it pointed at a directory that is now gone)")

    # 하네스가 만든 빈 디렉터리를 정리한다. 작업 산출물이 남아 있으면 그대로 둔다.
    for rel_dir in sorted({rel.rsplit("/", 1)[0] for rel in removed if "/" in rel}):
        parts = rel_dir.split("/")
        while parts:
            d = guarded_path(target, "/".join(parts), "remove")
            if not d.is_dir() or any(d.iterdir()):
                break
            d.rmdir()
            parts.pop()

    print("uninstall: removed %d files" % len(removed))
    if kept:
        print("\nkept — these are yours, not the harness's (use --purge to remove them too):")
        for rel in kept:
            print("  %s" % rel)
    leftovers = [d for d in ("docs/spec", "docs/plan", cfg_adr_dir(target),
                             ".github/workflows", ".gitlab-ci.yml")
                 if d and (target / d).exists()]
    if leftovers:
        print("\nuntouched: %s" % ", ".join(leftovers))
    return 0


def cfg_adr_dir(target: Path):
    """설정이 이미 지워졌을 수 있으므로 없으면 조용히 넘어간다."""
    p = target / "harness.toml"
    if not p.is_file():
        return ""
    try:
        with p.open("rb") as f:
            return tomllib.load(f).get("adr", {}).get("dir", "")
    except Exception:
        return ""


# ─────────────────────────────────────────────────────────────────────────────
# 참조 검사
#
# 하네스 문서가 사람에게 시키던 grep 을 여기로 옮긴다. 문서에 적힌 검사는
# 아무도 돌리지 않는다 — 검사는 명령이 갖고, 문서는 그 명령을 부른다.

SCAN_DIRS = (".ai", ".claude", ".codex", "script", "docs")
SCAN_ROOTS = ("CLAUDE.md", "AGENTS.md", "README.md", "harness.toml")
SCAN_SUFFIX = {".md", ".sh", ".json", ".toml", ".yml", ".yaml", ".py", ""}

# 백틱 안의 리포 경로. 자리표시자(`<이슈>`·`*`·`{}`)가 섞인 것은 실재를 물을 수 없다.
REF_RE = re.compile(r"`([^`\s]+)`")
REF_PREFIX = (".ai/", ".claude/", ".codex/", "script/", "docs/")
REF_SUFFIX = (".md", ".sh", ".json", ".toml", ".yml", ".yaml", ".py")
REF_SKIP = set("<>*{}|()[]…")

# 하네스가 문서에 적지만 만들지는 않는 파일. 없는 것이 정상이라 끊긴 참조가 아니다.
# git 이 무시하는 경로도 같이 빠지지만, 그쪽은 리포가 git 일 때만 판정된다.
REF_OPTIONAL = {".claude/settings.local.json", LEGACY_VERIFY, LEGACY_COMMANDS}


def scan_files(target):
    """참조를 찾을 파일. 생성·관리·소유를 가리지 않고 리포가 읽는 텍스트 전부."""
    for d in SCAN_DIRS:
        base = target / d
        if base.is_dir():
            for f in sorted(base.rglob("*")):
                if f.is_file() and f.suffix in SCAN_SUFFIX:
                    yield f
    for n in SCAN_ROOTS:
        f = target / n
        if f.is_file():
            yield f


def ref_paths(text):
    """본문이 실재를 주장하는 리포 경로만 낸다."""
    for tok in REF_RE.findall(text):
        if REF_SKIP & set(tok) or "://" in tok:
            continue
        if not tok.startswith(REF_PREFIX) or not tok.endswith(REF_SUFFIX):
            continue
        yield tok


def dangling_roles(cfg, target):
    """설정에 없는 역할을 아직 부르는 자리. 역할을 지우고 참조를 남기면 없는 것을 부른다."""
    known = {f.stem for f in (TEMPLATES / "agents").glob("*.md")}
    gone = sorted(known - set(cfg["roles"]))
    out = []
    for name in gone:
        for f in scan_files(target):
            for i, ln in enumerate(f.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
                if name in ln:
                    out.append((name, f.relative_to(target).as_posix(), i))
                    break
    return out


def git_ignored(target, paths):
    """git 이 무시하는 경로. 개인 설정처럼 없는 것이 정상인 파일을 결과에서 뺀다."""
    if not paths:
        return set()
    try:
        r = subprocess.run(["git", "check-ignore", "--stdin"], cwd=target,
                           input="\n".join(paths), capture_output=True, text=True)
    except OSError:
        return set()
    return set(r.stdout.split())


def broken_refs(target):
    """문서가 가리키는데 없는 파일. 문서가 언급하는 파일은 실재해야 한다."""
    out = []
    for f in scan_files(target):
        if f.suffix != ".md":
            continue
        for tok in dict.fromkeys(ref_paths(f.read_text(encoding="utf-8", errors="replace"))):
            if tok not in REF_OPTIONAL and not (target / tok).exists():
                out.append((f.relative_to(target).as_posix(), tok))
    skip = git_ignored(target, sorted({t for _, t in out}))
    return [(rel, tok) for rel, tok in out if tok not in skip]


# 사실 문서의 채우지 않은 자리. 본문에 낱말 TBD 가 따로 나오는 것은 자리표시자가 아니다.
PLACEHOLDER = "<!-- TBD"
# 어댑터 머리글의 검증 상태 표지. 머리글 밖의 주석·코드에 나오는 같은 낱말은 판정에 쓰지 않는다.
ADAPTER_UNVERIFIED = "검증 상태: 미검증"


def adapter_header(text: str) -> str:
    """어댑터 파일의 머리글 — 1행부터 `#` 로 시작하는 줄이 이어지는 첫 주석 덩어리."""
    head = []
    for ln in text.splitlines():
        if not ln.startswith("#"):
            break
        head.append(ln)
    return "\n".join(head)


def doctor_items(cfg, target, remote=False):
    """쓸 준비가 됐는지 본 결과 — `{"section", "state", "what", "detail"}` 목록. 표준 출력에 쓰지 않는다.

    목록의 순서가 출력 순서다. 설정 자체는 여기 오기 전에 이미 검증됐다.
    """
    v = derive(cfg)
    items = []
    sec = ""

    def section(name):
        nonlocal sec
        sec = name

    def line(state, what, detail=""):
        items.append({"section": sec, "state": state, "what": what, "detail": detail})

    section("config")
    line("ok", "harness.toml is valid")
    for rev, dev in distinct_pairs(cfg):
        line("ok", "%s (%s) differs from %s (%s)" % (dev, vendor(cfg, dev), rev, vendor(cfg, rev)))
    # 오케스트레이터가 할 수 없는 것 — 벤더 선언의 능력에서. 막지는 않는다(확인되지 않은 능력이 있다)
    o = VENDORS[cfg["harness"]["orchestrator"]]
    if not o.get("hooks"):
        line("warn", "no command guard for %s" % o["name"],
             "bash-guard.sh runs only under an orchestrator the harness wires hooks for; git hooks still apply")
    for n in sorted(cfg["roles"]):
        if cfg["roles"][n].get("model") and cfg["roles"][n]["runner"] == cfg["harness"]["orchestrator"]:
            line("warn", "roles.%s.model = %s is not used" % (n, cfg["roles"][n]["model"]),
                 "the orchestrator runs this role, so it uses harness.model")
    inproc = sorted(n for n, r in cfg["roles"].items() if r["runner"] == "inproc")
    if inproc and not o.get("subagents"):
        line("warn", "%s cannot run subagents" % o["name"], "these roles need a CLI runner: %s" % ", ".join(inproc))
    # 역할의 모델은 그 역할을 실제로 돌리는 에이전트의 것이어야 한다. 오케스트레이터를 바꾸면
    # 서브에이전트 역할의 실행 주체가 따라 바뀌므로, 전에 고른 모델이 새 주체에 없을 수 있다.
    tools = recorded_tools()
    for n in sorted(cfg["roles"]):
        if model_ok(cfg, n, tools) is False:
            line("warn", "roles.%s.model = %s" % (n, cfg["roles"][n]["model"]),
                 "not a model of %s on this machine (harness tools --sync to refresh)" % vendor(cfg, n))
    for k in old_alias_keys(cfg):
        line("warn", "`%s` uses `{project}`" % k, "an old alias of {clone} — replace it with {clone} in harness.toml")

    section("generated files")
    diff = drift(cfg, target)
    unsafe = unsafe_manifest_items(target, MANIFEST, line)
    if diff:
        line("bad", "%d files differ from the config" % len(diff), "run `harness render`")
    elif not unsafe:
        line("ok", "%d files match the config" % len(plan(cfg, target)))

    section("managed files")
    managed_items(target, line)

    section("project facts")
    for rel in sorted(p.relative_to(TEMPLATES / "owned").as_posix()
                      for p in (TEMPLATES / "owned").rglob("*") if p.is_file()):
        f = target / rel
        if not f.is_file():
            line("bad", rel, "missing")
            continue
        n = f.read_text(encoding="utf-8").count(PLACEHOLDER)
        if n:
            line("warn", rel, "%d placeholder(s) still to fill" % n)
        else:
            line("ok", rel)

    section("verification")
    if legacy_verify(target):
        # 손으로 쓴 스크립트가 있으면 run-lint-test.sh 가 그것을 돈다 — 옮기기 전까지 동작을 바꾸지 않는다
        r = subprocess.run(["bash", LEGACY_VERIFY], capture_output=True, cwd=target, env=QUIET_ENV())
        line("ok" if r.returncode == 0 else "bad", "%s (hand-written)" % LEGACY_VERIFY,
             "" if r.returncode == 0 else "verification does not pass yet")
        if verify_steps(cfg):
            line("warn", "%s runs instead of [commands] and [verify]" % LEGACY_VERIFY,
                 "move its checks into harness.toml, then delete it")
    else:
        r = subprocess.run(["bash", VERIFY_SCRIPT], capture_output=True, text=True, cwd=target, env=QUIET_ENV())
        if r.returncode == 0:
            line("ok", VERIFY_SCRIPT, "passes")
        elif r.returncode == VERIFY_UNSET:
            line("bad", VERIFY_SCRIPT, "not set up — no commands yet")
        else:
            m = re.search(r"^verify: FAIL (.+)$", r.stderr, re.M)
            line("bad", VERIFY_SCRIPT, "fails at %s" % m.group(1) if m else "does not pass")
    if (target / LEGACY_COMMANDS).is_file() and any(cfg["commands"].values()):
        line("warn", "%s is no longer read" % LEGACY_COMMANDS, "[commands] in harness.toml replaced it — delete the file")

    section("references")
    dr = dangling_roles(cfg, target)
    if dr:
        for name, rel, ln in dr:
            line("warn", "role `%s` is not in harness.toml" % name,
                 "still referenced at %s:%d" % (rel, ln))
    else:
        line("ok", "every role reference resolves to a configured role")
    br = broken_refs(target)
    if br:
        for rel, tok in br[:10]:
            line("warn", "`%s` does not exist" % tok, "referenced by %s" % rel)
        if len(br) > 10:
            line("warn", "%d more broken path reference(s)" % (len(br) - 10))
    else:
        line("ok", "every path a document names exists")

    section("tools and connections")
    for cli in v["FORGE_CLIS"].split():
        line("ok" if shutil.which(cli) else "bad", "forge CLI `%s`" % cli,
             "" if shutil.which(cli) else "not installed")
    for kind in dict.fromkeys([cfg["forge"]["tracker"], cfg["forge"]["review_host"]]):
        a = target / "script" / "forge" / ("%s.sh" % kind)
        if not a.is_file():
            line("bad", "adapter `%s`" % kind, "file is missing")
        elif ADAPTER_UNVERIFIED in adapter_header(a.read_text(encoding="utf-8")):
            line("warn", "adapter `%s`" % kind,
                 "unverified — run `script/forge-selftest.sh`")
        else:
            line("ok", "adapter `%s`" % kind)
    if cfg["adr"]["tool"] not in ("manual", "none"):
        t = cfg["adr"]["tool"]
        exe = ADR_EXE.get(t, t)
        line("ok" if shutil.which(exe) else "warn", "decision-record tool `%s`" % t,
             "" if shutil.which(exe) else "`%s` is not installed" % exe)

    section("registry")
    # 판정은 이 클론의 키 디렉터리로 한다. 같은 클론의 worktree 는 등록된 경로의 키가 이 루트의 키와 같다
    name, at = read_registration(registry() / clone_key(target)) or (None, None)
    if at is None:
        line("warn", "this repository is not registered", "run `harness install` to list it in the UI")
    elif Path(at).resolve() == target or clone_key(Path(at)) == clone_key(target):
        line("ok", "registered as `%s`" % (name or cfg["project"]["name"]))
    else:
        line("warn", "this clone is registered to another path", at)
    old = legacy_dir(cfg, target)
    if old is not None:
        line("warn", "state under the old name directory is not moved", "run `harness render` to move `%s`" % old)

    section("git")
    on = hooks_on(target)
    line("ok" if on else "bad", "git hooks enabled",
         "" if on else "run `git config core.hooksPath %s`" % hooks_expected(target))
    if git(target, "rev-parse", "--show-toplevel").returncode == 0:
        left = left_worktrees(cfg, target)
        for name, path in left:
            state = worktree_state(path) if os.path.isdir(path) else "missing"
            line("warn", "worktree %s" % name, {
                "uncommitted": "uncommitted changes at %s" % path,
                "unpushed": "unpushed commits at %s" % path,
                "clean": "clean at %s — rerun its workflow or remove it with `git worktree remove`" % path,
                "missing": "missing — run `git worktree prune`"}[state])
        if not left:
            line("ok", "no worktrees left")

    if remote:
        section("remote")
        remote_items(cfg, target, line)
    return items


MANAGED_SHOWN = 10


def unsafe_manifest_items(target: Path, name: str, line) -> int:
    """매니페스트 하나의 어긋난 줄을 줄 번호 순으로 몇 개만 낸다. 줄의 내용은 담지 않는다. 어긋난 줄 수를 돌려준다."""
    faults = read_manifest(target, name)[1]
    for _name, n, why in faults[:MANAGED_SHOWN]:
        line("bad", "unsafe manifest line", "%s:%d (%s)" % (name, n, why))
    if len(faults) > MANAGED_SHOWN:
        line("bad", "%d more unsafe manifest line(s)" % (len(faults) - MANAGED_SHOWN))
    return len(faults)


def managed_items(target: Path, line):
    """관리 파일과 고정 사본이 `.harness/managed` 와 맞는지. 바뀐 것은 경로 순으로 몇 개만 낸다."""
    if not (target / MANIFEST_MANAGED).is_file():
        line("warn", "no manifest of managed files", "run `harness render`")
        return
    unsafe = unsafe_manifest_items(target, MANIFEST_MANAGED, line)
    entries = manifest_entries(target)
    bad, n = managed_drift(target)
    if n and not bad and not unsafe:
        line("ok", "%d managed files match the manifest" % n)
    for rel, why in sorted(bad)[:MANAGED_SHOWN]:
        line("bad", why, rel)
    if len(bad) > MANAGED_SHOWN:
        line("bad", "%d more modified or missing managed file(s)" % (len(bad) - MANAGED_SHOWN))
    unhashed = sum(h is None for rel, h in entries if not rel.startswith(PINNED))
    if unhashed:
        line("warn", "%d managed files have no recorded hash" % unhashed, "run `harness render`")
    pinned = [h for rel, h in entries if rel.startswith(PINNED)]
    if (target / PINNED / "bin" / "harness").is_file() and (not pinned or None in pinned):
        line("warn", "the pinned copy has no recorded hash", "run `harness install`")


REMOTE_UNCHECKED = "could not check"
# 리뷰어 러너 확인은 실행기가 로그인 확인 명령을 띄우기 직전에 알린 뒤로 doctor.remote_timeout 의 이 배수만큼 기다린다.
# 실행기가 그 명령을 같은 제한 시간에 끊고 0/3/4 로 끝나므로, 하나는 그 제한 몫이고 하나는 결과를 내고 끝나는 몫이다.
RUNNER_CHECK_AFTER_START = 2
# 실행기가 로그인 확인 직전에 한 바이트를 쓰는 파일 기술자 번호를 넘기는 환경 변수
CHECK_START_FD_ENV = "HARNESS_CHECK_START_FD"


def remote_env():
    return dict(os.environ, GIT_TERMINAL_PROMPT="0", HARNESS_METRICS="off")


def remote_finish(p, argv, timeout):
    """띄운 호출을 timeout(초) 안에 끝까지 읽는다. 넘기면 그 프로세스 그룹을 죽이고 None."""
    try:
        out, err = p.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        with contextlib.suppress(OSError):
            os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        return None
    return subprocess.CompletedProcess(argv, p.returncode, out, err)


def remote_call(cfg, argv, cwd):
    """원격에 닿는 호출 하나 — 표준 입력을 닫고 제어 터미널 없이 띄운다. 자격증명 입력을 기다리며 멈추지 않는다.

    제한 시간은 doctor.remote_timeout(초)이다. 띄우지 못했거나 그 시간을 넘기면 None.
    출력은 판정에만 쓰고 결과 문구로 옮기지 않는다.
    """
    try:
        p = subprocess.Popen(argv, cwd=str(cwd), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, env=remote_env(), start_new_session=True)
    except OSError:
        return None
    return remote_finish(p, argv, cfg["doctor"]["remote_timeout"])


def close_fds(*fds, strict=False):
    """파일 기술자를 하나씩 닫는다. 닫다가 난 OS 오류는 버리고, strict 면 모두 닫은 뒤 첫 오류를 다시 낸다.

    닫기가 실패해도 그 번호는 이미 풀린 것으로 보고 다시 닫지 않는다 — 다른 곳이 그 번호를 새로 받았을 수 있다.
    """
    first = None
    for fd in fds:
        try:
            os.close(fd)
        except OSError as e:
            first = first or e
    if strict and first is not None:
        raise first


def runner_check_call(cfg, argv, cwd):
    """`run-agent.py --check` 호출 — 바깥 제한이 실행기 안의 로그인 확인보다 먼저 끝나지 않게 두 단계로 기다린다.

    실행기는 로그인 확인 명령을 띄우기 직전에 넘겨받은 파일 기술자에 한 바이트를 쓴다. 그 알림까지는
    doctor.remote_timeout 을 기다린다 — 그 전의 일(실행기 기동 · 계획 읽기)은 원격에 닿지 않는다. 알림 뒤로는
    그 제한의 RUNNER_CHECK_AFTER_START 배를 기다린다. 알림 없이 끝난 실행기(확인 명령 없음 · 실행하지 못함)는
    끝난 것을 읽는다. 어느 단계든 넘기면 None — 실행기가 제한 시간을 넘겼다고 낸 결과(4)와 같게 다룬다.
    알림 통로를 만들거나 기다리다 OS 오류가 나도 None 이다. 그 통로의 파일 기술자는 어느 경로로든 한 번씩 닫는다.
    """
    limit = cfg["doctor"]["remote_timeout"]
    try:
        rfd, wfd = os.pipe()
    except OSError:
        return None
    try:
        p = subprocess.Popen(argv, cwd=str(cwd), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True, env=dict(remote_env(), **{CHECK_START_FD_ENV: str(wfd)}),
                             pass_fds=(wfd,), start_new_session=True)
    except OSError:
        close_fds(rfd, wfd)
        return None
    started = None
    try:
        close_fds(wfd, strict=True)
        ready = select.select([rfd], [], [], limit)[0]
        started = os.read(rfd, 1) if ready else None
    except (OSError, ValueError):
        # select 는 FD_SETSIZE 를 넘는 번호를 ValueError 로 거부한다
        started = None
    finally:
        close_fds(rfd)
    if started is None:
        with contextlib.suppress(OSError):
            os.killpg(p.pid, signal.SIGKILL)
        p.communicate()
        return None
    # 빈 바이트면 알림 없이 쓰는 쪽이 닫혔다 — 실행기가 끝났다
    return remote_finish(p, argv, limit * RUNNER_CHECK_AFTER_START if started else limit)


def ls_remote(cfg, target, branches):
    """origin 의 HEAD 심볼릭 참조와 있는 브랜치 — (HEAD 가 가리키는 참조 또는 "", 있는 refs/heads/* 집합). 실패하면 None."""
    r = remote_call(cfg, ["git", "ls-remote", "--symref", "origin", "HEAD"] + ["refs/heads/%s" % b for b in branches], target)
    if r is None or r.returncode != 0:
        return None
    head, refs = "", set()
    for ln in r.stdout.splitlines():
        parts = ln.split("\t")
        if len(parts) != 2:
            return None
        if parts[0].startswith("ref: ") and parts[1] == "HEAD":
            head = parts[0][len("ref: "):]
        elif parts[1].startswith("refs/heads/"):
            refs.add(parts[1])
    return head, refs


def remote_git_items(cfg, target, line):
    """origin · base 브랜치 · 원격 기본 브랜치. origin 에 있는 refs/heads/* 집합을 돌려준다 — 모르면 빈 집합."""
    base = cfg["branches"]["base"]
    if git(target, "rev-parse", "--is-inside-work-tree").stdout.strip() != "true":
        line("bad", "remote `origin`", "not a git repository")
        return set()
    if git(target, "remote", "get-url", "origin").returncode != 0:
        line("bad", "remote `origin`", "not set — run `git remote add origin <url>`")
        return set()
    line("ok", "remote `origin`")
    branches = list(dict.fromkeys([base] + list(cfg["branches"]["protected"])))
    ls = ls_remote(cfg, target, branches)
    failed = "%s — git ls-remote failed" % REMOTE_UNCHECKED
    if ls is None:
        line("warn", "branch `%s` on origin" % base, failed)
        line("warn", "origin default branch", failed)
        return set()
    head, refs = ls
    if "refs/heads/%s" % base in refs:
        line("ok", "branch `%s` on origin" % base)
    else:
        line("bad", "branch `%s` on origin" % base, "missing — run `git push origin %s`" % base)
    if head == "refs/heads/%s" % base:
        line("ok", "origin default branch", "`%s`" % base)
    elif head.startswith("refs/heads/"):
        line("warn", "origin default branch", "is `%s`, not branches.base `%s` — new clones and review requests start from it"
             % (head[len("refs/heads/"):], base))
    else:
        line("warn", "origin default branch", "%s — origin does not report it" % REMOTE_UNCHECKED)
    return refs


def forge_call(cfg, target, fn, *a):
    """forge 어댑터 함수 하나를 원격 호출 규칙으로 부른다. forge CLI 를 직접 부르지 않는다."""
    return remote_call(cfg, ["sh", "-c", '. ./script/forge.sh && "$@"', "sh", fn, *a], target)


def remote_forge_items(cfg, target, line, refs):
    """forge 로그인 · 트래커 라벨 · 원격 브랜치 보호. 로그인되지 않은 종류는 그 뒤 항목을 내지 않는다."""
    tracker, host = cfg["forge"]["tracker"], cfg["forge"]["review_host"]
    signed = set()
    for kind in dict.fromkeys([tracker, host]):
        if not shutil.which(FORGE_CLI.get(kind, kind)):
            continue
        r = forge_call(cfg, target, "tracker_auth" if kind == tracker else "review_auth")
        what = "sign-in to `%s`" % kind
        if r is not None and r.returncode == 0:
            line("ok", what)
            signed.add(kind)
        elif r is not None and r.returncode == 1:
            hint = (r.stderr.strip().splitlines() or [""])[0]
            line("bad", what, "not signed in — %s" % hint if hint else "not signed in")
        else:
            line("warn", what, REMOTE_UNCHECKED)
    if tracker in signed:
        wanted = list(dict.fromkeys(l for l in cfg["issues"]["labels"].values() if l))
        r = forge_call(cfg, target, "tracker_labels") if wanted else None
        if wanted and not (r is not None and r.returncode == 3):
            have = None
            if r is not None and r.returncode == 0:
                with contextlib.suppress(ValueError):
                    v = json.loads(r.stdout)
                    if isinstance(v, list) and all(isinstance(x, str) for x in v):
                        have = {x.lower() for x in v}
            if have is None:
                line("warn", "labels", REMOTE_UNCHECKED)
            else:
                for l in wanted:
                    if l.lower() in have:
                        line("ok", "label `%s`" % l, "on %s" % tracker)
                    else:
                        line("warn", "label `%s`" % l, "missing on %s — create it on the forge" % tracker)
    if host in signed:
        for b in dict.fromkeys(cfg["branches"]["protected"]):
            if "refs/heads/%s" % b not in refs:
                continue
            r = forge_call(cfg, target, "review_branch_protected", b)
            out = r.stdout.strip() if r is not None and r.returncode == 0 else None
            what = "branch protection `%s`" % b
            if out == "true":
                line("ok", what, "protected on %s" % host)
            elif out == "false":
                line("warn", what, "not protected on %s — only local hooks block direct pushes; protect it on the forge" % host)
            else:
                line("warn", what, REMOTE_UNCHECKED)


def remote_items(cfg, target, line):
    """원격 준비 상태를 읽기만 한다. 원격 URL 과 명령 출력은 결과에 옮기지 않는다."""
    refs = remote_git_items(cfg, target, line)
    remote_forge_items(cfg, target, line, refs)
    remote_reviewer_items(cfg, target, line)


REVIEWER = "code-reviewer"


def remote_reviewer_items(cfg, target, line):
    """리뷰어가 CLI 러너면 그 러너의 설치·로그인을 `run-agent.py --check` 로 본다. 러너의 출력은 옮기지 않는다."""
    p = run_plan(cfg)["roles"].get(REVIEWER) if REVIEWER in cfg["roles"] else None
    if not p or p["via"] != "headless":
        return
    what = "reviewer runner `%s`" % p["vendor"]
    runner = target / RUN_AGENT
    if not runner.is_file():
        line("bad", what, "`%s` is missing — run `harness render`" % RUN_AGENT)
        return
    r = runner_check_call(cfg, [sys.executable, str(runner), REVIEWER, "--check"], target)
    out = r.stdout.strip() if r is not None else ""
    if r is not None and r.returncode == 0 and out == "signed-in":
        line("ok", what, "signed in")
    elif r is not None and r.returncode == 0 and out == "unchecked":
        line("ok", what, "installed — sign-in is not checked for %s" % VENDORS[p["vendor"]]["name"])
    elif r is not None and r.returncode == 2:
        first = (r.stderr.strip().splitlines() or [""])[0]
        line("bad", what, first[len("error: "):] if first.startswith("error: ") else first)
    elif r is not None and r.returncode == 3:
        line("bad", what, "not signed in — `%s` fails" % " ".join(p.get("auth_check") or []))
    else:
        line("warn", what, REMOTE_UNCHECKED)


def doctor_counts(items):
    return (sum(i["state"] == "bad" for i in items), sum(i["state"] == "warn" for i in items))


def doctor_json(items):
    bad, warn = doctor_counts(items)
    return {"bad": bad, "warn": warn, "items": items}


def doctor_text(items):
    """항목 목록을 절마다 그린다. 항목이 없는 절은 제목도 없다."""
    mark = {"ok": "  ok  ", "warn": "  warn", "bad": "  FAIL"}
    sec = None
    for i in items:
        if i["section"] != sec:
            print(("\n" if sec is not None else "") + i["section"])
            sec = i["section"]
        print("%s %s%s" % (mark[i["state"]], i["what"], ("  — " + i["detail"]) if i["detail"] else ""))


def cmd_doctor(cfg, target, args):
    """쓸 준비가 됐는지 보고한다. 종료 코드는 실패 항목이 있으면 1 — 텍스트든 JSON 이든 같다."""
    remote = getattr(args, "remote", False)
    items = doctor_items(cfg, target, remote)
    bad, warn = doctor_counts(items)
    if getattr(args, "json", False):
        print(json.dumps(doctor_json(items), ensure_ascii=False, indent=2))
        return 1 if bad else 0
    doctor_text(items)
    print()
    if not remote:
        print("remote checks not run — use `harness doctor --remote`")
    sys.stdout.flush()
    if bad:
        print("%d failing · %d warning — not ready to use" % (bad, warn))
        return 1
    if warn:
        print("%d warning(s) — usable, with open items" % warn)
        return 0
    print("all checks passed — ready to use")
    return 0


# 설정에 넣을 수 있는 값의 형태. TOML 을 다시 쓰지 않고 그 줄만 바꾼다.
def toml_value(raw: str) -> str:
    if raw in ("true", "false"):
        return raw
    if re.fullmatch(r"-?[0-9]+", raw):
        return raw
    if raw.startswith("["):   # JSON 배열 — 원소가 하나인 목록과 빈 목록도 적을 수 있다
        try:
            return json.dumps([str(x) for x in json.loads(raw)], ensure_ascii=False).replace('","', '", "')
        except (ValueError, TypeError):
            die("error: %r is not a JSON array of strings" % raw)
    if "," in raw:
        return "[%s]" % ", ".join('"%s"' % x.strip() for x in raw.split(",") if x.strip())
    return '"%s"' % raw


def set_line(lines: list, dotted: str, raw: str, where: Path):
    """설정 줄 목록에서 값 하나를 바꾼다. (바꾸기 전, 바꾼 뒤) 를 돌려준다."""
    if "." not in dotted:
        die("error: key must be `<section>.<name>` (got %r)" % dotted)
    section, key = dotted.rsplit(".", 1)
    want = "[%s]" % section
    inside = False
    hit = None
    for i, ln in enumerate(lines):
        st = ln.strip()
        if st.startswith("[") and st.endswith("]"):
            inside = st == want
            continue
        if inside and re.match(r"%s\s*=" % re.escape(key), st):
            hit = i
            break
    command = section == "commands" and key in {k for k, _ in COMMAND_KEYS}
    # 기본값이 있는 절(권한 · 준비 점검)은 옛 설정에 없을 수 있다
    defaulted = (section == "permissions" and key in PERMISSIONS_DEFAULTS
                 or section == "doctor" and key in DOCTOR_DEFAULTS
                 or section == "verify" and key in VERIFY_DEFAULTS
                 or section == "forge" and key in FORGE_DEFAULTS)
    if hit is None and (command or defaulted) and not any(ln.strip() == want for ln in lines):
        lines += ["\n" if lines and lines[-1].strip() else "", "%s\n" % want]   # 옛 설정에는 절이 없다
    if hit is None and (re.fullmatch(r"roles\.[\w-]+", section) and key in OPTIONAL_ROLE_KEYS
                        or dotted == "harness.model" or command or defaulted):
        # 선택 키는 적지 않아도 되는 값이라(옛 설정에 없다), 처음 정할 때는 그 절 끝에 한 줄을 더한다
        head = next((i for i, ln in enumerate(lines) if ln.strip() == want), None)
        if head is not None:
            end = head + 1
            while end < len(lines) and not lines[end].strip().startswith("["):
                end += 1
            while end > head + 1 and not lines[end - 1].strip():
                end -= 1
            lines.insert(end, "%s = \"\"\n" % key)
            hit = end
    if hit is None:
        die("error: no such key `%s` in the config\n  --> %s\n\nhelp: open the file and check the section and key name" % (dotted, where))

    # 여러 줄에 걸친 배열이면 닫는 `]` 까지가 그 값이다. 첫 줄만 바꾸면 나머지 줄이 떠서 설정이 깨진다.
    end = hit + 1
    if lines[hit].split("=", 1)[1].strip().startswith("[") and "]" not in lines[hit].split("#", 1)[0]:
        while end < len(lines) and lines[end].split("#", 1)[0].strip() != "]":
            end += 1
        end += 1
    before = " ".join(ln.strip() for ln in lines[hit:end] if not ln.strip().startswith("#"))
    # 명령은 언제나 문자열이다 — 쉼표·따옴표가 든 셸 명령을 배열이나 깨진 TOML 로 만들지 않는다
    value = json.dumps(raw, ensure_ascii=False) if command else toml_value(raw)
    lines[hit:end] = ["%s = %s\n" % (key, value)]
    return before, lines[hit].strip()


def revert_for_user_files(cfg, target: Path, args, conf: Path, original: str) -> bool:
    """바꾼 설정의 render 가 경로 규칙의 사전 판정이나 사용자 파일로 멈출 것이면 설정을 되돌리고 True."""
    if not refuse_changes(cfg, target, args):
        return False
    conf.write_text(original, encoding="utf-8")
    print("\nreverted — the config is unchanged", file=sys.stderr)
    return True


def cmd_set(_cfg, target, args):
    """`harness set <절.키> <값> [<절.키> <값> ...]` — 설정을 바꾸고 다시 렌더한다.

    사람이 TOML 을 직접 고쳐도 되지만, 고친 뒤 render 를 잊으면 검사가 커밋을 막는다.
    한 명령으로 묶어 그 사이가 벌어지지 않게 한다.

    **여러 쌍은 한꺼번에 바꾸고 한 번 검증한다.** 불변식이 두 값에 걸치면(구현·리뷰 러너 분리) 하나씩
    바꾸는 어느 순서도 중간 상태에서 거부된다 — 오케스트레이터와 리뷰어를 맞바꿀 때가 그렇다.
    """
    if not args.args or len(args.args) % 2:
        die("usage: harness set <section.key> <value> [<section.key> <value> ...]\n\n"
            "example: harness set branches.base develop\n"
            "         harness set harness.orchestrator codex roles.code-reviewer.runner claude")
    p = target / "harness.toml"
    original = p.read_text(encoding="utf-8")
    lines = original.splitlines(keepends=True)
    changes = [set_line(lines, args.args[i], args.args[i + 1], p) for i in range(0, len(args.args), 2)]
    if refuse_unsafe_manifest(target, "set"):
        return 2
    p.write_text("".join(lines), encoding="utf-8")

    # 바꾼 값이 성립하지 않으면 되돌린다. 깨진 설정을 남기면 다음 명령이 전부 막힌다.
    try:
        cfg = load(target)
        normalize(cfg)
        validate(cfg)
    except SystemExit:
        p.write_text(original, encoding="utf-8")
        print("\nreverted — the config is unchanged", file=sys.stderr)
        return 2
    if revert_for_user_files(cfg, target, args, p, original):
        return 2

    for before, after in changes:
        print("set: %s" % before)
        print("  to %s" % after)
    return cmd_render(cfg, target, args)


# 프로젝트 문서의 원형. write-doc 이 받는 문서 이름과 schema 의 `docs` 가 여기서 나온다.
OWNED_DOCS = TEMPLATES / "owned" / ".ai" / "project"
PROJECT_DOCS = ".ai/project"
# 메모 머리의 안내 주석. 사람에게 하는 말이라 render 가 생성물에 옮길 때 뺀다.
NOTE_HEADS = {
    "roles": "<!--\n이 파일은 프로젝트가 소유한다. 하네스 갱신이 덮지 않는다.\n"
             "`harness render` 가 이 본문을 이 역할의 에이전트 정의 끝(\"이 프로젝트에서\")에 붙인다.\n-->\n\n",
    "workflows": "<!--\n이 파일은 프로젝트가 소유한다. 하네스 갱신이 덮지 않는다.\n"
                 "`harness render` 가 이 본문을 이 절차 끝(\"이 프로젝트에서\")에 붙인다.\n-->\n\n",
}


def project_docs() -> list:
    """프로젝트 문서 이름 — 하네스 원형의 `.ai/project/*.md`. 명령은 문서가 아니라 설정의 `[commands]` 다."""
    return sorted(p.stem for p in OWNED_DOCS.glob("*.md") if p.is_file() and p.stem != "commands")


def writable_docs(cfg: dict) -> dict:
    """write-doc 이 받는 이름 → 쓰는 경로(하네스 루트 기준). 문서, 설정의 역할 메모, 설정의 절차 메모."""
    out = {d: "%s/%s.md" % (PROJECT_DOCS, d) for d in project_docs()}
    out.update(("roles/%s" % n, "%s/%s.md" % (ROLE_NOTES, n)) for n in sorted(cfg["roles"]))
    out.update(("workflows/%s" % w, "%s/%s.md" % (WORKFLOW_NOTES, w)) for w in sorted(cfg["workflows"]))
    return out


def note_body(name: str, text: str) -> str:
    """쓸 본문. 메모는 공백뿐이면 비우고, 안내 주석으로 시작하지 않으면 머리 주석을 붙인다. 끝은 줄바꿈 하나 이상."""
    kind = name.split("/", 1)[0] if "/" in name else None
    if kind in NOTE_HEADS:
        if not text.strip():
            text = ""
        elif not text.lstrip().startswith("<!--"):
            text = NOTE_HEADS[kind] + text
    return text if text.endswith("\n") else text + "\n"


def cmd_write_doc(cfg, target, args):
    """`harness write-doc <이름> -` — 표준 입력의 본문을 프로젝트 문서나 역할·절차 메모에 쓰고 render 한다.

    경로를 입력에서 만들지 않는다. 이름을 받는 목록과 문자열로 비교하고 맞는 항목의 경로를 쓴다.
    render 가 실패하면 문서를 쓰기 전으로 되돌린다 — 생성물과 어긋난 문서를 남기지 않는다.
    """
    names = writable_docs(cfg)
    if len(args.args) != 2 or args.args[1] != "-":
        die("error: write-doc reads the document from standard input\n\n"
            "usage: harness write-doc <name> -\n"
            "example: printf '...' | harness write-doc stack -")
    name = args.args[0]
    rel = names.get(name)
    if rel is None:
        docs = [n for n in names if "/" not in n]
        notes = [n for n in names if "/" in n]
        die("error: unknown document `%s`\n  --> write-doc\n\n"
            "help: write-doc takes one of these names\n        %s\n        %s"
            % (name, ", ".join(docs), ", ".join(notes)))
    try:
        text = sys.stdin.buffer.read().decode("utf-8")
    except UnicodeDecodeError:
        die("error: standard input is not UTF-8\n  --> %s\n\nnothing was written" % rel)
    body = note_body(name, text)

    p = guarded_path(target, rel, "write")
    if p.is_dir():
        die("error: the document path is a directory\n  --> %s\n\nnothing was written" % rel)
    before = p.read_bytes() if p.is_file() else None
    made = [d.as_posix() for d in reversed(p.relative_to(target).parents) if str(d) != "." and not (target / d).exists()]

    out = io.StringIO()
    rc = 2
    # 쓰기부터 render 까지 한 구역이다 — 어디서 실패하든 아래에서 쓰기 전 상태로 되돌린다
    try:
        make_parents(target, rel)
        p.write_text(body, encoding="utf-8")
        with contextlib.redirect_stdout(out):
            # 사용자 파일로 멈추면 안내가 넘겨받는 명령으로 render 를 가리킨다 — write-doc 은 넘겨받지 않는다
            rc = cmd_render(cfg, target, argparse.Namespace(command="render", adopt=False))
    except SystemExit as e:
        rc = e.code if isinstance(e.code, int) and e.code else 2
        if not isinstance(e.code, int) and e.code:
            print(e.code, file=sys.stderr)
    except Exception as e:   # 디코딩 오류처럼 예상하지 못한 실패도 문서를 남기지 않는다
        rc = 2
        print("error: write-doc failed: %s" % e, file=sys.stderr)
    if rc != 0:
        sys.stdout.write(out.getvalue())
        # 쓰기 자체가 실패했으면 문서는 그대로다 — 내용이 달라졌을 때만 되돌린다. 되돌리기가 실패해도 안내하고 2 다
        try:
            if before is None:
                if os.path.lexists(p):
                    guarded_path(target, rel, "remove").unlink()
                for d in reversed(made):
                    with contextlib.suppress(OSError):
                        guarded_path(target, d, "remove").rmdir()
            elif p.read_bytes() != before:
                guarded_path(target, rel, "write").write_bytes(before)
        except OSError as e:
            print("\nerror: could not restore the document: %s\n  --> %s\n\nhelp: check the file by hand" % (e, rel),
                  file=sys.stderr)
            return 2
        print("\nreverted — the document is unchanged", file=sys.stderr)
        return 2
    print("write-doc: %s" % rel)
    sys.stdout.write(out.getvalue())
    return 0


ISSUE_NO = re.compile(r"[0-9]{1,10}")


def git(cwd, *a):
    """cwd 에서 돈 git 의 결과. git 을 띄우지 못하면(없는 디렉터리 포함) 실패한 결과로 돌려준다."""
    try:
        return subprocess.run(["git", *a], cwd=str(cwd), capture_output=True, text=True)
    except OSError as e:
        return subprocess.CompletedProcess(["git", *a], 127, "", str(e))


def worktree_state(path) -> str:
    """작업 트리를 남길 이유 — 미커밋 변경이면 `uncommitted`, 미push 커밋이면 `unpushed`, 없으면 `clean`.

    git 이 답하지 못하면 남기는 쪽으로 본다. 지우는 쪽으로 틀리면 작업이 사라진다.
    """
    r = git(path, "status", "--porcelain")
    if r.returncode != 0 or r.stdout.strip():
        return "uncommitted"
    r = git(path, "rev-list", "--count", "HEAD", "--not", "--remotes")
    if r.returncode != 0 or not r.stdout.strip().isdigit() or int(r.stdout.strip()) > 0:
        return "unpushed"
    return "clean"


def git_common_dir(path):
    """path 가 속한 리포의 git 공통 디렉터리를 실제 경로로 푼 것. git 트리가 아니면 None."""
    r = git(path, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return os.path.realpath(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip() else None


def own_worktree(path, common) -> bool:
    """path 가 이 리포(공통 디렉터리 common)의 worktree 최상위인가. 둘러싼 다른 리포를 잡지 않는다."""
    r = git(path, "rev-parse", "--show-toplevel")
    return (r.returncode == 0 and os.path.realpath(r.stdout.strip()) == os.path.realpath(path)
            and git_common_dir(path) == common)


def registered_worktrees(top):
    """git 에 등록된 worktree 경로 목록 (실제 경로로 푼 것)."""
    r = git(top, "worktree", "list", "--porcelain")
    return [os.path.realpath(ln[len("worktree "):]) for ln in r.stdout.splitlines() if ln.startswith("worktree ")]


def left_worktrees(cfg, target):
    """worktree.dir 바로 아래에 등록된 이 리포의 worktree — (이름, 경로). 경로가 지워진 것도 든다."""
    d = worktree_dir(cfg, target)
    if not os.path.isabs(d):
        return []
    real = os.path.realpath(d)
    return sorted((os.path.basename(w), os.path.join(d, os.path.basename(w)))
                  for w in registered_worktrees(target) if os.path.dirname(w) == real)


def issue_worktree(cfg, target, issue):
    """이슈 worktree 의 자리와 여는 방식. 멈춰야 하면 종료 코드를 돌려준다.

    아무것도 바꾸지 않는다 — 판정만 한다.
    """
    if not ISSUE_NO.fullmatch(issue):
        die("error: --worktree needs an issue number (got %s)" % issue)
    r = git(target, "rev-parse", "--show-toplevel")
    if r.returncode != 0:
        die("error: --worktree needs the harness root inside a git repository (%s)" % target)
    top = os.path.realpath(r.stdout.strip())
    prefix = git(target, "rev-parse", "--show-prefix").stdout.strip()
    d = worktree_dir(cfg, target)
    real = os.path.realpath(d) if os.path.isabs(d) else ""
    if not real or real == top or real.startswith(top.rstrip("/") + "/"):
        die("error: worktree.dir must be an absolute path outside the repository (got %s)\n\n"
            "help: harness set worktree.dir <directory outside %s>" % (d, top))
    path = os.path.join(d, issue)
    common = git_common_dir(target)
    if not os.path.lexists(path) or (os.path.isdir(path) and not os.path.islink(path) and not os.listdir(path)):
        new = True
    elif os.path.isdir(path) and own_worktree(path, common):
        new = False
        st = git(path, "status", "--short")
        if st.returncode != 0 or st.stdout.strip():
            print("stop: worktree %s has uncommitted changes — nothing was launched" % path, file=sys.stderr)
            print(st.stdout.rstrip() or st.stderr.rstrip(), file=sys.stderr)
            print("\nhelp: finish or discard them in that worktree, then rerun", file=sys.stderr)
            return 1
    else:
        print("error: %s is not a worktree of this repository\n\n"
              "help: another clone may share worktree.dir — put {clone} in worktree.dir or move that directory" % path,
              file=sys.stderr)
        return 2
    return {"path": path, "top": top, "new": new, "run_dir": os.path.join(path, prefix) if prefix else path}


def open_worktree(cfg, wt) -> int:
    """새 worktree 를 원격 통합 브랜치의 분리된 HEAD 로 만든다. 실패하면 git 의 출력을 그대로 보인다."""
    top, path, base = wt["top"], wt["path"], cfg["branches"]["base"]
    if not os.path.lexists(path) and os.path.realpath(path) in registered_worktrees(top):
        git(top, "worktree", "prune")   # 디렉터리가 지워지고 등록만 남은 것
    os.makedirs(os.path.dirname(path), exist_ok=True)
    for a in (("fetch", "origin", base), ("worktree", "add", "--detach", path, "origin/%s" % base)):
        r = git(top, *a)
        if r.returncode != 0:
            sys.stderr.write(r.stdout + r.stderr)
            print("error: git %s failed — nothing was launched" % a[0], file=sys.stderr)
            return 2
    return 0


def copy_include(cfg, target, wt):
    """새 worktree 에 하네스 루트의 로컬 파일을 복사한다. git 이 무시하는 경로만 — 복사한 것이 커밋에 끌려들지 않는다.

    복사한 경로는 출력하지 않는다. 개인 설정이나 로컬 자격증명일 수 있다.
    """
    run = wt["run_dir"]
    for rel in cfg["worktree"]["include"]:
        src = target / rel
        if not os.path.lexists(src):
            continue
        if git(run, "ls-files", "--error-unmatch", "--", rel).returncode == 0:
            continue   # checkout 이 이미 갖고 있다
        probe = rel.rstrip("/") + ("/" if src.is_dir() and not src.is_symlink() else "")
        if git(run, "check-ignore", "-q", "--", probe).returncode != 0:
            print("warn: %s is not ignored by git — not copied" % rel, file=sys.stderr)
            continue
        dst = Path(run) / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        if src.is_symlink():
            if os.path.lexists(dst):
                dst.unlink()
            os.symlink(os.readlink(src), dst)
        elif src.is_dir():
            shutil.copytree(src, dst, symlinks=True, dirs_exist_ok=True)
        else:
            shutil.copy2(src, dst, follow_symlinks=False)


def close_worktree(wt):
    """오케스트레이터가 끝난 worktree 를 정리한다. 미커밋 변경·미push 커밋이 있으면 남긴다."""
    path = wt["path"]
    state = worktree_state(path)
    if state == "uncommitted":
        print("kept worktree %s — uncommitted changes" % path)
    elif state == "unpushed":
        print("kept worktree %s — unpushed commits" % path)
    else:
        r = git(wt["top"], "worktree", "remove", path)
        if r.returncode == 0:
            print("removed worktree %s" % path)
        else:
            print("warn: could not remove worktree %s" % path, file=sys.stderr)
            sys.stderr.write(r.stdout + r.stderr)


def cmd_run(cfg, target, args):
    """`harness run <워크플로> <이슈> [--worktree]` — 설정된 오케스트레이터로 절차를 시작한다.

    절차는 사람이 승인하는 지점에서 멈추므로 **대화형으로 띄운다.** 비대화형으로 돌리면
    그 게이트가 통과된 것처럼 지나간다.
    """
    if len(args.args) != 2:
        die("usage: harness run <workflow> <issue> [--worktree]\n\nexample: harness run work 12")
    name, issue = args.args
    wf = target / ".ai" / "workflows" / ("%s.md" % name)
    if not wf.is_file():
        avail = sorted(p.stem for p in (target / ".ai" / "workflows").glob("*.md"))
        die("error: no such workflow `%s` (available: %s)"
            % (name, ", ".join(avail) or "none"))

    who = cfg["harness"]["orchestrator"]
    # 슬래시 커맨드가 없는 오케스트레이터는 {prompt} 로 절차 파일을 가리킨다
    cmd = expand(VENDORS[who]["launch"], {"workflow": name, "issue": issue,
                 "model": model_args(VENDORS[who], cfg["harness"]["model"]), "prompt":
                 "이 리포의 .ai/workflows/%s.md 절차를 이슈 %s 에 대해 수행한다. "
                 "그 파일을 먼저 읽고 그대로 따른다. 규칙 정본은 .ai/AI_AGENT.md 다. "
                 "사람이 승인하는 지점에서는 멈추고 묻는다." % (name, issue)})
    if not shutil.which(cmd[0]):
        die("error: orchestrator `%s` is not installed\n\nhelp: install it, or point harness.orchestrator at one you have\n        harness set harness.orchestrator <claude|codex>" % cmd[0])
    wt = issue_worktree(cfg, target, issue) if args.worktree else None
    if isinstance(wt, int):
        return wt
    if args.dry_run:
        if wt:
            print("worktree: %s (%s)" % (wt["path"], "new" if wt["new"] else "reopened"))
            print("directory: %s" % wt["run_dir"])
        print(" ".join(repr(c) if " " in c else c for c in cmd))
        return 0
    if wt and wt["new"]:
        code = open_worktree(cfg, wt)
        if code:
            return code
    if wt and not os.path.isdir(wt["run_dir"]):
        print("error: %s is not in the worktree — commit the harness to %s first"
              % (wt["run_dir"], cfg["branches"]["base"]), file=sys.stderr)
        close_worktree(wt)
        return 2
    if wt and wt["new"]:
        copy_include(cfg, target, wt)
    if wt:
        print("worktree: %s (%s)" % (wt["path"], "new" if wt["new"] else "reopened"), flush=True)
    os.chdir(wt["run_dir"] if wt else target)
    # 이 실행 하나가 트레이스다. 시작 기록이 곧 run manifest 다 — 세션 가져오기가 이 시각·벤더·절차로
    # 대화 기록을 이 실행에 붙인다. 대화형으로 끝날 때까지 기다려 끝 기록도 남긴다
    m = metrics_module().load_metric(target)
    attrs = {"workflow": name, "vendor": who, **({"issue": issue} if issue.isdigit() else {}),
             **({"worktree": issue} if wt else {}),
             **({"model": cfg["harness"]["model"]} if cfg["harness"]["model"] else {})}
    trace, span = m.start("run/%s" % name, "command", attrs, source="runner") if m else ("", "")
    env = dict(os.environ, HARNESS_WORKFLOW=name, **({"HARNESS_TRACE_ID": trace, "HARNESS_PARENT_SPAN": span} if m else {}))
    t0 = time.monotonic()
    try:
        code = subprocess.call(cmd, env=env)
    except KeyboardInterrupt:
        code = 130
    if m:
        m.end(span, "ok" if code == 0 else "error", code, (time.monotonic() - t0) * 1000)
    if wt:
        os.chdir(target)
        close_worktree(wt)
    return code


def steps_block(wf: str, steps: list, title: str = None) -> str:
    """단계 목록을 한 단계 한 줄의 TOML 로. 문자열은 JSON 인용 — TOML 기본 문자열과 같은 규칙이다."""
    rows = ["  { %s },\n" % ", ".join("%s = %s" % (k, json.dumps(str(st[k]), ensure_ascii=False))
                                       for k in ("id", "type", "title", "role", "run", "text")
                                       if str(st.get(k, "")).strip())
            for st in steps]
    head = "title = %s\n" % json.dumps(title, ensure_ascii=False) if title else ""
    return "[workflows.%s]\n%ssteps = [\n%s]\n" % (wf, head, "".join(rows))


def workflow_span(lines: list, wf: str):
    """설정에서 `[workflows.<절차>]` 절이 차지하는 줄 범위."""
    return section_span(lines, "[workflows.%s]" % wf)


def section_span(lines: list, head: str):
    """설정에서 한 절이 차지하는 줄 범위. 다음 절의 머리 주석은 그 절의 것이라 넣지 않는다."""
    at = next((i for i, ln in enumerate(lines) if ln.strip() == head), None)
    if at is None:
        return None
    end = at + 1
    while end < len(lines) and not lines[end].lstrip().startswith("["):
        end += 1
    while end > at + 1 and (not lines[end - 1].strip() or lines[end - 1].lstrip().startswith("#")):
        end -= 1
    return at, end


def refuse_notes_rename(target: Path, wf: str, new: str) -> bool:
    """절차 이름을 바꾸기 전에 절차별 지시 문서의 두 경로를 본다. 멈춰야 하면 안내문을 내고 True.

    두 경로에 링크 성분이 있거나, 새 이름 자리에 무엇이든 있으면 멈춘다 — 옮기기가 그 자리를 덮지 않게 한다.
    """
    old_rel, new_rel = ("%s/%s.md" % (WORKFLOW_NOTES, n) for n in (wf, new))
    if refuse_unsafe_paths(target, {old_rel: "move", new_rel: "move"}, "steps"):
        return True
    if not os.path.lexists(target / new_rel):
        return False
    print("error: cannot rename the workflow notes — a file is already at the new name\n"
          "  --> %s\n"
          "nothing was changed\n\n"
          "help: move that file aside or merge it into the old notes, then rename again\n"
          "        harness steps %s --rename %s" % (new_rel, wf, new), file=sys.stderr)
    return True


def rename_or_delete_workflow(cfg, target, args):
    """`harness steps <절차> --rename <새이름>` · `harness steps <절차> --delete` — 이 프로젝트가 만든 절차만.

    하네스 기본 절차는 본문 조각이 이름에 묶여 있어 이름을 바꿀 수 없고, 지워도 기본값으로 돌아온다.
    절차별 지시(`.ai/project/workflows/<절차>.md`)는 이름을 바꾸면 따라가고, 지우면 남긴다 — 사람이 쓴 것이다.
    """
    if len(args.args) != 1:
        die("usage: harness steps <workflow> --rename <new-name> | --delete")
    wf = args.args[0]
    if wf not in cfg["workflows"]:
        die("error: no workflow `%s`" % wf)
    if fragment(wf, "_head") is not None:
        die("error: `%s` is a harness workflow — only workflows this project made can be renamed or deleted" % wf)
    p = target / "harness.toml"
    original = p.read_text(encoding="utf-8")
    lines = original.splitlines(keepends=True)
    span = workflow_span(lines, wf)
    if span is None:
        die("error: `[workflows.%s]` is not in the config file" % wf)
    at, end = span
    new = args.rename
    if new:
        if new in cfg["workflows"]:
            die("error: a workflow `%s` already exists" % new)
        lines[at] = "[workflows.%s]\n" % new
    else:
        del lines[at:end]
        while at < len(lines) and at > 0 and not lines[at].strip() and not lines[at - 1].strip():
            del lines[at]   # 지운 자리에 빈 줄이 겹치지 않게
    if refuse_unsafe_manifest(target, "steps"):
        return 2
    if new and refuse_notes_rename(target, wf, new):
        return 2
    p.write_text("".join(lines), encoding="utf-8")
    try:
        cfg = load(target)
        normalize(cfg)
        validate(cfg)
        plan(cfg, target)
    except SystemExit:
        p.write_text(original, encoding="utf-8")
        print("\nreverted — the config is unchanged", file=sys.stderr)
        return 2
    if revert_for_user_files(cfg, target, args, p, original):
        return 2
    notes = target / WORKFLOW_NOTES / ("%s.md" % wf)
    if new and notes.is_file():
        os.rename(guarded_path(target, "%s/%s.md" % (WORKFLOW_NOTES, wf), "move"),
                  guarded_path(target, "%s/%s.md" % (WORKFLOW_NOTES, new), "move"))
    print("steps: workflows.%s %s" % (wf, ("renamed to %s" % new) if new else "deleted"))
    if not new and notes.is_file():
        print("note: %s is kept — it is yours" % notes.relative_to(target))
    return cmd_render(cfg, target, args)


def cmd_steps(cfg, target, args):
    """`harness steps` — 절차의 단계를 JSON 으로 낸다.
    `harness steps <절차> <JSON>` — 그 절차의 단계를 통째로 바꾸고 렌더한다. 성립하지 않으면 되돌린다.

    `set` 은 한 줄짜리 값만 다룬다. 단계 목록은 표의 배열이라 따로 둔다.
    """
    if not args.args:
        # body 는 기본 본문 조각 원문이다 — 단계 참조(`{{step:<id>}}`)가 풀리지 않은 채로 나간다.
        print(json.dumps({wf: [dict(st, builtin=fragment(wf, st["id"]) is not None,
                                    body=fragment(wf, st["id"]) or "")
                               for st in body["steps"]]
                          for wf, body in cfg["workflows"].items()}, ensure_ascii=False, indent=2))
        return 0
    if args.delete or args.rename:
        return rename_or_delete_workflow(cfg, target, args)
    if len(args.args) != 2:
        die("usage: harness steps [<workflow> <json>]\n\nexample: harness steps work '[{\"id\":\"implement\",...}]'")
    wf, raw = args.args
    try:
        data = json.loads(raw)
        steps = data["steps"] if isinstance(data, dict) else data
        title = data.get("title") if isinstance(data, dict) else cfg["workflows"].get(wf, {}).get("title")
        assert isinstance(steps, list) and all(isinstance(x, dict) for x in steps)
    except (ValueError, AssertionError, KeyError):
        die("error: steps must be a JSON array of objects, or {\"title\": ..., \"steps\": [...]}")

    if args.dry_run:
        # 설정을 쓰지 않고 같은 검사만 돈다. UI 가 편집 중에 부른다.
        cfg["workflows"][wf] = {"steps": steps, **({"title": title} if title else {})}
        validate(cfg)
        plan(cfg, target)
        print("steps: workflows.%s — %d steps are valid" % (wf, len(steps)))
        return 0

    p = target / "harness.toml"
    original = p.read_text(encoding="utf-8")
    block = steps_block(wf, steps, title)
    lines = original.splitlines(keepends=True)
    head = "[workflows.%s]" % wf
    at = next((i for i, ln in enumerate(lines) if ln.strip() == head), None)
    if at is None:
        text = original.rstrip("\n") + "\n\n" + block
    else:
        end = at + 1
        while end < len(lines) and not lines[end].lstrip().startswith("["):
            end += 1
        while end > at + 1 and (not lines[end - 1].strip() or lines[end - 1].lstrip().startswith("#")):
            end -= 1   # 다음 절의 머리 주석은 그 절의 것이다
        text = "".join(lines[:at]) + block + "".join(lines[end:])
    if refuse_unsafe_manifest(target, "steps"):
        return 2
    p.write_text(text, encoding="utf-8")
    try:
        cfg = load(target)
        normalize(cfg)
        validate(cfg)
        plan(cfg, target)   # 끊긴 단계 참조는 생성할 때 드러난다
    except SystemExit:
        p.write_text(original, encoding="utf-8")
        print("\nreverted — the config is unchanged", file=sys.stderr)
        return 2
    if revert_for_user_files(cfg, target, args, p, original):
        return 2
    print("steps: workflows.%s — %d steps" % (wf, len(steps)))
    return cmd_render(cfg, target, args)


def cmd_checks(cfg, target, args):
    """`harness checks` — 검증 검사를 JSON 으로 낸다.
    `harness checks <JSON>` — `[verify]` 의 검사 목록을 통째로 바꾸고 렌더한다. 성립하지 않으면 되돌린다.

    `set` 은 한 줄짜리 값만 다룬다. 검사 목록은 표의 배열이라 따로 둔다.
    """
    if not args.args:
        print(json.dumps(cfg["verify"]["checks"], ensure_ascii=False, indent=2))
        return 0
    try:
        checks = json.loads(args.args[0])
        assert len(args.args) == 1 and isinstance(checks, list) and all(isinstance(x, dict) for x in checks)
    except (ValueError, AssertionError):
        die("usage: harness checks [<json>]\n\nexample: harness checks '[{\"name\":\"module boundaries\",\"run\":\"script/check-deps.sh\"}]'")
    q = lambda x: json.dumps(x, ensure_ascii=False)
    rows = "".join("  { %s },\n" % ", ".join(["name = %s" % q(str(x.get("name", ""))), "run = %s" % q(str(x.get("run", "")))]
                                             + ["%s = %s" % (k, q(x[k])) for k in ("paths", "on") if k in x])
                   for x in checks)
    block = "checks = [\n%s]\n" % rows
    p = target / "harness.toml"
    original = p.read_text(encoding="utf-8")
    lines = original.splitlines(keepends=True)
    span = section_span(lines, "[verify]")
    if span is None:
        text = original.rstrip("\n") + "\n\n[verify]\n" + block
    else:
        # checks 배열만 갈아 끼운다 — 같은 절의 다른 키(시점 · 증분)와 주석은 그대로 둔다
        i = next((n for n in range(*span) if re.match(r"\s*checks\s*=", lines[n])), None)
        if i is None:
            text = "".join(lines[:span[0] + 1]) + block + "".join(lines[span[0] + 1:])
        else:
            j = i + 1
            if "]" not in lines[i].split("#", 1)[0]:
                while j < span[1] and lines[j].split("#", 1)[0].strip() != "]":
                    j += 1
                j += 1
            text = "".join(lines[:i]) + block + "".join(lines[j:])
    if refuse_unsafe_manifest(target, "checks"):
        return 2
    p.write_text(text, encoding="utf-8")
    try:
        cfg = load(target)
        normalize(cfg)
        validate(cfg)
    except SystemExit:
        p.write_text(original, encoding="utf-8")
        print("\nreverted — the config is unchanged", file=sys.stderr)
        return 2
    if revert_for_user_files(cfg, target, args, p, original):
        return 2
    print("checks: verify.checks — %d" % len(checks))
    return cmd_render(cfg, target, args)


ADR_TOOLS = [("adr-tools", "adr"), ("adrs", "adrs")]   # manual·none 은 도구가 필요 없다


# 에이전트 CLI 가 이 기기에서 쓸 수 있는 모델. **CLI 자신이 남긴 기록만 읽는다** — 모델 이름을 여기 적어 두면
# 그 CLI 가 올라갈 때마다 낡는다. 읽을 곳이 없는 CLI 는 모델을 고를 수 없고 기본 모델로 돈다.
def claude_models(path: str) -> dict:
    """`claude --help` 의 --model 설명에 나온 이름과, 사용자 설정의 기본 모델."""
    models, default = [], ""
    try:
        text = subprocess.run([path, "--help"], capture_output=True, text=True, timeout=8).stdout
        m = re.search(r"--model <\w+>(.*?)(?:\n\s*-{1,2}\w|\Z)", text, re.S)
        for name in re.findall(r"'([\w.\[\]-]+)'", m.group(1) if m else ""):
            if name not in models:
                models.append(name)
    except (OSError, subprocess.TimeoutExpired):
        pass
    try:
        default = json.loads((Path.home() / ".claude" / "settings.json").read_text(encoding="utf-8")).get("model", "")
    except (OSError, ValueError):
        pass
    if default and default not in models:
        models.append(default)
    return {"models": [{"id": x, "name": x} for x in models], "default_model": default,
            "models_from": "claude --help · ~/.claude/settings.json"}


def codex_models(_path: str) -> dict:
    """Codex 가 받아 둔 모델 목록(`~/.codex/models_cache.json`) 중 목록에 보이는 것과, 설정의 기본 모델."""
    models, default = [], ""
    try:
        cache = json.loads((Path.home() / ".codex" / "models_cache.json").read_text(encoding="utf-8"))
        models = [{"id": x["slug"], "name": x.get("display_name") or x["slug"]}
                  for x in cache.get("models", []) if x.get("slug") and x.get("visibility") == "list"]
    except (OSError, ValueError, KeyError):
        pass
    try:
        with (Path.home() / ".codex" / "config.toml").open("rb") as f:
            default = tomllib.load(f).get("model", "")
    except (OSError, tomllib.TOMLDecodeError):
        pass
    return {"models": models, "default_model": default, "models_from": "~/.codex/models_cache.json · ~/.codex/config.toml"}


# 벤더 선언의 `models` 가 이 이름 중 하나를 고른다
MODEL_READERS = {"claude-help": claude_models, "codex-cache": codex_models}


def recorded_tools():
    """마지막으로 찾은 도구 기록. 없으면 None — 모델 판정을 하지 않는다."""
    try:
        return json.loads((registry() / "tools.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None


def model_ok(cfg: dict, role: str, tools):
    """그 역할의 모델이 실제로 돌리는 에이전트의 모델인가. 모델을 비웠거나 목록을 모르면 None."""
    m = role_model(cfg, role)
    agent = next((a for a in (tools or {}).get("agents", []) if a["id"] == vendor(cfg, role)), None)
    if not m or not agent or not agent.get("models"):
        return None
    return m in {x["id"] for x in agent["models"]}


def detect_tools() -> dict:
    """PATH 에서 찾고 `--version` 첫 줄을 붙인다. 버전을 못 읽어도 찾았으면 있는 것이다."""
    def probe(exe):
        path = shutil.which(exe)
        if not path:
            return None
        try:
            r = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=8)
            first = ((r.stdout or r.stderr).strip().splitlines() or [""])[0][:80]
            # 성공하고 숫자 버전이 있을 때만 — 오류 문구나 사용법이 버전 자리에 들어가지 않게
            ver = first if r.returncode == 0 and re.search(r"\d+\.\d+", first) else ""
        except (OSError, subprocess.TimeoutExpired):
            ver = ""
        return {"path": path, "version": ver}
    agents = []
    for a in AGENTS:
        hit = probe(a["exe"])
        if hit:
            found = dict(hit, id=a["id"], name=a["name"], supported=a["orchestrator"] or a["runner"])
            reader = MODEL_READERS.get(VENDORS[a["id"]].get("models", ""))
            if reader:
                found.update(reader(hit["path"]))
            agents.append(found)
    adr = [dict(hit, id=tid) for tid, exe in ADR_TOOLS for hit in [probe(exe)] if hit]
    import datetime
    return {"synced_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "agents": agents, "adr_tools": adr}


def cmd_tools(_cfg, _target, args):
    """`harness tools [--sync]` — 이 기기에 설치된 에이전트 CLI·결정 기록 도구.

    결과는 `~/.harness/tools.json` 에 둔다. **기기의 사실이라 프로젝트(`.harness/`)에 두지 않는다** —
    리포에 커밋되는 사본에 적으면 기기마다 다른 값으로 매번 바뀐다. `--sync` 가 없으면 기록을 읽고,
    기록이 없을 때만 찾는다.
    """
    f = registry() / "tools.json"
    data = None
    if not args.sync and f.is_file():
        try:
            data = json.loads(f.read_text(encoding="utf-8"))
        except ValueError:
            data = None
    if data is None:
        data = detect_tools()
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    print(json.dumps(data, ensure_ascii=False, indent=2))
    return 0


# 설정 파일의 주석이 곧 스키마 문서다. 키 바로 위의 주석 줄이 그 키의 설명이다.
CONFIG_SECTION = re.compile(r"\[([^\]]+)\]")
CONFIG_KEY = re.compile(r"([A-Za-z0-9_-]+)\s*=")


def config_notes(target: Path) -> dict:
    """`harness.toml` 의 키마다 바로 위 주석 — `{"<절>.<키>": "<설명>"}`. 빈 줄이 끼면 붙이지 않고, `─` 구분선 줄은 뺀다."""
    p = target / "harness.toml"
    notes, section, buf = {}, "", []
    for ln in p.read_text(encoding="utf-8").split("\n") if p.is_file() else []:
        st = ln.strip()
        m = CONFIG_SECTION.fullmatch(st)
        if m:
            section, buf = m.group(1), []
            continue
        if st.startswith("#"):
            t = re.sub(r"^#\s?", "", st)
            if not re.fullmatch("─+", t):
                buf.append(t)
            continue
        kv = CONFIG_KEY.match(st)
        if kv and buf:
            notes["%s.%s" % (section, kv.group(1))] = "\n".join(buf).strip()
        if st == "" or kv:
            buf = []
    return notes


def template_path(target: Path, p: Path) -> str:
    """이 명령을 답한 하네스의 원형 경로. 하네스 루트 안이면 그 기준 상대 경로, 밖이면 절대 경로."""
    try:
        return p.relative_to(target).as_posix()
    except ValueError:
        return str(p)


def cmd_schema(cfg, _target, _args):
    """`harness schema` — UI 가 선택지를 그리는 데 쓰는 해석된 설정. 등록부와 역할별 실제 실행 주체를 낸다.

    UI 가 이 표를 따로 들고 있지 않게 한다 — 한쪽만 고치면 고를 수 없는 값을 고르게 된다.
    """
    tools = recorded_tools()
    print(json.dumps({
        "agents": AGENTS,
        # 전용 스크립트로 도는 역할 → 그 스크립트. 캔버스가 스크립트 단계에서 역할을 알아본다
        "script_roles": {n: role_meta(n)["entry"] for n in cfg["roles"] if role_meta(n).get("entry")},
        "orchestrator": cfg["harness"]["orchestrator"],
        "orchestrator_model": cfg["harness"]["model"],   # 모델을 비운 서브에이전트가 이어받는 값
        "roles": {n: {"runner": r["runner"], "access": r["access"], "model": r.get("model", ""),
                      # 오케스트레이터가 돌리는 역할은 harness.model 을 따른다 — UI 는 그 역할의 모델을 고르게 하지 않는다
                      "follows_orchestrator": r["runner"] == cfg["harness"]["orchestrator"],
                      "vendor": vendor(cfg, n), "runners": ["inproc"] + (RUNNERS if role_meta(n).get("headless", True) else []),
                      "model_ok": model_ok(cfg, n, tools),
                      # about 은 사람에게 보이는 한 문장이다. description 은 에이전트 선택용이라 길다
                      "about": role_meta(n).get("about") or role_meta(n).get("description", ""),
                      "contract": ".ai/templates/%s.md" % n, "notes": "%s/%s.md" % (ROLE_NOTES, n)}
                  for n, r in cfg["roles"].items()},
        # 명령 탭의 값. 이 키가 없는 옛 하네스 사본은 명령을 문서(.ai/project/commands.md)로만 받는다
        "commands": cfg["commands"], "checks": cfg["verify"]["checks"],
        "legacy_verify": legacy_verify(_target),
        # 기본값을 채운 준비 점검 설정. 설정 파일에 [doctor] 가 없어도 설정 화면이 그 값을 그린다
        "doctor": cfg["doctor"],
        # 옛 설정에 없을 수 있는 forge 키의 현재 값. 설정 화면이 원문에 없는 키를 이 값으로 그린다
        "forge": {k: cfg["forge"][k] for k in FORGE_DEFAULTS},
        "workflow_notes": {wf: "%s/%s.md" % (WORKFLOW_NOTES, wf) for wf in cfg["workflows"]},
        # 절차 목록: 제목과, 이 프로젝트가 만든 것인지(하네스 기본 조각이 없는 것)
        "workflows": {wf: {"title": body.get("title", ""), "custom": fragment(wf, "_head") is None,
                           "path": ".ai/workflows/%s.md" % wf}
                      for wf, body in cfg["workflows"].items()},
        # UI 가 읽고 보이는 경로와 판정 값. UI 는 경로를 짓지 않고 이것을 쓴다. 이 키가 있는 사본은 write-doc · fix 를 안다
        "docs": {d: {"path": rel, "template": template_path(_target, OWNED_DOCS / ("%s.md" % d))}
                 for d, rel in writable_docs(cfg).items() if "/" not in d},
        "verify_script": verify_entry(_target),
        "hooks_path": hooks_expected(_target),
        "config_notes": config_notes(_target),
        "base_protected": list(BASE_PROTECTED),
    }, ensure_ascii=False, indent=2))
    return 0


def metrics_module():
    """옆의 지표 모듈(harness_metrics.py). 설치본·소스 리포·패키지 설치 모두 이 파일과 같은 디렉터리에 있다."""
    import importlib.util
    # .harness/bin/ 과 src/bin/ 에 __pycache__ 를 남기지 않는다
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_file_location("harness_metrics", HERE / "harness_metrics.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


_CLONE_KEY_MODULE = None
_CLONE_KEYS = {}


def clone_key_module():
    """클론 키 모듈 — 대상 리포에 깔리는 `script/_clone_key.py` 의 원형. 계산은 이것 하나가 한다."""
    global _CLONE_KEY_MODULE
    if _CLONE_KEY_MODULE is None:
        import importlib.util
        sys.dont_write_bytecode = True
        spec = importlib.util.spec_from_file_location("harness_clone_key", TEMPLATES / "managed" / "script" / "_clone_key.py")
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        _CLONE_KEY_MODULE = mod
    return _CLONE_KEY_MODULE


def clone_key(root: Path) -> str:
    """하네스 루트 root 의 클론 키. 한 실행에서 루트마다 한 번만 계산한다."""
    k = str(root)
    if k not in _CLONE_KEYS:
        _CLONE_KEYS[k] = clone_key_module().clone_key(root)
    return _CLONE_KEYS[k]


def expand_key(text: str, target: Path) -> str:
    """설정 값의 자리표시(`{clone}` 과 그 옛 별칭 `{project}`)를 이 클론의 키로 바꾼 것. 자리표시가 없으면 키를 구하지 않는다."""
    for p in clone_key_module().PLACEHOLDERS:
        if p in text:
            text = text.replace(p, clone_key(target))
    return text


def cmd_metrics(cfg, target, args):
    """`harness metrics [--since 24h|7d|30d] [--trace ID]` — 실행 지표 집계(JSON). `harness metrics prune` — 정리."""
    m = metrics_cfg(cfg, target)
    d = Path(os.path.expandvars(os.path.expanduser(m["dir"]))) if m["dir"] != "off" else None
    if args.args[:1] == ["prune"]:
        r = subprocess.run([sys.executable, str(target / "script" / "metric.py"), "prune"], cwd=target)
        return r.returncode
    hm = metrics_module()
    imported = (hm.metrics_import(target, m, registry() / clone_key(target) / "state", set(cfg["roles"]),
                                  worktree_dir(cfg, target), git(target, "rev-parse", "--show-prefix").stdout.strip())
                if args.args[:1] == ["import"] else None)
    mt = re.fullmatch(r"(\d+)([hd])", args.since or "7d")
    if not mt:
        die("error: --since takes a span like 24h, 7d or 30d (got %r)" % args.since)
    now = datetime.datetime.now(datetime.timezone.utc)
    since = now - datetime.timedelta(hours=int(mt.group(1)) * (24 if mt.group(2) == "d" else 1))
    spans, diag = hm.read_spans(d) if d else ({}, {"bad_lines": 0, "files": 0, "bytes": 0})
    out = hm.metrics_report(spans, since, now, m["stale_after_hours"], args.trace)
    out["diagnostics"] = dict(diag, imported=imported, enabled=d is not None, dir=m["dir"], retention_days=m["retention_days"],
                              max_total_mb=m["max_total_mb"], capture_logs=m["capture_logs"])
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_status(cfg, target, args):
    """`harness status` — 홈 화면용 프로젝트 상태(JSON). 검사를 새로 만들지 않고 doctor 의 항목 목록과 check 를 쓴다."""
    import contextlib, io
    items = doctor_items(cfg, target, getattr(args, "remote", False))
    with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
        check_ok = cmd_check(cfg, target, argparse.Namespace(staged=False)) == 0
    # 설정 진행도: 소유 문서 중 자리표시자가 남지 않은 것
    facts = sorted(p.relative_to(TEMPLATES / "owned").as_posix()
                   for p in (TEMPLATES / "owned" / ".ai" / "project").glob("*.md"))
    todo = {i["what"] for i in items if i["section"] == "project facts" and i["state"] != "ok"}
    def git(*a):
        r = subprocess.run(["git", "-C", str(target), *a], capture_output=True, text=True)
        return r.stdout.strip() if r.returncode == 0 else ""
    v = target / ".harness" / "VERSION"
    notes = [p for d in (ROLE_NOTES, WORKFLOW_NOTES) for p in (target / d).glob("*.md")] if target else []
    print(json.dumps({
        "version": v.read_text(encoding="utf-8").strip() if v.is_file() else "",
        "check_ok": check_ok,
        "doctor": doctor_json(items),   # 통과한 줄도 싣는다 — Doctor 화면이 절마다 통과 수를 보인다
        "facts": {"total": len(facts), "filled": len([f for f in facts if f not in todo])},
        "git": {"branch": git("branch", "--show-current"), "dirty": bool(git("status", "--porcelain")),
                "last_commit": git("log", "-1", "--format=%cI")},
        "custom": {"roles": len([p for p in notes if ROLE_NOTES in str(p)]),
                   "workflows": len([p for p in notes if WORKFLOW_NOTES in str(p)])},
    }, ensure_ascii=False, indent=2))
    return 0


UI_PORT = 7777
# 빌드 결과에 닿는 UI 소스. `skills/` 는 서버가 실행할 때 읽으므로 넣지 않는다.
UI_HASH_FILES = ("package.json", "package-lock.json", "jsconfig.json", "next.config.js")
UI_HASH_DIRS = ("app", "components", "lib")


def ui_source_hash(ui: Path) -> str:
    """UI 소스의 SHA-256 16진 문자열. 파일마다 `상대 경로 + NUL + 내용 + NUL` 을 경로 순으로 잇는다.

    점으로 시작하는 경로 구성 요소는 뺀다. 없는 대상은 건너뛴다.
    """
    files = [name for name in UI_HASH_FILES if (ui / name).is_file()]
    for d in UI_HASH_DIRS:
        for dirpath, dirnames, filenames in os.walk(ui / d):
            dirnames[:] = [n for n in dirnames if not n.startswith(".")]
            for f in filenames:
                p = Path(dirpath) / f
                if not f.startswith(".") and p.is_file():
                    files.append(p.relative_to(ui).as_posix())
    h = hashlib.sha256()
    for rel in sorted(files):
        h.update(rel.encode("utf-8") + b"\0" + (ui / rel).read_bytes() + b"\0")
    return h.hexdigest()


def needs_build(hash_, stamp, build_id_exists: bool) -> bool:
    """스탬프가 없거나(None) 해시와 다르거나 빌드 산출물(BUILD_ID)이 없으면 빌드가 필요하다."""
    return stamp is None or stamp.strip() != hash_ or not build_id_exists


def _plain_int(v) -> bool:
    return isinstance(v, int) and not isinstance(v, bool)


def parse_server_record(text):
    """`ui.pid` 의 내용을 dict 로. 형식이 맞지 않으면 None — 읽지 못한 기록이다.

    pid 가 0 · 1 · 음수면 `killpg` 가 엉뚱한 그룹을 가리키므로 2 이상만 받는다.
    """
    try:
        data = json.loads(text)
    except (TypeError, ValueError):
        return None
    if not isinstance(data, dict):
        return None
    pid, port = data.get("pid"), data.get("port")
    if not (_plain_int(pid) and pid >= 2 and _plain_int(port) and 1 <= port <= 65535):
        return None
    if not all(isinstance(data.get(k), str) and data[k] for k in ("started", "root", "hash")):
        return None
    return data


def process_matches(record, ps_output: str) -> bool:
    """`ps -o pgid=,lstart=` 출력의 그룹 id 와 시작 시각이 기록과 같은가. 빈 출력은 프로세스 없음이다.

    시각을 비교하므로 같은 pid 를 다시 받은 다른 프로세스는 맞지 않는다.
    """
    if not record:
        return False
    parts = (ps_output or "").strip().split(None, 1)
    if len(parts) != 2:
        return False
    try:
        pgid = int(parts[0])
    except ValueError:
        return False
    return pgid == record["pid"] and parts[1].strip() == record["started"]


def server_state(record, matches: bool, root: str, hash_: str, port_busy: bool, http_ok: bool) -> str:
    """서버 상태 하나 — other-copy · other-build · running · unresponsive · busy · free.

    살아 있는 프로세스와 맞지 않는 기록은 기록 없음과 같다. 응답만으로는 하네스 서버로 보지 않는다.
    """
    if record and matches:
        if record["root"] != root:
            return "other-copy"
        if record["hash"] != hash_:
            return "other-build"
        return "running" if http_ok else "unresponsive"
    return "busy" if port_busy else "free"


# 백그라운드 UI 서버의 기록과 출력. 서버 하나가 등록된 프로젝트 전부를 보이므로 등록부 최상위에 둔다.
def server_files():
    home = registry()
    return home / "ui.pid", home / "ui.log"


def read_server_record(pidfile: Path):
    """(파일이 있는가, 기록). 파일이 있으나 형식이 맞지 않거나 읽히지 않으면 기록은 None."""
    try:
        text = pidfile.read_text(encoding="utf-8")
    except FileNotFoundError:
        return False, None
    except (OSError, UnicodeDecodeError):
        return True, None
    return True, parse_server_record(text)


def remove_server_record(pidfile: Path):
    try:
        pidfile.unlink(missing_ok=True)
    except OSError as e:
        die("error: could not remove the UI server record\n  --> %s\n\nhelp: %s" % (pidfile, e.strerror or e))


def ps_fields(pid: int, fields: str) -> str:
    """`LC_ALL=C ps -o <fields> -p <pid>` 의 표준 출력. 프로세스가 없으면 빈 문자열."""
    r = subprocess.run(["ps", "-o", fields, "-p", str(pid)], capture_output=True, text=True,
                       env=dict(os.environ, LC_ALL="C"))
    return r.stdout if r.returncode == 0 else ""


def port_busy(port: int) -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=1):
            return True
    except OSError:
        return False


def http_ok(port: int) -> bool:
    """`GET http://127.0.0.1:<port>/` 가 1초 안에 200 인가. 프록시 설정을 타지 않는다."""
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open("http://127.0.0.1:%d/" % port, timeout=1) as r:
            return r.status == 200
    except Exception:
        return False


def probe_server(ui: Path, hash_: str):
    """(상태, 기록, 기록이 살아 있는 프로세스와 맞는가). 파일을 바꾸지 않는다."""
    pidfile, _log = server_files()
    _exists, record = read_server_record(pidfile)
    matches = bool(record) and process_matches(record, ps_fields(record["pid"], "pgid=,lstart="))
    busy = port_busy(UI_PORT)
    ok = busy and http_ok(UI_PORT)
    return server_state(record, matches, str(ui), hash_, busy, ok), record, matches


def group_gone(pid: int, reap=None) -> bool:
    if reap:
        reap()
    try:
        os.killpg(pid, 0)
    except ProcessLookupError:
        return True
    except PermissionError:
        return False
    return False


def stop_group(pid: int, reap=None) -> bool:
    """프로세스 그룹에 SIGTERM, 10초 안에 없어지지 않으면 SIGKILL 과 5초. 그룹이 없어지면 참.

    `reap` 은 그 그룹의 우두머리가 이 프로세스의 자식일 때 좀비를 거두는 함수다. 권한 오류는 그대로 올린다.
    """
    for sig, wait in ((signal.SIGTERM, 10), (signal.SIGKILL, 5)):
        try:
            os.killpg(pid, sig)
        except ProcessLookupError:
            return True
        deadline = time.monotonic() + wait
        while time.monotonic() < deadline:
            if group_gone(pid, reap):
                return True
            time.sleep(0.1)
    return group_gone(pid, reap)


def halt_server(record, pidfile: Path, reap=None):
    """기록의 서버 그룹을 멈추고 기록을 지운다. 멈추지 못하면 기록을 두고 종료 코드 2 로 멈춘다."""
    pid = record["pid"]
    try:
        stopped = stop_group(pid, reap)
    except PermissionError:
        stopped = False
    if not stopped:
        die("error: the UI server (pid %d) did not stop\n\n"
            "help: check the process yourself, then run `harness stop-server` again" % pid)
    remove_server_record(pidfile)


def cmd_stop_server(_cfg, _target, _args):
    """`harness stop-server` — 기록이 살아 있는 프로세스와 맞을 때만 그 서버 그룹을 멈춘다.

    포트를 쓰는 프로세스를 찾아 멈추지 않는다. 기록 없이 뜬 프로세스는 하네스가 띄운 것으로 확인되지 않는다.
    """
    pidfile, _log = server_files()
    exists, record = read_server_record(pidfile)
    if not exists:
        print("stop-server: not running")
        return 0
    if record is None:
        remove_server_record(pidfile)
        print("stop-server: removed an unreadable record; no process was stopped")
        return 0
    # 판정과 신호 사이에 프로세스가 바뀌지 않았는지 신호 직전에 한 번 더 본다.
    for _ in range(2):
        if not process_matches(record, ps_fields(record["pid"], "pgid=,lstart=")):
            remove_server_record(pidfile)
            print("stop-server: not running (removed a stale record)")
            return 0
    halt_server(record, pidfile)
    print("stop-server: stopped (pid %d)" % record["pid"])
    return 0


def cmd_server_status(_cfg, _target, _args):
    """`harness server-status` — 서버 상태 한 줄. 파일을 바꾸지 않는다."""
    ui = ROOT / "ui"
    pidfile, _log = server_files()
    exists, record = read_server_record(pidfile)
    if exists and record is None:
        die("error: the UI server record could not be read\n  --> %s\n\n"
            "help: run `harness stop-server` to clear it" % pidfile)
    state, record, _matches = probe_server(ui, ui_source_hash(ui))
    url = "http://localhost:%d" % UI_PORT
    if state in ("running", "other-copy", "other-build"):
        print("server-status: running at %s (pid %d)" % (url, record["pid"]))
        if state != "running":
            print("note: this server is from another copy or an older build — "
                  "run `harness stop-server`, then `harness start-server`")
        return 0
    if state == "unresponsive":
        print("server-status: pid %d is running but %s does not respond" % (record["pid"], url))
    elif state == "busy":
        print("server-status: not running (port %d is in use by another process)" % UI_PORT)
    else:
        print("server-status: not running")
    return 1

def open_private(path: Path):
    """쓰기용으로 비우고 연다. 권한은 0600 — 이미 있던 파일도 맞춘다."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)
    return os.fdopen(fd, "w", encoding="utf-8")


def write_server_record(pidfile: Path, record):
    tmp = pidfile.with_name(pidfile.name + ".tmp")
    with open_private(tmp) as f:
        f.write(json.dumps(record) + "\n")
    os.replace(tmp, pidfile)


def server_state_error(state, record, log: Path) -> str:
    """기동하지 않는 상태의 안내. running 은 `--dev` 만 쓴다."""
    url = "http://localhost:%d" % UI_PORT
    again = "help: run `harness stop-server`, then `harness start-server` again"
    if state == "running":
        return "error: a harness UI is already running on %s\n  --> %s\n\n%s" % (url, record["root"], again)
    if state == "other-copy":
        return "error: a harness UI from another copy is already running on %s\n  --> %s\n\n%s" % (
            url, record["root"], again)
    if state == "other-build":
        return "error: the running harness UI was built from an older version of this copy\n  --> %s\n\n%s" % (
            record["root"], again)
    if state == "unresponsive":
        return "error: the harness UI (pid %d) is running but does not respond on %s\n  --> %s\n\n%s" % (
            record["pid"], url, log, again)
    # 기록 없이 포트를 쓰는 프로세스는 하네스가 띄운 것으로 확인되지 않았다 — stop-server 를 권하지 않는다.
    return ("error: port %d is in use by another process\n  --> %s\n\n"
            "help: stop the process using the port, then run `harness start-server` again" % (UI_PORT, url))


def ui_copy() -> Path:
    """UI 는 전역 설치에만 있다. 프로젝트에 고정된 사본은 `templates/` 만 들고 간다."""
    ui = ROOT / "ui"
    if not (ui / "package.json").is_file():
        die("error: the UI is not part of this copy of the harness\n  --> %s\n\n"
            "help: run the globally installed harness, not the one vendored in .harness/" % ui)
    if not shutil.which("npm"):
        die("error: start-server needs Node.js (npm not found)\n\nhelp: brew install node")
    return ui


def build_ui(ui: Path, hash_: str, out, log: Path):
    """`next build` 를 하고 성공하면 해시를 스탬프로 남긴다. 출력은 `out` 으로 간다."""
    modules = ui / "node_modules"
    if modules.is_symlink():
        die("error: the UI's node_modules is a symbolic link, which the UI build cannot use\n  --> %s\n\n"
            "help: remove the link and run `harness start-server` again — it reinstalls the dependencies" % modules)
    print("start-server: building the UI", flush=True)
    stamp = ui / ".next" / "harness-ui-hash"
    stamp.unlink(missing_ok=True)   # 실패한 빌드 뒤에 옛 스탬프가 남지 않는다
    try:
        code = subprocess.run([str(modules / ".bin" / "next"), "build"], cwd=ui,
                              stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT).returncode
    except OSError as e:
        out.write("%s\n" % e)
        code = 1
    if code:
        die("error: the UI build failed\n  --> %s\n\n"
            "help: read the log above, fix the cause, and run `harness start-server` again" % log)
    stamp.write_text(hash_ + "\n", encoding="utf-8")


def ui_env():
    """UI 가 실행할 때 읽는 값. 빌드가 굳히지 않도록 서버 프로세스의 환경으로만 넘긴다."""
    return dict(os.environ, HARNESS_HOME=str(registry()), HARNESS_BIN=str(HERE / "harness"))


def start_dev_server(ui: Path):
    """`start-server --dev` — 포그라운드 `next dev`. 기록을 남기지 않는다."""
    if not (ui / "node_modules").is_dir():
        print("start-server: installing UI dependencies (first run)", flush=True)
        if subprocess.run(["npm", "install", "--no-audit", "--no-fund"], cwd=ui).returncode:
            die("error: npm install failed")
    state, record, _matches = probe_server(ui, ui_source_hash(ui))
    if state != "free":
        die(server_state_error(state, record, server_files()[1]))
    os.environ.update(ui_env())
    print("start-server: http://localhost:%d" % UI_PORT, flush=True)
    os.chdir(ui)
    # 로컬 파일을 쓰는 서버다. 루프백에만 묶는다.
    os.execvp("npx", ["npx", "next", "dev", "-H", "127.0.0.1", "-p", str(UI_PORT)])


def cmd_start_server(_cfg, _target, args):
    """`harness start-server` — 설정·워크플로·프로젝트 사실을 고치는 웹 UI 를 백그라운드로 띄운다.

    UI 소스가 지난 빌드와 다를 때만 빌드한다. 응답이 오면 URL 한 줄을 내고 돌아온다.
    """
    ui = ui_copy()
    if args.dev:
        return start_dev_server(ui)
    pidfile, log = server_files()
    hash_ = ui_source_hash(ui)
    state, record, matches = probe_server(ui, hash_)
    if record and not matches:
        remove_server_record(pidfile)
    url = "http://localhost:%d" % UI_PORT
    if state == "running":
        print("start-server: already running at %s" % url)
        return 0
    if state != "free":
        die(server_state_error(state, record, log))

    log.parent.mkdir(parents=True, exist_ok=True)
    with open_private(log) as out:
        if not (ui / "node_modules").is_dir():
            print("start-server: installing UI dependencies (first run)", flush=True)
            if subprocess.run(["npm", "install", "--no-audit", "--no-fund"], cwd=ui,
                              stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT).returncode:
                die("error: npm install failed\n  --> %s" % log)
        try:
            stamp = (ui / ".next" / "harness-ui-hash").read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            stamp = None
        if needs_build(hash_, stamp, (ui / ".next" / "BUILD_ID").is_file()):
            build_ui(ui, hash_, out, log)
        out.flush()
        # 새 세션으로 띄워 서버 pid 가 그 프로세스 그룹 id 가 되게 한다. 루프백에만 묶는다.
        proc = subprocess.Popen([str(ui / "node_modules" / ".bin" / "next"), "start", "-H", "127.0.0.1",
                                 "-p", str(UI_PORT)], cwd=ui, stdin=subprocess.DEVNULL, stdout=out,
                                stderr=subprocess.STDOUT, env=ui_env(), start_new_session=True)
    record = {"pid": proc.pid, "started": ps_fields(proc.pid, "lstart=").strip(), "root": str(ui),
              "hash": hash_, "port": UI_PORT}
    if record["started"]:
        write_server_record(pidfile, record)
        deadline = time.monotonic() + 30
        while proc.poll() is None and time.monotonic() < deadline:
            if http_ok(UI_PORT):
                print("start-server: %s" % url)
                return 0
            time.sleep(0.25)
    halt_server(record, pidfile, reap=proc.poll)
    die("error: the UI server did not come up on %s\n  --> %s\n\n"
        "help: read the log for the cause, then run `harness start-server` again" % (url, log))

COMMANDS = {
    # 이름          (함수, 설정이 필요한가, 인수, 설명)
    "install":   (None, True,  "[--target DIR] [--adopt] [--create] [--git-init]", "vendor the harness into .harness/ and render (the source tree only registers and renders)"),
    "render":    (None, True,  "[--target DIR] [--adopt]", "harness.toml + .ai/project/ -> generated files"),
    "check":     (None, True,  "[--staged]", "verify generated files match the config and managed files match the manifest"),
    "doctor":    (None, True,  "[--remote] [--json]", "report readiness: config, files, managed file changes, tools, hooks (--remote: also the remote, read-only; "
                  "--json: the items as JSON)"),
    "set":       (None, True,  "<section.key> <value> ...", "change config values together and re-render"),
    "write-doc": (None, True,  "<name> -", "write standard input to a project document or a role or workflow note, and re-render"),
    "fix":       (None, True,  "<hooks|verify>", "run a Doctor fix: turn the git hooks on as install does, or run verification again"),
    "run":       (None, True,  "<workflow> <issue> [--worktree]", "start a workflow in the configured orchestrator"),
    "steps":     (None, True,  "[<workflow> <json>]", "print steps as JSON, or replace one workflow's (--dry-run: check only)"),
    "checks":    (None, True,  "[<json>]", "print verification checks as JSON, or replace them"),
    "metrics":   (None, True,  "[import|prune] [--since 7d] [--trace ID]", "run metrics as JSON for the Metrics tab; import reads new session logs first; prune applies retention"),
    "forge-setup": (None, True, "", "create the configured issue labels on the tracker (writes to the remote)"),
    "vars":      (None, True,  "", "print template variables (debugging)"),
    "uninstall": (None, False, "[--purge] [--yes]", "remove what the harness installed; --purge also removes yours"),
    "start-server": (None, False, "[--dev]", "build if needed and start the web UI in the background on "
                     "http://localhost:%d (--dev: foreground next dev)" % UI_PORT),
    "stop-server": (None, False, "", "stop the web UI started by start-server"),
    "server-status": (None, False, "", "whether the web UI is running and responding"),
    "schema":    (None, True,  "", "agent registry and resolved roles as JSON (for the UI)"),
    "status":    (None, True,  "[--remote]", "project health for the home screen as JSON: check, doctor, facts, git (--remote: passed to doctor)"),
    "tools":     (None, False, "[--sync]", "list agent CLIs and decision-record tools on this machine"),
    "projects":  (None, False, "", "registered clones on this machine as JSON (for the UI)"),
    "version":   (None, False, "", "version of this harness"),
    "help":      (None, False, "", "this help"),
}


def cmd_version(_cfg, target, _args):
    print("harness %s" % harness_version())
    v = target / ".harness" / "VERSION" if target else None
    if v and v.is_file():
        print("pinned in this project: %s" % v.read_text(encoding="utf-8").strip())
    return 0


def cmd_help(_cfg, _target, _args):
    print(__doc__.strip().splitlines()[0])
    print()
    for name, (_f, _n, usage, desc) in COMMANDS.items():
        print("  harness %-13s %-22s %s" % (name, usage, desc))
    print()
    print("  --target DIR   target repository (default: current directory)")
    print()
    print("Values live in the target repo's harness.toml; project facts in .ai/project/.")
    print("Generated files are never edited by hand — render overwrites them and check")
    print("blocks commits that drift.")
    return 0


# 전역 CLI 를 깔아도 각 프로젝트는 자기가 고정한 버전으로 돌아야 한다. 그러지 않으면
# 전역을 올리는 순간 모든 프로젝트의 생성물이 조용히 바뀌고, 그 리포의 검사가 한꺼번에 깨진다.
DELEGATES = {"render", "check", "doctor", "set", "steps", "checks", "metrics", "schema", "status", "run", "vars", "uninstall",
             "forge-setup", "write-doc", "fix"}


PINNED_SHOWN = 10


def pinned_differences(target: Path) -> list:
    """이 CLI 의 파일과 고정 사본을 바이트 단위로 비교해 다른 파일의 사본 쪽 경로를 낸다. 매니페스트는 읽지 않는다.

    해시가 다른 파일, 한쪽에만 있는 파일, 사본의 `bin/` 에 실행 파일 둘 말고 있는 파일을 센다. `__pycache__/` 는 뺀다.
    """
    pin = target / ".harness"
    pairs = {"bin/harness": HERE / "harness", "bin/harness_metrics.py": HERE / "harness_metrics.py"}
    for f in TEMPLATES.rglob("*"):
        if f.is_file() and "__pycache__" not in f.relative_to(TEMPLATES).parts:
            pairs["templates/" + f.relative_to(TEMPLATES).as_posix()] = f
    theirs = {rel for rel in pinned_files(pin) if rel != "VERSION"}
    out = []
    for rel in sorted(set(pairs) | theirs):
        mine = pairs.get(rel)
        if rel not in theirs or mine is None or not mine.is_file() or sha256_of(mine) != sha256_of(pin / rel):
            out.append(PINNED + rel)
    return out


def verify_pinned(target: Path, mine: str, there: str):
    """고정 버전이 이 CLI 와 같을 때만 사본을 대조해 다르면 표준 오류에 경고한다. 넘기기는 막지 않는다."""
    if not mine or not there or mine != there:
        print("note: cannot verify the pinned harness — this machine has harness %s, the project pins %s"
              % (mine or "no version", there or "no version"), file=sys.stderr)
        return
    try:
        diff = pinned_differences(target)
    except OSError as e:
        # 읽지 못한 파일이 있으면 같다고 볼 수 없다 — 대조하지 못한 것으로 알리고 넘긴다
        where = Path(e.filename) if e.filename else None
        for base, pre in ((target / PINNED.rstrip("/"), PINNED), (HERE.parent, "")):
            if where is not None and where.is_relative_to(base):
                where = pre + where.relative_to(base).as_posix()
                break
        print("warning: could not compare the pinned harness with harness %s on this machine — a file could not be read\n"
              "  --> %s\n\n"
              "help: restore the pinned copy\n        harness install --target %s"
              % (mine, where or "(unknown)", target), file=sys.stderr)
        return
    if not diff:
        return
    lines = ["warning: the pinned harness differs from harness %s on this machine — %d file(s)" % (mine, len(diff))]
    lines += ["  --> %s" % rel for rel in diff[:PINNED_SHOWN]]
    if len(diff) > PINNED_SHOWN:
        lines.append("  ... and %d more" % (len(diff) - PINNED_SHOWN))
    lines.append("\nhelp: restore the pinned copy\n        harness install --target %s" % target)
    print("\n".join(lines), file=sys.stderr)


def delegate(target: Path, command: str):
    """대상 리포에 고정된 하네스가 있으면 그쪽으로 넘긴다.

    `install` 은 넘기지 않는다 — 고정된 사본을 갈아 끼우는 것이 그 명령의 일이다.
    하네스 소스 리포가 대상이면 `install` 까지 그 안의 `src/bin/harness` 로 넘긴다 — 소스 리포의
    생성물은 언제나 자기 작업 트리의 템플릿에서 나와야 하고, 전역 CLI 의 템플릿이 섞이면 안 된다.
    """
    if source_tree(target):
        local = target / "src" / "bin" / "harness"
    elif command in DELEGATES:
        local = target / ".harness" / "bin" / "harness"
    else:
        return
    if not local.is_file() or local.resolve() == Path(__file__).resolve():
        return
    mine = there = ""
    try:
        mine = harness_version()
        there = (target / ".harness" / "VERSION").read_text(encoding="utf-8").strip()
    except Exception:
        pass
    if not source_tree(target):
        verify_pinned(target, mine, there)
    if mine and there and mine != there:
        print("note: this project is pinned to harness %s (global is %s) — delegating to it\n"
              "      to upgrade the project, run: harness install --target %s"
              % (there, mine, target), file=sys.stderr)
    os.execv(sys.executable, [sys.executable, str(local)] + sys.argv[1:])


def main():
    handlers = {"install": cmd_install, "render": cmd_render, "check": cmd_check,
                "doctor": cmd_doctor, "set": cmd_set, "steps": cmd_steps, "checks": cmd_checks, "metrics": cmd_metrics, "run": cmd_run, "vars": cmd_vars,
                "uninstall": cmd_uninstall, "version": cmd_version, "help": cmd_help,
                "start-server": cmd_start_server, "stop-server": cmd_stop_server, "server-status": cmd_server_status,
                "tools": cmd_tools, "projects": cmd_projects, "schema": cmd_schema, "status": cmd_status, "forge-setup": cmd_forge_setup,
                "write-doc": cmd_write_doc, "fix": cmd_fix}

    ap = argparse.ArgumentParser(prog="harness", add_help=False,
                                 description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("command", nargs="?", default="help", choices=list(COMMANDS))
    ap.add_argument("args", nargs="*")
    ap.add_argument("--target", default=".", help="target repository (default: current directory)")
    ap.add_argument("--staged", action="store_true", help="check against staged contents")
    ap.add_argument("--purge", action="store_true", help="uninstall: also remove owned files and the config")
    ap.add_argument("--yes", action="store_true", help="uninstall: answer the --purge confirmation up front")
    ap.add_argument("--sync", action="store_true", help="tools: look again instead of reading the record")
    ap.add_argument("--delete", action="store_true", help="steps: delete a workflow this project made")
    ap.add_argument("--rename", metavar="NEW", help="steps: rename a workflow this project made")
    ap.add_argument("--dry-run", action="store_true", help="run: print the command instead of executing it; steps: validate without writing")
    ap.add_argument("--worktree", action="store_true", help="run: start the workflow in a worktree of its own for the issue")
    ap.add_argument("--since", help="metrics: how far back, like 24h, 7d or 30d (default 7d)")
    ap.add_argument("--trace", help="metrics: include the span tree of this trace")
    ap.add_argument("--dev", action="store_true", help="start-server: run next dev in the foreground")
    ap.add_argument("--json", action="store_true", help="doctor: print the items as one JSON object")
    ap.add_argument("--remote", action="store_true", help="doctor, status: also check the remote, read-only")
    ap.add_argument("--create", action="store_true", help="install: create the target directory if it does not exist")
    ap.add_argument("--git-init", action="store_true", help="install: run `git init` in the target if it has no .git")
    ap.add_argument("--adopt", action="store_true",
                    help="install, render, set, steps, checks: take over files the harness would write, keeping each as <path>.orig")
    ap.add_argument("-h", "--help", action="store_true")
    # 옵션 뒤에 오는 위치 인자도 args 에 모은다. 3.11 의 parse_args 는 `set --target X a.b v` 의
    # `a.b v` 를 받지 못하고 unrecognized arguments 로 멈춘다.
    args = ap.parse_intermixed_args()
    if args.help:
        args.command = "help"

    if args.command == "help":
        return cmd_help(None, None, args)
    if args.command in ("start-server", "stop-server", "server-status"):   # 대상 리포가 없다 — UI 는 전역 설치의 것이다
        return handlers[args.command](None, None, args)
    if args.command == "tools":          # 기기의 사실이다 — 대상 리포가 필요 없다
        return cmd_tools(None, None, args)
    if args.command == "projects":       # 등록부를 읽기만 한다 — 대상 리포도 설정도 필요 없다
        return cmd_projects(None, None, args)

    target = Path(args.target).resolve()
    delegate(target, args.command)

    if args.command == "install":       # 설정을 깔기 전에 바꿀 경로를 가르고, 대상을 만들 수 있다
        return cmd_install(None, target, args)
    cfg = None
    if COMMANDS[args.command][1]:
        cfg = load(target)
        normalize(cfg)
        validate(cfg)
    return handlers[args.command](cfg, target, args)


if __name__ == "__main__":
    sys.exit(main())
